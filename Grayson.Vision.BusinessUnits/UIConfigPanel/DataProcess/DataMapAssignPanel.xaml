<UserControl x:Class="Grayson.Vision.BusinessUnits.UIConfigPanel.DataProcess.DataMapAssignPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520" Height="240" Margin="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0">数据来源类型：</TextBlock>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
            <RadioButton x:Name="RdoSrcContext" Content="上下文变量" Margin="0 0 15 0" Checked="SourceModeChanged"/>
            <RadioButton x:Name="RdoSrcConst" Content="固定常量" Checked="SourceModeChanged"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="TxtSourceLabel">源上下文Key：</TextBlock>
        <TextBox x:Name="TxtSourceValue" Grid.Row="1" Grid.Column="1"/>

        <TextBlock Grid.Row="2" Grid.Column="0">目标写入上下文Key：</TextBlock>
        <TextBox x:Name="TxtTargetKey" Grid.Row="2" Grid.Column="1" />

        <CheckBox x:Name="ChkEnable" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="启用变量赋值单元"/>

        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Background="#f5f5f5" Padding="8" Margin="0 10 0 0">
            <TextBlock Foreground="#666">输入：来源Key（上下文模式）；输出：固定写入目标Key</TextBlock>
        </Border>
    </Grid>
</UserControl>