<UserControl x:Class="Grayson.Vision.BusinessUnits.UIConfigPanel.Location.ShapeTemplateMatchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520" Height="260" Margin="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>

        <!-- 模板本地路径 -->
        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">模板文件路径：</TextBlock>
        <TextBox x:Name="TxtTemplatePath" Grid.Row="0" Grid.Column="1"/>
        <Button x:Name="BtnSelectFile" Grid.Row="0" Grid.Column="2" Content="选择文件"/>

        <!-- 最低匹配分数阈值 -->
        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">最低匹配分数(0~1)：</TextBlock>
        <TextBox x:Name="TxtMinScore" Grid.Row="1" Grid.Column="1"/>

        <!-- 单元启用开关 -->
        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">启用单元：</TextBlock>
        <CheckBox x:Name="ChkEnable" Grid.Row="2" Grid.Column="1" Content="开启"/>

        <!-- 输入输出提示区域 -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Background="#f5f5f5" Padding="8">
            <StackPanel>
                <TextBlock Foreground="#666">【输入】Grab.SourceImage</TextBlock>
                <TextBlock Foreground="#666">【输出】Match.IsSuccess(bool)、Match.Pose3D(工件位姿)</TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>