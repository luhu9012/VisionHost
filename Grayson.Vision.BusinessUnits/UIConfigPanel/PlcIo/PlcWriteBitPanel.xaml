<UserControl x:Class="Grayson.Vision.BusinessUnits.UIConfigPanel.PlcIo.PlcWriteBitPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540" Height="280" Margin="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- PLC硬件Key选择 -->
        <TextBlock Grid.Row="0" Grid.Column="0">PLC设备Key：</TextBlock>
        <ComboBox x:Name="CbxPlcKey" Grid.Row="0" Grid.Column="1"/>

        <!-- PLC点位地址 -->
        <TextBlock Grid.Row="1" Grid.Column="0">PLC点位地址：</TextBlock>
        <TextBox x:Name="TxtPlcAddr" Grid.Row="1" Grid.Column="1" Text="M0.0 / DB10.DBX0.0"/>

        <!-- 数据来源模式 -->
        <TextBlock Grid.Row="2" Grid.Column="0">数据来源：</TextBlock>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <RadioButton x:Name="RdoFixed" Content="固定值" Margin="0 0 15 0" Checked="RadioSourceModeChanged"/>
            <RadioButton x:Name="RdoContext" Content="上下文变量" Checked="RadioSourceModeChanged"/>
        </StackPanel>

        <!-- 固定值配置区域 -->
        <StackPanel Grid.Row="3" Grid.Column="1" x:Name="PanelFixed">
            <CheckBox x:Name="ChkFixedValue" Content="写入True"/>
        </StackPanel>

        <!-- 上下文Key配置区域 -->
        <StackPanel Grid.Row="3" Grid.Column="1" x:Name="PanelContext" Visibility="Collapsed">
            <TextBlock Text="上下文Key："/>
            <TextBox x:Name="TxtContextKey" Text="如 Match.IsSuccess"/>
        </StackPanel>

        <!-- 单元总开关 -->
        <CheckBox x:Name="ChkEnable" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="启用当前PLC写入单元"/>

        <!-- IO说明 -->
        <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Background="#f5f5f5" Padding="8">
            <TextBlock Foreground="#666">
                输入：上下文模式读取填写的Key；固定值无输入；无上下文输出，仅写入PLC硬件点位
            </TextBlock>
        </Border>
    </Grid>
</UserControl>