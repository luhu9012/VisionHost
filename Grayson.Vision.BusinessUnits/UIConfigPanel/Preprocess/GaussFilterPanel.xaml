<UserControl x:Class="Grayson.Vision.BusinessUnits.UIConfigPanel.Preprocess.GaussFilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="480" Height="180" Margin="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">高斯卷积核大小：</TextBlock>
        <ComboBox x:Name="CbxKernelSize" Grid.Row="0" Grid.Column="1">
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="5"/>
            <ComboBoxItem Content="7"/>
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">启用当前单元：</TextBlock>
        <CheckBox x:Name="ChkEnable" Grid.Row="1" Grid.Column="1" Content="开启"/>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#f5f5f5" Padding="8">
            <StackPanel>
                <TextBlock Foreground="#666">【输入】Grab.SourceImage（必须存在原图）</TextBlock>
                <TextBlock Foreground="#666">【输出】覆盖 Grab.SourceImage 为滤波后图像</TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>