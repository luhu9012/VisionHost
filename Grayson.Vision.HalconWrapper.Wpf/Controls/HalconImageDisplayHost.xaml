<UserControl x:Class="Grayson.Vision.HalconWrapper.Wpf.Controls.HalconImageDisplayHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet">
    <Grid Background="#000" MouseMove="Grid_MouseMove">
        <!-- 1. Halcon 智能窗口 -->
        <halcon:HSmartWindowControlWPF x:Name="SmartWindow"
                                       HInitWindow="SmartWindow_HInitWindow"
                                   
                                       />

        <!-- 2. 右上角悬浮控制按钮组 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
            <Button Content="🔲 适应窗口" 
                    Command="{Binding FitImageCmd}" 
                    ToolTip="重置缩放，自适应居中显示"
                    Background="#80000000" Foreground="#FFFFFF" BorderBrush="#555" BorderThickness="1"
                    Padding="6,3" FontSize="11" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A0007ACC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <!-- 🌟 3. 新增：左下角悬浮图像/像素信息栏 -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10"
                Background="#99000000" CornerRadius="3" Padding="8,4" IsHitTestVisible="False">
            <TextBlock Text="{Binding SelectedImageInfo}" 
                       Foreground="#00FF00" 
                       FontFamily="Consolas, Microsoft YaHei" 
                       FontSize="12" 
                       FontWeight="Bold"/>
        </Border>
    </Grid>
</UserControl>