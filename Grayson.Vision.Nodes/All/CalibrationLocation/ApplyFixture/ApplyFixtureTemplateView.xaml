<UserControl x:Class="Grayson.Vision.Nodes.All.CalibrationLocation.ApplyFixture.ApplyFixtureTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.CalibrationLocation.ApplyFixture"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:ApplyFixtureParam}">
                <StackPanel Margin="10">
                    <TextBlock Text="跟随类型 (Target Type):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox SelectedValue="{Binding TargetType}" Style="{StaticResource NodeParamComboBoxStyle}" Margin="0 0 0 10">
                        <local:FollowType>Point</local:FollowType>
                        <local:FollowType>Region</local:FollowType>
                    </ComboBox>

                    <TextBlock Text="初始基准 Row (Y):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding BaseRow, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>

                    <TextBlock Text="初始基准 Col (X):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding BaseCol, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:ApplyFixtureParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>