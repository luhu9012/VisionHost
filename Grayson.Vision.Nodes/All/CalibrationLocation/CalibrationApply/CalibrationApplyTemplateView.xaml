<UserControl x:Class="Grayson.Vision.Nodes.All.CalibrationLocation.CalibrationApply.CalibrationApplyTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.CalibrationLocation.CalibrationApply"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:CalibrationApplyParam}">
                <StackPanel Margin="10" DataContextChanged="TemplateRoot_DataContextChanged">
                    <TextBlock Text="标定方案标识/名称:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding CalibrationProfileName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>

                    <TextBlock Text="相机槽键 (Cam_A / Cam_C, 可留空):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding CameraSlotKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 2"
                             ToolTip="按『一个相机一个方案』口径自动定位该槽已发布的九点矩阵 H；留空则手选矩阵路径（旧行为）。"/>
                    <TextBlock Text="填槽键后自动选中该槽的 H 矩阵（匹配文件名里 Cam_ 标识）；本节点只消费 H，e/t 补偿由流程编排层叠加"
                               Foreground="#9E9E9E" FontSize="11" Margin="0 2 0 10" TextWrapping="Wrap"/>

                    <TextBlock Text="标定矩阵路径 (.tup):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid Margin="0 0 0 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableMatrixFiles}"
                                  SelectedValue="{Binding HomMatFilePath, Mode=TwoWay}"
                                  Style="{StaticResource NodeParamComboBoxStyle}"
                                  ToolTip="自动扫描标定文件目录得到的可用矩阵，选择后自动填入路径"/>
                        <Button Grid.Column="1" Content="⟳" Width="30" Margin="4,0,0,0" Style="{StaticResource NodeParamButtonStyle}"
                                Click="RefreshMatrixFiles_Click" ToolTip="重新扫描标定文件存储目录"/>
                        <Button Grid.Column="2" Content="..." Width="30" Margin="4,0,0,0" Style="{StaticResource NodeParamButtonStyle}"
                                Click="BrowseHomMat_Click" ToolTip="手动选择标定矩阵文件（兜底）"/>
                    </Grid>
                    <TextBlock Text="自动扫描目录：Config\Calibrations（标定方案）与 Recipes\**\Calib（发布目录），找不到时用「...」手动选择"
                               Foreground="#9E9E9E" FontSize="11" Margin="0 2 0 10" TextWrapping="Wrap"/>

                    <TextBlock Text="转换模式:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <RadioButton Content="像素坐标 ➔ 物理坐标 (Pixel -> World)" IsChecked="{Binding IsPixelToWorld}" Foreground="White" Margin="0 4 0 4"/>
                    <RadioButton Content="物理坐标 ➔ 像素坐标 (World -> Pixel)" IsChecked="{Binding IsPixelToWorld, Converter={StaticResource InverseBoolConverter}}" Foreground="White" Margin="0 0 0 10"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:CalibrationApplyParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>