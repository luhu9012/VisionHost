<UserControl x:Class="Grayson.Vision.Nodes.All.CalibrationLocation.ShapeMatch.ShapeMatchTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.CalibrationLocation.ShapeMatch"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:ShapeMatchParam}">
                <!-- ⚠ DataContextChanged 必须挂在 DataTemplate 内根元素上：
                     模板提取机制只把 DataTemplate 注册进全局资源，UserControl 根 Grid 不会进入视觉树，
                     挂在那里事件永不触发（下拉永不刷新）。与 CalibrationApplyTemplateView 同款写法。 -->
                <StackPanel Margin="10" DataContextChanged="OnRootDataContextChanged">
                    <TextBlock Text="引用模板 (在【模板管理】界面创建):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox ItemsSource="{Binding TemplateOptions}" SelectedValuePath="Name"
                              SelectedValue="{Binding TemplateName}" Style="{StaticResource NodeParamComboBoxStyle}"
                              DropDownOpened="TemplateCombo_DropDownOpened"
                              Margin="0 0 0 4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="提示：模板不存在时，请先在工位【模板管理】界面创建模板" Foreground="#9E9E9E" FontSize="11" Margin="0 0 0 10" TextWrapping="Wrap"/>

                    <TextBlock Text="最小匹配分数 (Min Score):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding MinScore, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>

                    <TextBlock Text="起始角度 (Angle Start, °):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding AngleStart, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>

                    <TextBlock Text="终止角度 (Angle End, °):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding AngleEnd, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>

                    <!-- 搜索区域（Search ROI）：限定"在哪里找"，与模板 ROI（学什么）分离。
                         视野大/背景干扰多时启用可提速并防误检；留空 = 全图搜索。
                         坐标为图像全图坐标（Row=Y / Col=X），建议配合预览画面读取工件大致出现区域。 -->
                    <CheckBox Content="启用搜索区域（限定匹配范围）" IsChecked="{Binding SearchRoiEnabled}"
                              Foreground="#DCDCDC" Margin="0 4 0 6"/>
                    <StackPanel IsEnabled="{Binding SearchRoiEnabled}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="左上(Row, Col):" Style="{StaticResource NodeParamHeaderLabel}"/>
                            <StackPanel Grid.Column="0" Margin="0 2 0 4">
                                <TextBox Text="{Binding SearchRow1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 2 0 0"/>
                                <TextBox Text="{Binding SearchCol1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 2 0 0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="右下(Row, Col):" Style="{StaticResource NodeParamHeaderLabel}"/>
                            <StackPanel Grid.Column="2" Margin="0 2 0 4">
                                <TextBox Text="{Binding SearchRow2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 2 0 0"/>
                                <TextBox Text="{Binding SearchCol2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 2 0 0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="留空=全图搜索；坐标从预览图像中工件大致区域读取（0~图像尺寸）"
                                   Foreground="#9E9E9E" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:ShapeMatchParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>
