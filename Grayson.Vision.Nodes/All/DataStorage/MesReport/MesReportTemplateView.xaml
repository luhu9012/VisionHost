<UserControl x:Class="Grayson.Vision.Nodes.All.DataStorage.MesReport.MesReportTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.DataStorage.MesReport"
             mc:Ignorable="d" 
             d:DesignHeight="240" d:DesignWidth="300"
             Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:MesReportParam}">
                <StackPanel Margin="10,6">
                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="MES API 接口地址 (HTTP Post)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="站点/工位名称 (StationName)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding StationName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="网络超时时间 (ms)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:MesReportParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>