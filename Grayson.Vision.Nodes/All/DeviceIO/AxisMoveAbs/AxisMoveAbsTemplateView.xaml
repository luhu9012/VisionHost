<UserControl x:Class="Grayson.Vision.Nodes.All.DeviceIO.AxisMoveAbs.AxisMoveAbsTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.DeviceIO.AxisMoveAbs"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="300"
             Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate DataType="{x:Type local:AxisMoveAbsParam}">
                <StackPanel Margin="10,6">
                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <!-- 板卡别名 -->
                            <TextBlock Text="绑定板卡设备别名" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CardAlias, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}" Margin="0,0,0,8"/>

                            <!-- 轴号 -->
                            <TextBlock Text="控制轴号 (AxisIndex)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding AxisIndex, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}" Margin="0,0,0,8"/>

                            <!-- 目标位置 -->
                            <TextBlock Text="目标绝对位置 (TargetPosition)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding TargetPosition, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}" Margin="0,0,0,8"/>

                            <!-- 速度 -->
                            <TextBlock Text="运行速度 (Units/s)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}" Margin="0,0,0,8"/>

                            <!-- 是否同步等待完成 -->
                            <CheckBox Content="阻塞等待到位 (Wait Until Done)" 
                                      IsChecked="{Binding WaitUntilDone, Mode=TwoWay}" 
                                      Foreground="#DDD" Margin="0,4,0,8"/>

                            <!-- 超时时间设置（仅在开启同步等待时显示） -->
                            <StackPanel Visibility="{Binding WaitUntilDone, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="到位超时时间 (TimeoutMs)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource NodeParamInputStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:AxisMoveAbsParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>