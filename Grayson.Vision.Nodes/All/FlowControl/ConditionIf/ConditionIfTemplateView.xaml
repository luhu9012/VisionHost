<UserControl x:Class="Grayson.Vision.Nodes.All.FlowControl.ConditionIf.ConditionIfTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.FlowControl.ConditionIf"
             mc:Ignorable="d"
             d:DesignHeight="380" d:DesignWidth="300"
             Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- 🌟 按照加载器规范：DataTemplate 必须包含在 UserControl.Resources 内部 -->
            <DataTemplate DataType="{x:Type local:ConditionIfParam}">
                <StackPanel Margin="10,6">
                    <CheckBox Content="启用表达式模式 (Expression Mode)" 
                              IsChecked="{Binding UseExpression, Mode=TwoWay}" 
                              Foreground="#DDD" Margin="0,0,0,10"/>

                    <!-- 模式 A：表达式模式 -->
                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10"
                            Visibility="{Binding UseExpression, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="条件表达式 (Expression)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}" 
                                     Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <TextBlock Text="提示: 支持端口变量 InputVal 及 &amp;&amp;, ||, &gt;, &lt;, == 运算符" 
                                       Foreground="#888" FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 模式 B：常规单值比较模式 -->
                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseExpression}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <TextBlock Text="绑定变量标识" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding InputVariableName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="运算符 (Operator)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding Operator, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource NodeParamComboBoxStyle}" Margin="0,0,0,8">
                                <ComboBoxItem Content="等于 (==)" Tag="=="/>
                                <ComboBoxItem Content="不等于 (!=)" Tag="!="/>
                                <ComboBoxItem Content="大于 (&gt;)" Tag="&gt;"/>
                                <ComboBoxItem Content="大于等于 (&gt;=)" Tag="&gt;="/>
                                <ComboBoxItem Content="小于 (&lt;)" Tag="&lt;"/>
                                <ComboBoxItem Content="小于等于 (&lt;=)" Tag="&lt;="/>
                            </ComboBox>

                            <TextBlock Text="比较目标值 (CompareValue)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CompareValue, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 🌟 与 ReadImageFileTemplateView 严格保持一致的根布局结构 -->
    <Grid d:DataContext="{d:DesignInstance Type=local:ConditionIfParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>