<UserControl x:Class="Grayson.Vision.Nodes.All.FlowControl.Delay.DelayTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.FlowControl.Delay"
             mc:Ignorable="d"
             d:DesignHeight="160" d:DesignWidth="300"
             Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:DelayParam}">
                <StackPanel Margin="10,6">
                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="延时时长 (毫秒 / ms)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}"/>
                            <TextBlock Text="提示: 可通过 DelayTime 输入端口动态覆盖此延时时长" 
                                       Foreground="#888" FontSize="10" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:DelayParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>