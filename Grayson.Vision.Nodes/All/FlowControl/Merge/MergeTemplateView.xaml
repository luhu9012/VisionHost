<UserControl x:Class="Grayson.Vision.Nodes.All.FlowControl.Merge.MergeTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.FlowControl.Merge"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="300"
             Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:MergeParam}">
                <StackPanel Margin="10,6">
                    <CheckBox Content="优先透传首个有效值 (Pass First Non-Null)" 
                              IsChecked="{Binding PassFirstNonNull, Mode=TwoWay}" 
                              Foreground="#DDD" Margin="0,0,0,10"/>

                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8">
                        <TextBlock Text="说明：Merge 算子用于将分支流程（If / Switch）的多路数据汇合为单一出口输出，保证后续节点顺利接收。" 
                                   Foreground="#888" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:MergeParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>