<UserControl x:Class="Grayson.Vision.Nodes.All.FlowControl.SwitchCase.SwitchCaseTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.FlowControl.SwitchCase"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="300"
             Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:SwitchCaseParam}">
                <StackPanel Margin="10,6">

                    <!-- 1. 默认分支配置 -->
                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="默认匹配分支 (Default Branch)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DefaultBranchName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. Case 条件分支映射表 -->
                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="多路条件分支列表 (Case Items)" Style="{StaticResource NodeParamHeaderLabel}" VerticalAlignment="Center"/>
                                <Button Content="➕ 添加 Case" HorizontalAlignment="Right" 
                                        Style="{StaticResource NodeParamButtonStyle}" 
                                        Click="BtnAddCase_Click" Padding="8,2"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding CaseItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" 
                                                     Text="{Binding CaseValue, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource NodeParamInputStyle}" 
                                                     ToolTip="匹配目标值"/>

                                            <TextBlock Grid.Column="1" Text="➔" Foreground="#888" VerticalAlignment="Center" Margin="4,0"/>

                                            <TextBox Grid.Column="2" 
                                                     Text="{Binding BranchName, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource NodeParamInputStyle}" 
                                                     ToolTip="映射分支名称"/>

                                            <Button Grid.Column="3" Content="❌" 
                                                Margin="4,0,0,0" 
                                                Style="{StaticResource NodeParamButtonStyle}" 
                                                Click="BtnRemoveCase_Click" 
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                ToolTip="删除此项"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:SwitchCaseParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>