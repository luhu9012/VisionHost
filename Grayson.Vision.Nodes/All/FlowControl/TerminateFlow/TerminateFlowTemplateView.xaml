<UserControl x:Class="Grayson.Vision.Nodes.All.FlowControl.TerminateFlow.TerminateFlowTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.FlowControl.TerminateFlow"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="300"
             Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:TerminateFlowParam}">
                <StackPanel Margin="10,6">
                    <CheckBox Content="标记为异常退出 (Is Error Exit)" 
                              IsChecked="{Binding IsError, Mode=TwoWay}" 
                              Foreground="#FF8080" Margin="0,0,0,10" FontWeight="Bold"/>

                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="终止原因说明 (Reason)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}" 
                                     Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8"/>

                            <TextBlock Text="退出代码 (Exit Code)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ExitCode, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}"/>

                            <TextBlock Text="提示: 可通过 ReasonIn 端口动态传入运行时错误信息" 
                                       Foreground="#888" FontSize="10" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:TerminateFlowParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>