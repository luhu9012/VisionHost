<UserControl x:Class="Grayson.Vision.Nodes.All.FlowControl.WhileLoop.WhileLoopTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.FlowControl.WhileLoop"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="300"
             Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:WhileLoopParam}">
                <StackPanel Margin="10,6">
                    <CheckBox Content="先判断条件再执行 (While 模式)" 
                              IsChecked="{Binding CheckConditionAtStart, Mode=TwoWay}" 
                              Foreground="#DDD" Margin="0,0,0,10"/>

                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="最大循环上限 (防死循环)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding MaxIterations, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}" Margin="0,0,0,8"/>

                            <TextBlock Text="每次迭代间隔 (ms)" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding IntervalMs, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource NodeParamInputStyle}"/>

                            <TextBlock Text="提示: 请将判定结果 (Boolean) 连线至 Condition 输入端口" 
                                       Foreground="#888" FontSize="10" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:WhileLoopParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>