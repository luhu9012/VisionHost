<UserControl x:Class="Grayson.Vision.Nodes.All.Identification.DlInference.DlInferenceTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.Identification.DlInference"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:DlInferenceParam}">
                <StackPanel Margin="10">
                    <TextBlock Text="AI 任务类型:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox SelectedValue="{Binding TaskType}" Style="{StaticResource NodeParamComboBoxStyle}" Margin="0 0 0 10">
                        <local:DlTaskType>ObjectDetection</local:DlTaskType>
                        <local:DlTaskType>Classification</local:DlTaskType>
                        <local:DlTaskType>Segmentation</local:DlTaskType>
                    </ComboBox>

                    <TextBlock Text="模型路径 (Model Path):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>

                    <TextBlock Text="置信度阈值 (Confidence):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding ConfidenceThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>

                    <CheckBox Content="开启 GPU 加速 (TensorRT/CUDA)" IsChecked="{Binding UseGpu}" Foreground="#CCCCCC" Margin="0 5 0 0"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:DlInferenceParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>