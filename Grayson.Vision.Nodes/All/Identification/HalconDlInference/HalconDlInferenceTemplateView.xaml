<UserControl x:Class="Grayson.Vision.Nodes.All.Identification.HalconDlInference.HalconDlInferenceTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.Identification.HalconDlInference"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:HalconDlInferenceParam}">
                <StackPanel Margin="10">
                    <TextBlock Text="任务类型 (分类/分割):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox SelectedValue="{Binding TaskType}" Style="{StaticResource NodeParamComboBoxStyle}" Margin="0 0 0 10">
                        <local:HalconDlTaskType>Classification</local:HalconDlTaskType>
                        <local:HalconDlTaskType>Segmentation</local:HalconDlTaskType>
                    </ComboBox>

                    <TextBlock Text=".hdl 模型路径 (DLTool 导出):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid Margin="0 0 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding HdlModelPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="DLTool 导出的 .hdl 模型（相对运行目录或绝对路径；可用右侧按钮文件选择）"/>
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource NodeParamButtonStyle}"
                                Margin="6,0,0,0" Command="{Binding BrowseHdlCommand}"
                                ToolTip="文件选择 .hdl 模型（选中文件位于运行目录内时自动存为相对路径）"/>
                    </Grid>
                    <TextBlock FontSize="10.5" Margin="2,3,0,8" Text="{Binding HdlModelStateText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#E2B93B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HdlModelExists}" Value="True">
                                        <Setter Property="Foreground" Value="#3FB950"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text=".hdict 预处理参数路径 (可空):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid Margin="0 0 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding PreprocessParamPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="配套预处理参数 .hdict（normalization=none 模型可留空=仅缩放+转 real）"/>
                        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource NodeParamButtonStyle}"
                                Margin="6,0,0,0" Command="{Binding BrowseHdictCommand}"
                                ToolTip="文件选择 .hdict 预处理参数；留空也可（可空项）"/>
                    </Grid>
                    <TextBlock FontSize="10.5" Margin="2,3,0,10" Text="{Binding HdictModelStateText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#7E8A99"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HdictModelExists}" Value="True">
                                        <Setter Property="Foreground" Value="#3FB950"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HdictWarnMissing}" Value="True">
                                        <Setter Property="Foreground" Value="#E2B93B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <CheckBox Content="推理前缩放到训练尺寸 (分割必开)" IsChecked="{Binding ResizeEnabled}" Foreground="#CCCCCC" Margin="0 5 0 5"/>
                    <Grid Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ResizeWidth, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" ToolTip="训练宽度（示例药片 632）"/>
                        <TextBlock Grid.Column="1" Text=" × " Foreground="#CCCCCC" VerticalAlignment="Center" Margin="4 0"/>
                        <TextBox Grid.Column="2" Text="{Binding ResizeHeight, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" ToolTip="训练高度（示例药片 300）"/>
                    </Grid>

                    <TextBlock Text="缩放插值:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox Text="{Binding ResizeInterpolation}" Style="{StaticResource NodeParamComboBoxStyle}" Margin="0 0 0 10" IsEditable="True">
                        <ComboBoxItem Content="nearest_neighbor"/>
                        <ComboBoxItem Content="bilinear"/>
                    </ComboBox>

                    <TextBlock Text="缺陷类别 ID (逗号分隔,示例 1=破裂,2=脏污):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding DefectClassIdsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>

                    <TextBlock Text="最小缺陷面积阈值 px (示例 100):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding MinDefectArea, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:HalconDlInferenceParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>
