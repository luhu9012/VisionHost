<UserControl x:Class="Grayson.Vision.Nodes.All.Identification.ReadBarcode.ReadBarcodeTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.Identification.ReadBarcode"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:ReadBarcodeParam}">
                <StackPanel Margin="10">
                    <TextBlock Text="码制类型 (Barcode Type):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox SelectedValue="{Binding CodeType}" Style="{StaticResource NodeParamComboBoxStyle}" Margin="0 0 0 10">
                        <local:BarcodeType>Auto</local:BarcodeType>
                        <local:BarcodeType>Code128</local:BarcodeType>
                        <local:BarcodeType>Code39</local:BarcodeType>
                        <local:BarcodeType>EAN13</local:BarcodeType>
                        <local:BarcodeType>QRCode</local:BarcodeType>
                        <local:BarcodeType>DataMatrix</local:BarcodeType>
                        <local:BarcodeType>UPC</local:BarcodeType>
                        <local:BarcodeType>Aztec</local:BarcodeType>
                        <local:BarcodeType>PDF417</local:BarcodeType>
                    </ComboBox>

                    <TextBlock Text="极性 (Polarity · 二维码适用):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox SelectedValue="{Binding Polarity}" Style="{StaticResource NodeParamComboBoxStyle}" Margin="0 0 0 10">
                        <local:BarcodePolarity>Any</local:BarcodePolarity>
                        <local:BarcodePolarity>DarkOnLight</local:BarcodePolarity>
                        <local:BarcodePolarity>LightOnDark</local:BarcodePolarity>
                    </ComboBox>

                    <TextBlock Text="最大识别数量 (Max Count):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding MaxCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>

                    <TextBlock Text="条宽下限 px (Element Size Min · 0=默认):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding ElementSizeMin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>

                    <TextBlock Text="超时占位 ms (Timeout · 仅记录):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:ReadBarcodeParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>