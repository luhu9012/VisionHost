<UserControl x:Class="Grayson.Vision.Nodes.All.ImageInput.AcquireImage.AcquireImageTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.ImageInput.AcquireImage"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="300"
             Background="#1E1E1E">

    <!-- 💡 核心：利用 d:DataContext 在 VS 设计器中生成强类型假数据 preview -->
    <UserControl.Resources>
        <!-- 引入 Nodes 项目内部的统一样式表 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 节点 DataTemplate 定义 -->
            <DataTemplate DataType="{x:Type local:AcquireImageParam}">
                <StackPanel Margin="8">
                    <TextBlock Text="相机标识 (CameraAlias):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding CameraAlias, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource NodeParamInputStyle}"/>

                    <TextBlock Text="触发模式 (TriggerMode):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox SelectedValue="{Binding TriggerMode, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Tag"
                              Style="{StaticResource NodeParamComboBoxStyle}">
                        <ComboBoxItem Content="软触发 (Software)" Tag="Software"/>
                        <ComboBoxItem Content="硬触发 (Hardware)" Tag="Hardware"/>
                        <ComboBoxItem Content="连续采集 (Continuous)" Tag="Continuous"/>
                    </ComboBox>

                    <TextBlock Text="曝光时间 μs (ExposureTime):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding ExposureTime, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource NodeParamInputStyle}"/>

                    <TextBlock Text="增益 Gain:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource NodeParamInputStyle}"/>

                    <TextBlock Text="超时等待 ms (TimeoutMs):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource NodeParamInputStyle}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 💡 预览挂载点：VS 界面设计器打开此文件时直接显示预览效果 -->
    <Grid d:DataContext="{d:DesignInstance Type=local:AcquireImageParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>