<UserControl x:Class="Grayson.Vision.Nodes.All.ImageInput.ImageChannel.ImageChannelTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.ImageInput.ImageChannel"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="300" Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:ImageChannelParam}">
                <StackPanel Margin="8">
                    <TextBlock Text="相机标识 (Cam Alias):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding CameraAlias, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>

                    <TextBlock Text="触发模式 (Trigger Mode):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox SelectedValue="{Binding TriggerMode}" Style="{StaticResource NodeParamComboBoxStyle}">
                        <ComboBoxItem Content="Software"/>
                        <ComboBoxItem Content="Hardware"/>
                        <ComboBoxItem Content="Continuous"/>
                    </ComboBox>

                    <Grid Margin="0 8 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0 0 4 0">
                            <TextBlock Text="曝光时间 (us):" Style="{StaticResource NodeParamHeaderLabel}"/>
                            <TextBox Text="{Binding ExposureTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="4 0 0 0">
                            <TextBlock Text="增益 (Gain):" Style="{StaticResource NodeParamHeaderLabel}"/>
                            <TextBox Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="超时等待 (ms):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:ImageChannelParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>