<UserControl x:Class="Grayson.Vision.Nodes.All.ImageInput.ReadImageFile.ReadImageFileTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.ImageInput.ReadImageFile"
             mc:Ignorable="d" d:DesignHeight="400" d:DesignWidth="300" Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:ReadImageFileParam}">
                <StackPanel Margin="8">
                    <!-- 模式切换 -->
                    <CheckBox Content="批处理文件夹模式" 
                              IsChecked="{Binding IsBatchFolder}" 
                              Foreground="White" 
                              Margin="0 4 0 10"/>

                    <!-- 1. 单文件路径选择区 -->
                    <TextBlock Text="单图文件路径:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid Margin="0 2 0 8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding IsBatchFolder, Converter={StaticResource InverseBoolConverter}}"
                                 Style="{StaticResource NodeParamInputStyle}"/>

                        <Button Grid.Column="1" 
                                Content="📁 浏览..." 
                                Margin="4 0 0 0" 
                                Padding="8 0" 
                                Height="26"
                                Background="#3E3E42" 
                                Foreground="White" 
                                BorderThickness="0"
                                IsEnabled="{Binding IsBatchFolder, Converter={StaticResource InverseBoolConverter}}"
                                Click="BtnBrowseFile_Click"/>
                    </Grid>

                    <!-- 2. 文件夹路径选择区 -->
                    <TextBlock Text="批处理文件夹路径:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid Margin="0 2 0 8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding IsBatchFolder}"
                                 Style="{StaticResource NodeParamInputStyle}"/>

                        <Button Grid.Column="1" 
                                Content="📂 浏览..." 
                                Margin="4 0 0 0" 
                                Padding="8 0" 
                                Height="26"
                                Background="#3E3E42" 
                                Foreground="White" 
                                BorderThickness="0"
                                IsEnabled="{Binding IsBatchFolder}"
                                Click="BtnBrowseFolder_Click"/>
                    </Grid>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:ReadImageFileParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>