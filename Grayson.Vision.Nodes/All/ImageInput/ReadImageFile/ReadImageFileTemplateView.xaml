<UserControl x:Class="Grayson.Vision.Nodes.All.ImageInput.ReadImageFile.ReadImageFileTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.ImageInput.ReadImageFile"
             mc:Ignorable="d" d:DesignHeight="480" d:DesignWidth="320" Background="#1E1E1E">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:ReadImageFileParam}">
                <StackPanel Margin="10,6">

                    <!-- 1. 工业级分段模式切换卡 -->
                    <Border Background="#252526" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0" Content="📄 静态单图" 
                                         Height="26"
                                         IsChecked="{Binding IsBatchFolder, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                         Style="{StaticResource {x:Type ToggleButton}}" 
                                         Background="Transparent" Foreground="#AAAAAA"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         BorderThickness="0"/>

                            <RadioButton Grid.Column="1" Content="📁 批处理文件夹" 
                                         Height="26"
                                         IsChecked="{Binding IsBatchFolder, Mode=TwoWay}"
                                         Style="{StaticResource {x:Type ToggleButton}}" 
                                         Background="Transparent" Foreground="#AAAAAA"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         BorderThickness="0"/>
                        </Grid>
                    </Border>

                    <!-- 2. 单文件路径选择卡片 -->
                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="图像文件路径" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" 
                                         Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" 
                                         IsEnabled="{Binding IsBatchFolder, Converter={StaticResource InverseBoolConverter}}"
                                         Style="{StaticResource NodeParamInputStyle}"/>

                                <!-- 🌟 替换 Click 为 Command 绑定 -->
                                <Button Grid.Column="1" 
                                        Content="浏览..." 
                                        Margin="4,0,0,0" 
                                        Style="{StaticResource NodeParamButtonStyle}"
                                        IsEnabled="{Binding IsBatchFolder, Converter={StaticResource InverseBoolConverter}}"
                                        Command="{Binding BrowseFileCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 3. 批处理文件夹卡片 -->
                    <Border Background="#252526" BorderBrush="#333337" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="批处理文件夹" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" 
                                         Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" 
                                         IsEnabled="{Binding IsBatchFolder}"
                                         Style="{StaticResource NodeParamInputStyle}"/>

                                <!-- 🌟 替换 Click 为 Command 绑定 -->
                                <Button Grid.Column="1" 
                                        Content="目录..." 
                                        Margin="4,0,0,0" 
                                        Style="{StaticResource NodeParamButtonStyle}"
                                        IsEnabled="{Binding IsBatchFolder}"
                                        Command="{Binding BrowseFolderCommand}"/>
                            </Grid>

                            <TextBlock Text="文件夹包含图片" Style="{StaticResource NodeParamHeaderLabel}" Margin="0,2,0,2"/>
                            <ListBox Height="120"
                                     ItemsSource="{Binding FileItems}"
                                     SelectedIndex="{Binding CurrentImageIndex, Mode=TwoWay}"
                                     IsEnabled="{Binding IsBatchFolder}"
                                     Style="{StaticResource NodeParamListBoxStyle}"
                                     SelectionChanged="LstFiles_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" ToolTip="{Binding}" FontSize="11" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <CheckBox Content="自动循环播放文件夹列表" 
                                      IsChecked="{Binding LoopFolder}" 
                                      IsEnabled="{Binding IsBatchFolder}"
                                      Style="{StaticResource NodeParamCheckBoxStyle}"
                                      Margin="0,8,0,2"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:ReadImageFileParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}" Focusable="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </Grid>
</UserControl>