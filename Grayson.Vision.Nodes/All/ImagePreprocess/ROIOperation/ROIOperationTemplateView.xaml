<UserControl x:Class="Grayson.Vision.Nodes.All.ImagePreprocess.ROIOperation.ROIOperationTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.ImagePreprocess.ROIOperation"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:ROIOperationParam}">
                <StackPanel Margin="10">
                    <TextBlock Text="ROI 操作类型:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox SelectedValue="{Binding OpType}" Style="{StaticResource NodeParamComboBoxStyle}" Margin="0 0 0 10">
                        <local:RoiOpType>Crop</local:RoiOpType>
                        <local:RoiOpType>GenerateMask</local:RoiOpType>
                        <local:RoiOpType>Intersection</local:RoiOpType>
                        <local:RoiOpType>Union</local:RoiOpType>
                        <local:RoiOpType>Difference</local:RoiOpType>
                    </ComboBox>

                    <!-- 只有当类型为 Crop 时才显示裁剪坐标 -->
                    <StackPanel x:Name="CropAreaPanel">
                        <TextBlock Text="左上 Row1 (Y):" Style="{StaticResource NodeParamHeaderLabel}"/>
                        <TextBox Text="{Binding Row1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 8"/>

                        <TextBlock Text="左上 Col1 (X):" Style="{StaticResource NodeParamHeaderLabel}"/>
                        <TextBox Text="{Binding Col1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 8"/>

                        <TextBlock Text="右下 Row2 (Y):" Style="{StaticResource NodeParamHeaderLabel}"/>
                        <TextBox Text="{Binding Row2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 8"/>

                        <TextBlock Text="右下 Col2 (X):" Style="{StaticResource NodeParamHeaderLabel}"/>
                        <TextBox Text="{Binding Col2, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 8"/>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:ROIOperationParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>