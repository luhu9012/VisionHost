<UserControl x:Class="Grayson.Vision.Nodes.All.Measurement2D.BlobAnalysis.BlobAnalysisTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.Measurement2D.BlobAnalysis"
             mc:Ignorable="d" d:DesignHeight="380" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:BlobAnalysisParam}">
                <StackPanel Margin="10">
                    <TextBlock Text="面积下限 (Area Min, px²):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding AreaMin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 5"/>
                    <TextBlock Text="面积上限 (Area Max, px²):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding AreaMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>

                    <TextBlock Text="判据·个数下限 (Count Min):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding CountMin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 5"/>
                    <TextBlock Text="判据·个数上限 (Count Max):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding CountMax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 10"/>
                    <TextBlock Text="有无检测: Min=1 / Max=999999&#x0a;异物检测: Min=0 / Max=0" Style="{StaticResource NodeParamHeaderLabel}" Opacity="0.6" TextWrapping="Wrap"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:BlobAnalysisParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>
