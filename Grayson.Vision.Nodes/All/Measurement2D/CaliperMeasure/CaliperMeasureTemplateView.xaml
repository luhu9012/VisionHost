<UserControl x:Class="Grayson.Vision.Nodes.All.Measurement2D.CaliperMeasure.CaliperMeasureTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.Measurement2D.CaliperMeasure"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:CaliperMeasureParam}">
                <StackPanel Margin="10">
                    <TextBlock Text="直线卡尺找边：沿目标边缘散布多探针取样，输出命中的亚像素边缘点集（不做拟合）" 
                               Foreground="#9E9E9E" FontSize="11" TextWrapping="Wrap" Margin="0 0 0 8"/>
                    <TextBlock Text="种子中点 Row / Col:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid Margin="0 2 0 6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SeedMidRow, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="边缘段中点行（图像 Y）。粗定位落在边缘 ±ScanHalf 内即可；也可接上游 ShapeMatch.MatchRow"/>
                        <TextBox Grid.Column="2" Text="{Binding SeedMidCol, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>
                    </Grid>
                    <TextBlock Text="边缘走向 EdgePhi (°):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding EdgePhiDeg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 6"
                             ToolTip="边缘走向角度：0=水平边缘（探针沿水平散布、竖直扫描）；90=竖直边缘。斜边填实际角度；也可接上游 ShapeMatch.MatchAngle"/>
                    <TextBlock Text="沿边半跨距 / 扫描半长:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid Margin="0 2 0 6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding HalfSpanAlongEdge, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="探针沿边散布范围半长（边缘段长度一半）"/>
                        <TextBox Grid.Column="2" Text="{Binding ScanHalf, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="横跨边缘探测半长（须盖住边缘模糊带）"/>
                    </Grid>
                    <TextBlock Text="沿边平均半宽 / 探针数:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid Margin="0 2 0 6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ProbeAvgHalf, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="单探针沿边平均半宽（默认 2，过大边缘点沿边模糊）"/>
                        <TextBox Grid.Column="2" Text="{Binding NumPoints, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="沿边探针数（3~15）；每探针命中 1 个代表边缘点，点集长度 ≤ 此值"/>
                    </Grid>
                    <TextBlock Text="边缘强度阈值 / Sigma:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid Margin="0 2 0 6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="边缘对比度阈值（灰度差）"/>
                        <TextBox Grid.Column="2" Text="{Binding Sigma, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="高斯平滑 Sigma"/>
                    </Grid>
                    <TextBlock Text="极性 Transition:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox ItemsSource="{Binding TransitionItems}" SelectedItem="{Binding Transition}"
                              Style="{StaticResource NodeParamComboBoxStyle}" Margin="0 2 0 6"/>
                    <TextBlock Text="单探针取边 Select:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox ItemsSource="{Binding SelectItems}" SelectedItem="{Binding Select}"
                              Style="{StaticResource NodeParamComboBoxStyle}" Margin="0 2 0 6"
                              ToolTip="单探针带内多条边缘时：All=幅度最大（推荐）/ First=近带中心 / Last=远"/>
                    <TextBlock Text="提示：点集可用作下游『两点距离/边缘对间距/几何建构』输入（Rows/Cols 数组一一对应）；探针漏边则该处缺席。"
                               Foreground="#9E9E9E" FontSize="11" TextWrapping="Wrap" Margin="0 8 0 0"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:CaliperMeasureParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>
