<UserControl x:Class="Grayson.Vision.Nodes.All.Measurement2D.FitCircle.FitCircleTemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Grayson.Vision.Nodes.All.Measurement2D.FitCircle"
             mc:Ignorable="d" d:DesignHeight="560" d:DesignWidth="300" Background="#1E1E1E">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vision.Nodes;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type local:FitCircleParam}">
                <StackPanel Margin="10">
                    <TextBlock Text="环形卡尺：在粗圆心周围取样边缘点，亚像素拟合圆心与半径" 
                               Foreground="#9E9E9E" FontSize="11" TextWrapping="Wrap" Margin="0 0 0 8"/>
                    <TextBlock Text="种子圆心 Row (Y):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding SeedRow, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 6"
                             ToolTip="粗圆心行坐标（图像 Y）。拟合圆通常收敛在真圆心的 ±10px 内，种子大致即可；也可接上游 ShapeMatch 的 MatchRow"/>
                    <TextBlock Text="种子圆心 Col (X):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding SeedCol, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 6"/>
                    <TextBlock Text="期望半径 R (px):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding Radius, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 6"
                             ToolTip="环形测量带的中线半径；取样带覆盖半径 ±AnnulusHalf 的环带"/>
                    <TextBlock Text="环半宽 (px):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding AnnulusHalf, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="0 0 0 6"
                             ToolTip="取样环带厚度（默认 8）。太小漏边，太大把相邻边缘/毛刺混进来"/>
                    <TextBlock Text="弧段起始 / 跨度 (°):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid Margin="0 2 0 6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding ArcStartDeg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="弧段起始角（0=右侧，逆时针为正）"/>
                        <TextBox Grid.Column="2" Text="{Binding ArcExtentDeg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="弧段跨度：整圆 360；半圆工件设 180 减少干扰边"/>
                    </Grid>
                    <TextBlock Text="边缘强度阈值 / Sigma:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid Margin="0 2 0 6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="边缘对比度阈值（灰度差）。太小抓噪声、太大漏边"/>
                        <TextBox Grid.Column="2" Text="{Binding Sigma, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                                 ToolTip="高斯平滑 Sigma（越大边缘越钝越稳）"/>
                    </Grid>
                    <TextBlock Text="极性 Transition:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox ItemsSource="{Binding TransitionItems}" SelectedItem="{Binding Transition}"
                              Style="{StaticResource NodeParamComboBoxStyle}" Margin="0 2 0 6"
                              ToolTip="All=任意明暗过渡（默认，受光照影响小）；Positive=暗→亮；Negative=亮→暗"/>
                    <TextBlock Text="环带内取边 Select:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox ItemsSource="{Binding SelectItems}" SelectedItem="{Binding Select}"
                              Style="{StaticResource NodeParamComboBoxStyle}" Margin="0 2 0 6"
                              ToolTip="环带半径内外可能各有一条边：All=保留幅度更大的一条链（推荐）；First=靠近种子半径；Last=远离"/>
                    <TextBlock Text="最少边缘点:" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding MinEdgePoints, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"
                             ToolTip="有效边缘点不足此数判拟合失败（默认 8）"/>
                    <TextBlock Text="提示：圆心/半径种子可接上游 ShapeMatch 输出（MatchRow→SeedRow、MatchCol→SeedCol），组成 粗定位→精测 链；运行后绿色大十字=拟合圆心。"
                               Foreground="#9E9E9E" FontSize="11" TextWrapping="Wrap" Margin="0 8 0 0"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:FitCircleParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</UserControl>
