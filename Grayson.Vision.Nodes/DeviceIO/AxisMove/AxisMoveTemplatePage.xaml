<Page x:Class="Grayson.Vision.Nodes.DeviceIO.AxisMove.AxisMoveTemplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Grayson.Vision.Nodes.DeviceIO.AxisMove"
      mc:Ignorable="d" Background="#1E1E1E">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="NodeParamHeaderLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#AAAAAA"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,6,0,2"/>
            </Style>
            <Style x:Key="NodeParamInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#2D2D30"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#434346"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <DataTemplate DataType="{x:Type local:AxisMoveParam}">
                <StackPanel Margin="8">
                    <TextBlock Text="轴标识 (AxisName):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding AxisName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>

                    <CheckBox Content="相对位移 (IsRelative)" IsChecked="{Binding IsRelative}" Foreground="#FFFFFF" Margin="0,8,0,4"/>

                    <TextBlock Text="目标位置/位移 mm (TargetPosition):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding TargetPosition, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>

                    <TextBlock Text="运动速度 mm/s (Speed):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>

                    <CheckBox Content="等待到位 (WaitUntilDone)" IsChecked="{Binding WaitUntilDone}" Foreground="#FFFFFF" Margin="0,8,0,0"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:AxisMoveParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</Page>