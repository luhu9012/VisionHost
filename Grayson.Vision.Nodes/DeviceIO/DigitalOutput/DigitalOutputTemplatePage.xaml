<Page x:Class="Grayson.Vision.Nodes.DeviceIO.DigitalOutput.DigitalOutputTemplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Grayson.Vision.Nodes.DeviceIO.DigitalOutput"
      mc:Ignorable="d" Background="#1E1E1E">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="NodeParamHeaderLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#AAAAAA"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,6,0,2"/>
            </Style>
            <Style x:Key="NodeParamInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#2D2D30"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#434346"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <DataTemplate DataType="{x:Type local:DigitalOutputParam}">
                <StackPanel Margin="8">
                    <TextBlock Text="IO 板卡标识 (IoCardAlias):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding IoCardAlias, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>

                    <TextBlock Text="DO 输出通道 (Channel):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>

                    <CheckBox Content="开启/高电平 (OutputValue)" IsChecked="{Binding OutputValue}" Foreground="#FFFFFF" Margin="0,8,0,4"/>
                    <CheckBox Content="脉冲触发模式 (IsPulse)" IsChecked="{Binding IsPulse}" Foreground="#FFFFFF" Margin="0,4,0,4"/>

                    <TextBlock Text="脉冲宽度 ms (PulseDurationMs):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding PulseDurationMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:DigitalOutputParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</Page>