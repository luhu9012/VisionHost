<Page x:Class="Grayson.Vision.Nodes.DeviceIO.LightControl.LightControlTemplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Grayson.Vision.Nodes.DeviceIO.LightControl"
      mc:Ignorable="d" Background="#1E1E1E">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="NodeParamHeaderLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#AAAAAA"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,6,0,2"/>
            </Style>
            <Style x:Key="NodeParamInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#2D2D30"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#434346"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <DataTemplate DataType="{x:Type local:LightControlParam}">
                <StackPanel Margin="8">
                    <TextBlock Text="光源控制器 (ControllerAlias):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding ControllerAlias, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>

                    <TextBlock Text="光源通道 (Channel):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>

                    <CheckBox Content="开启光源 (TurnOn)" IsChecked="{Binding TurnOn}" Foreground="#FFFFFF" Margin="0,8,0,4"/>

                    <TextBlock Text="通道亮度 (Brightness 0-255):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="255" Value="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Brightness, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}" Margin="5,0,0,0"/>
                    </Grid>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:LightControlParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</Page>