<Page x:Class="Grayson.Vision.Nodes.DeviceIO.PlcReadWrite.PlcReadWriteTemplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Grayson.Vision.Nodes.DeviceIO.PlcReadWrite"
      mc:Ignorable="d" Background="#1E1E1E">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="NodeParamHeaderLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#AAAAAA"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,6,0,2"/>
            </Style>
            <Style x:Key="NodeParamInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#2D2D30"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#434346"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <DataTemplate DataType="{x:Type local:PlcReadWriteParam}">
                <StackPanel Margin="8">
                    <TextBlock Text="PLC 标识 (PlcAlias):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding PlcAlias, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>

                    <TextBlock Text="操作类型 (Operation):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox SelectedValue="{Binding Operation, UpdateSourceTrigger=PropertyChanged}" Margin="0,2">
                        <local:PlcOpType>Read</local:PlcOpType>
                        <local:PlcOpType>Write</local:PlcOpType>
                    </ComboBox>

                    <TextBlock Text="DB/寄存器地址 (DbAddress):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding DbAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>

                    <TextBlock Text="数据类型 (DataType):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>

                    <TextBlock Text="写入默认值 (WriteValue):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding WriteValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:PlcReadWriteParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</Page>