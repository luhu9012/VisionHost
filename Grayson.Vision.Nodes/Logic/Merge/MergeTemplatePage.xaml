<Page x:Class="Grayson.Vision.Nodes.Logic.Merge.MergeTemplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Grayson.Vision.Nodes.Logic.Merge"
      mc:Ignorable="d" Background="#1E1E1E">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="NodeParamHeaderLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#AAAAAA"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,6,0,2"/>
            </Style>

            <DataTemplate DataType="{x:Type local:MergeParam}">
                <StackPanel Margin="8">
                    <TextBlock Text="数据合并模式 (DataMode):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <ComboBox SelectedValue="{Binding DataMode, UpdateSourceTrigger=PropertyChanged}" Margin="0,2">
                        <local:MergeDataMode>FirstNonNull</local:MergeDataMode>
                        <local:MergeDataMode>CollectList</local:MergeDataMode>
                        <local:MergeDataMode>PassThrough</local:MergeDataMode>
                    </ComboBox>

                    <CheckBox Content="每次流程开始时清空缓存列表" 
                              IsChecked="{Binding ClearListOnStart}" 
                              Foreground="#FFFFFF" Margin="0,8,0,0"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:MergeParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</Page>