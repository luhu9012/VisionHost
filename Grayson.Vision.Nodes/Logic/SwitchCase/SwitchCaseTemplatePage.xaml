<Page x:Class="Grayson.Vision.Nodes.Logic.SwitchCase.SwitchCaseTemplatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Grayson.Vision.Nodes.Logic.SwitchCase"
      mc:Ignorable="d" Background="#1E1E1E">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="NodeParamHeaderLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#AAAAAA"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0,6,0,2"/>
            </Style>
            <Style x:Key="NodeParamInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#2D2D30"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="#434346"/>
                <Setter Property="Padding" Value="5,3"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <DataTemplate DataType="{x:Type local:SwitchCaseParam}">
                <StackPanel Margin="8">
                    <TextBlock Text="默认选择键 (SelectorKey):" Style="{StaticResource NodeParamHeaderLabel}"/>
                    <TextBox Text="{Binding SelectorKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NodeParamInputStyle}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Grid d:DataContext="{d:DesignInstance Type=local:SwitchCaseParam, IsDesignTimeCreatable=True}">
        <ContentControl Content="{Binding}"/>
    </Grid>
</Page>