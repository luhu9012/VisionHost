<Window x:Class="Grayson.Vision.WpfUI.View.AddDeviceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动添加硬件设备" Height="400" Width="700" 
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <!-- 覆盖 ToolTip 默认样式为暗色背景 + 亮色文字 -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#007ACC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- 1. 选择设备类别 -->
            <TextBlock Text="设备类别 (Category):" Style="{StaticResource FormLabelStyle}"/>
            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Style="{StaticResource ModernComboBoxStyle}" Margin="0,5,0,12" Height="32"/>

            <!-- 2. 选择驱动/品牌（依据Category联动） -->
            <TextBlock Text="硬件品牌/驱动插件 (Brand):" Style="{StaticResource FormLabelStyle}"/>
            <ComboBox ItemsSource="{Binding AvailableBrands}" SelectedItem="{Binding SelectedBrand}" Style="{StaticResource ModernComboBoxStyle}" Margin="0,5,0,12" Height="32"/>

            <!-- 3. 输入逻辑 Key -->
            <TextBlock Text="设备逻辑名称 (DeviceKey, 如 Cam_Top_01):" Style="{StaticResource FormLabelStyle}"/>
            <TextBox Text="{Binding DeviceKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,5,0,12" Height="32"/>

            <!-- 4. 初始连接凭证 ConnectionString -->
            <TextBlock Text="默认连接字符串 (ConnectionString):" Style="{StaticResource FormLabelStyle}"/>
            <TextBox Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}" 
         ToolTip="常用品牌 ConnectionString 配置示例:&#x0a;• 西门子(S7): Protocol=SiemensS7;IP=192.168.1.10;Port=102;Extra=S1200&#x0a;• Modbus/汇川: Protocol=ModbusTcp;IP=192.168.1.20;Port=502;Extra=1&#x0a;• 三菱(MC): Protocol=MitsubishiMc;IP=192.168.1.30;Port=6000;Extra=Binary&#x0a;• 欧姆龙(FINS): Protocol=OmronFins;IP=192.168.1.40;Port=9600;Extra=0"
         Style="{StaticResource ModernTextBoxStyle}" Height="32"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="确定添加" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PrimaryButtonStyle}" Width="100" Height="32" Margin="0,0,10,0"/>
            <Button Content="取消" IsCancel="True" Style="{StaticResource DangerButtonStyle}" Width="80" Height="32"/>
        </StackPanel>
    </Grid>
</Window>