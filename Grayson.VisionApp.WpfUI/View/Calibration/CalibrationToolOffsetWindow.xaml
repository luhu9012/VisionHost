<Window x:Class="Grayson.Vision.WpfUI.View.CalibrationToolOffsetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:halcon="clr-namespace:Grayson.Vision.HalconWrapper.Wpf.Controls;assembly=Grayson.Vision.HalconWrapper.Wpf"
        Title="对针补偿"
        Width="1180" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部状态条 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{Binding SessionNote}" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding StepHintText}" Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold"
                           Foreground="#FF8A5A00" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 设备行 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="10,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="相机:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox Width="200" Margin="4,0,16,0" ItemsSource="{Binding CameraDeviceList}"
                          SelectedItem="{Binding SelectedCamera}"
                          IsEnabled="{Binding IsDeviceSwitchEnabled}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DeviceKey}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="运动卡:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox Width="200" ItemsSource="{Binding MotionDeviceList}"
                          SelectedItem="{Binding SelectedMotion}"
                          IsEnabled="{Binding IsDeviceSwitchEnabled}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DeviceKey}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Border DockPanel.Dock="Left" Background="#22FFFFFF" CornerRadius="10" Padding="10,2" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPosText, StringFormat=当前轴位: {0}}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#FF1E6B3C"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 中部：图像 + 步骤面板 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="2">
                <Grid>
                    <halcon:HalconImageDisplayHost x:Name="ImageHost"
                                                   DataContext="{Binding ImageDisplay}"
                                                   ShowToolbar="True"/>
                    <Border Background="Transparent"
                            PreviewMouseLeftButtonDown="Overlay_PreviewMouseLeftButtonDown"
                            Cursor="Cross">
                        <TextBlock Text="点选特征 P 的真实位置(A') — 到位前不会动轴"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                   Foreground="#88000000" FontSize="11" Background="#22000000" Padding="10,3"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="P4 对针补偿（ToolOffset 自学习）" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Profile.Name}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextDisabledBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- ① 步进对针 -->
                    <TextBlock Grid.Row="1" Text="① 低速步进对准特征 P" FontSize="12" FontWeight="Bold"
                               Margin="0,10,0,0" Foreground="#FF25579B"/>
                    <WrapPanel Grid.Row="2" Margin="0,6,0,0">
                        <UniformGrid Columns="2" Width="150" Margin="0,0,8,0">
                            <Button Content="-X" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding StepMoveCommand}"
                                    CommandParameter="-x" Height="26" Margin="0,0,4,4"/>
                            <Button Content="+X" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding StepMoveCommand}"
                                    CommandParameter="+x" Height="26" Margin="0,0,0,4"/>
                            <Button Content="-Y" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding StepMoveCommand}"
                                    CommandParameter="-y" Height="26" Margin="0,0,4,0"/>
                            <Button Content="+Y" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding StepMoveCommand}"
                                    CommandParameter="+y" Height="26"/>
                        </UniformGrid>
                        <StackPanel VerticalAlignment="Top">
                            <ComboBox Width="80" ItemsSource="{Binding StepSizeOptions}" SelectedItem="{Binding StepSize}"
                                      VerticalAlignment="Center"/>
                            <TextBlock Text="步距 mm" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"/>
                        </StackPanel>
                    </WrapPanel>

                    <Button Grid.Row="3" Content="📌 工具头已对准特征 —— 锁定 M_tool"
                            Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="0,8,0,0"
                            Command="{Binding LockMToolCommand}"/>
                    <Border Grid.Row="4" Margin="0,6,0,0" Padding="8,5" CornerRadius="4"
                            Background="{DynamicResource SurfaceBrush}">
                        <TextBlock Text="{Binding MToolText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="#FF1E6B3C" FontWeight="SemiBold"/>
                    </Border>

                    <!-- ② 抓拍画理论点 -->
                    <Button Grid.Row="5" Content="📷 移开后抓拍并标注理论点 A"
                            Style="{StaticResource SuccessButtonStyle}" Height="34" Margin="0,8,0,0"
                            Command="{Binding CaptureAndMarkCommand}"/>

                    <!-- ③ 点选与 δ -->
                    <Border Grid.Row="6" Margin="0,8,0,0" Padding="8,5" CornerRadius="4" Background="#0A378ADD">
                        <TextBlock Text="{Binding DeltaText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <TextBlock Grid.Row="7" Text="{Binding HasPickedText}" FontSize="11" Margin="2,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <Button Grid.Row="8" Content="✅ 写入 ToolOffset（δ_world）"
                            Style="{StaticResource SuccessButtonStyle}" Height="36" Margin="0,8,0,0"
                            Command="{Binding WriteToolOffsetCommand}"/>

                    <ItemsControl Grid.Row="9" ItemsSource="{Binding LogLines}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Row="10" Content="↩ 重新对针" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="12,5" Command="{Binding RedoCommand}" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部：完成 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="10,6" Margin="0,8,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✔ 完成（关闭并保存）" Style="{StaticResource SuccessButtonStyle}"
                        Padding="14,6" Click="DoneAndClose_Click"/>
                <TextBlock Text="关闭后 ToolOffset 随方案保存；可到「标定校验台」做 点哪去哪 验收"
                           FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
