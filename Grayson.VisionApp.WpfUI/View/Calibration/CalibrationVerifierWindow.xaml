<Window x:Class="Grayson.Vision.WpfUI.View.CalibrationVerifierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:halcon="clr-namespace:Grayson.Vision.HalconWrapper.Wpf.Controls;assembly=Grayson.Vision.HalconWrapper.Wpf"
        Title="标定校验台"
        Width="1180" Height="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <!-- 单轴步进 RepeatButton 小尺寸样式（与机械臂调试台同款遥控器键位，缩放到校验台右栏） -->
        <Style x:Key="StepRepeatBtnStyleSmall" TargetType="RepeatButton">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Delay" Value="450"/>
            <Setter Property="Interval" Value="260"/>
            <Setter Property="ToolTip" Value="单击走一步；按住连续微动（松开即停）"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="0,2">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：会话状态条 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,8">
            <DockPanel>
                <Border DockPanel.Dock="Left" Background="#22FFFFFF" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Profile.BoundStationCode}" FontWeight="Bold" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <TextBlock Text="{Binding SessionNote}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- 设备行 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="10,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="相机:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox Width="200" Margin="4,0,16,0" ItemsSource="{Binding CameraDeviceList}"
                          SelectedItem="{Binding SelectedCamera}"
                          IsEnabled="{Binding IsDeviceSwitchEnabled}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DeviceKey}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="运动卡:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox Width="200" ItemsSource="{Binding MotionDeviceList}"
                          SelectedItem="{Binding SelectedMotion}"
                          IsEnabled="{Binding IsDeviceSwitchEnabled}"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DeviceKey}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{Binding SummaryText}" Margin="24,0,0,0" FontSize="12.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="#FF107C41"/>
            </StackPanel>
        </Border>

        <!-- 中部：图像 + 右侧操作面板 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：图像宿主 + 点选覆盖层 -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="2">
                <Grid>
                    <halcon:HalconImageDisplayHost x:Name="ImageHost"
                                                   DataContext="{Binding ImageDisplay}"
                                                   ShowToolbar="True"/>
                    <!-- 点选覆盖层：上边距让出工具栏区（TopReservedHeight），鼠标移到工具栏恢复正常点击/悬停，不再被覆盖层抢走 -->
                    <Border Background="Transparent"
                            PreviewMouseLeftButtonDown="Overlay_PreviewMouseLeftButtonDown"
                            Cursor="Cross"
                            Margin="{Binding TopReservedHeight, ElementName=ImageHost, Converter={StaticResource TopMarginConverter}}">
                        <TextBlock Text="抓拍/实时后，在画面上点击特征点 —— 吸嘴会自动去吸那个点（按工位标定组合自动补偿）"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                   Foreground="#88000000" FontSize="11" Background="#22000000" Padding="10,3"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 右：操作面板（★2026-09-12 精简：校验台唯一功能=点像素→低速移动→吸嘴贴合，
                 移除「残差体检」「分步几何校验」诊断 Tab，只留在线打点主链路 + 必要轴操作） -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="{Binding ShapeName}" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding SlotChipText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               ToolTip="本方案所属的工位相机槽（复合工位上/下相机各一条，校验前请确认槽对得上）"/>
                                    <TextBlock Text="·" FontSize="11" Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextDisabledBrush}"/>
                                    <TextBlock Text="{Binding LayoutName}" FontSize="11" Margin="6,0,0,0"
                                               Foreground="#FF107C41"/>
                                    <TextBlock Text="{Binding Profile.Name}" FontSize="11" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextDisabledBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button Content="📷 抓拍定格" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"
                                        Command="{Binding CaptureCommand}" Margin="0,0,6,0"/>
                                <Button Content="▶ 实时预览" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"
                                        Command="{Binding StartLiveCommand}"/>
                            </WrapPanel>

                            <!-- 相机安装特性(2026-09-08 泛化)：勾=相机随 Z 升降(拍照须回 CalibZ)；不勾=相机固定(成像与 Z 无关)。空=未声明(按随Z保守)。关窗保存档案。 -->
                            <Border Grid.Row="2" Margin="0,8,0,0" Padding="8,6" CornerRadius="4"
                                    Background="{DynamicResource SurfaceBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="相机随 Z 升降（拍照须回标定高度）"
                                                  IsChecked="{Binding CameraMovesWithZ}"
                                                  VerticalAlignment="Center" FontSize="11"/>
                                        <TextBlock Text="{Binding CameraMountInfoText}" FontSize="10.5" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <!-- ★2026-09-15 消费口径声明（三态：勾=是 / 不勾=否 / 中间=未声明）。
                                         它决定生产端要不要叠 O、要不要减 U 旋转项——分错差几毫米且 RMS 抓不到。
                                         关窗即落库，发布工位时按它写 NeedsOCompensation。 -->
                                    <CheckBox Content="H 已在吸嘴域（延伸杆偏心已在标定阶段扣掉 → 生产直吸 H(u)）"
                                              IsChecked="{Binding HandEyeInNozzleDomain}" IsThreeState="True"
                                              Margin="0,6,0,0" FontSize="11"
                                              ToolTip="勾=H 已消杆（命令到 H(u) 即吸嘴对准像素）；不勾=H 在杆端域（命令到 H(u) 只把【杆端 mark】送到该像素，固定相机要再补杆端偏移 b=对针t 或旋转标定的 ToolEccW；只有 EIH 才叠旋转中心 O）；中间=未声明（按采集路径保守判定）"/>
                                    <CheckBox Content="吸嘴与 U 轴同轴（转 U 时吸嘴 XY 原地不动 → 免 U 旋转项）"
                                              IsChecked="{Binding NozzleAxisCoaxial}" IsThreeState="True"
                                              Margin="0,3,0,0" FontSize="11"
                                              ToolTip="勾=同轴（消费不做 R(U−U0)·e，U 只定姿态）；不勾=偏心吸嘴（保留该项）；中间=未声明（保守保留）。判据：绕 U 转 30° 前后各测同一不动特征，吸嘴尖偏差 d0≈d30≈0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="3" Margin="0,8,0,0" Padding="8" CornerRadius="4"
                                    Background="{DynamicResource SurfaceBrush}">
                                <StackPanel>
                                    <!-- ★★2026-09-15：口径改为【系统判定】——不再让用户自己拼条件。
                                         平台按【工位档案 + 标定条件】自动定好标定转换方式（判定入口与发布链、
                                         生产端是同一个函数），用户只需确认或一键采纳；要反驳也有下面的高级对照区。
                                         动机：手拼分型心智负担太高，且拼错了没有闸门能发现（分型错只是整体平移，RMS 抓不到）。 -->
                                    <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                        <TextBlock DockPanel.Dock="Left" Text="标定转换方式（系统判定）:" FontSize="11"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Button DockPanel.Dock="Right" Content="✔ 采纳并写入档案" FontSize="11"
                                                Padding="8,2" VerticalAlignment="Center"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding AdoptSystemDecisionCommand}"
                                                ToolTip="把系统判定的『H 落在哪个域 / 吸嘴是否与 U 轴同轴』写成确定值并落库——此后校验台、发布链、生产端看到的是同一个口径，不再各推一遍"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding SystemDecisionText}" FontSize="12" FontWeight="Bold"
                                               TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}"/>
                                    <TextBlock Text="{Binding SystemDecisionFormula}" FontSize="11.5" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SystemDecisionBasis}" FontSize="10.5" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               ToolTip="为什么判成这一档：档案声明 + 标定条件（旋转拟合圆半径 / 特征模板名 / 采集路径）。不认同就反驳这几条。"/>
                                    <TextBlock Text="{Binding SystemDecisionDecl}" FontSize="10.5" Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextDisabledBrush}"/>
                                    <!-- 阻断/告警：有就直接把处方摆出来，不许静默（空串时自然不占高度） -->
                                    <TextBlock Text="{Binding SystemDecisionIssues}" FontSize="10.5" Margin="0,4,0,0"
                                               TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"/>
                                    <!-- ★把 b 带进生产：固定相机+杆端域专有。这个开关原先【整个平台没有任何界面】——
                                         校验台验到吸嘴压中了，也没地方能让生产端走上 H(u)+b，
                                         于是「H 标好了、b 也测出来了，生产端却永远少一个 |b|」。
                                         用 DataTrigger 控可见性（不依赖 BoolToVisibilityConverter 的资源作用域）。 -->
                                    <StackPanel Margin="0,6,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRodOffsetCase}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <CheckBox Content="把 b 带进生产（生产端 吸点 = H(u) ± b）" FontSize="11"
                                                  IsChecked="{Binding RodOffsetInProduction}" IsThreeState="True"
                                                  ToolTip="勾=发布后生产端补 b（与校验台同口径）；不勾=生产端只走 H(u)，会少一个 |b|。符号由工位配置 RodOffsetSign 决定——先用下面高级区的口径④⑤判死再勾。"/>
                                        <TextBlock Text="{Binding RodOffsetInfoText}" FontSize="10.5" Margin="20,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="换算结果" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextDisabledBrush}"/>
                                    <TextBlock Text="{Binding PickInfoText}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <!-- ★高级·反面对照：只影响本窗口显示，不写配置、不改变生产口径。
                                         用法：口径④⑤各点同一个像素，只有一个是「吸嘴正好落在点上」，
                                         另一个会落在 2|b| 之外——符号一次判死，不必靠推演。 -->
                                    <Expander Header="⚙ 高级·反面对照（只影响本窗口显示，不改变生产口径）"
                                              FontSize="11" Margin="0,8,0,0" IsExpanded="False">
                                        <StackPanel Margin="0,6,0,0">
                                            <DockPanel LastChildFill="False">
                                                <TextBlock DockPanel.Dock="Left" Text="强制口径:" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                                                <ComboBox DockPanel.Dock="Right" Width="200" FontSize="11"
                                                          ItemsSource="{Binding SolveModeOptions}"
                                                          SelectedItem="{Binding SelectedSolveMode}"
                                                          DisplayMemberPath="Text"
                                                          ToolTip="强行换一个口径算同一个像素，用落差判分型。默认「跟随档案声明」= 系统判定。"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding SolveModeHint}" FontSize="10.5" Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       ToolTip="档案自己声明的域与同轴性（口径=跟随档案时按它判）"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Button Grid.Row="4" Content="🎯 低速到位（到达建议坐标，到位后目视判定）"
                                    Style="{StaticResource SuccessButtonStyle}" Height="34" Margin="0,8,0,0"
                                    Command="{Binding MoveToTargetCommand}"/>

                            <!-- 轴操作 + 真空（2026-09-10 从机械臂调试台 RobotDebugView 搬入：遥控器式四轴步进 + 真空吸住） -->
                            <Expander Grid.Row="5" Margin="0,8,0,0" Header="🎮 轴操作 + 真空" FontSize="12" IsExpanded="False">
                                <StackPanel Margin="0,6,0,0">
                                    <!-- 步长选择 -->
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="步长 (mm/°):" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ComboBox DockPanel.Dock="Right" Width="64" FontSize="11"
                                                  ItemsSource="{Binding StepSizeOptions}"
                                                  SelectedItem="{Binding SelectedStepSize}"
                                                  VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- 遥控器式键位：左 3×3 十字方向键（X/Y 平面）＋右 Z/U 键组 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="36"/>
                                                <RowDefinition Height="36"/>
                                                <RowDefinition Height="36"/>
                                            </Grid.RowDefinitions>

                                            <RepeatButton Grid.Row="0" Grid.Column="1" Content="▲ Y+"
                                                          Command="{Binding StepMoveCommand}" CommandParameter="Y+"
                                                          Background="#27AE60" Style="{StaticResource StepRepeatBtnStyleSmall}"/>
                                            <RepeatButton Grid.Row="1" Grid.Column="0" Content="◀ X−"
                                                          Command="{Binding StepMoveCommand}" CommandParameter="X-"
                                                          Background="#3498DB" Style="{StaticResource StepRepeatBtnStyleSmall}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="X/Y"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
                                            <RepeatButton Grid.Row="1" Grid.Column="2" Content="X+ ▶"
                                                          Command="{Binding StepMoveCommand}" CommandParameter="X+"
                                                          Background="#3498DB" Style="{StaticResource StepRepeatBtnStyleSmall}"/>
                                            <RepeatButton Grid.Row="2" Grid.Column="1" Content="▼ Y−"
                                                          Command="{Binding StepMoveCommand}" CommandParameter="Y-"
                                                          Background="#27AE60" Style="{StaticResource StepRepeatBtnStyleSmall}"/>
                                        </Grid>

                                        <Border Width="1" Background="{DynamicResource BorderBrush}" Height="70" Margin="12,2"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58"/>
                                                <ColumnDefinition Width="58"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="36"/>
                                                <RowDefinition Height="36"/>
                                            </Grid.RowDefinitions>

                                            <RepeatButton Grid.Row="0" Grid.Column="0" Content="▲ Z+"
                                                          Command="{Binding StepMoveCommand}" CommandParameter="Z+"
                                                          Background="#E67E22" Style="{StaticResource StepRepeatBtnStyleSmall}"/>
                                            <RepeatButton Grid.Row="1" Grid.Column="0" Content="▼ Z−"
                                                          Command="{Binding StepMoveCommand}" CommandParameter="Z-"
                                                          Background="#E67E22" Style="{StaticResource StepRepeatBtnStyleSmall}"/>
                                            <RepeatButton Grid.Row="0" Grid.Column="1" Content="U+"
                                                          Command="{Binding StepMoveCommand}" CommandParameter="U+"
                                                          Background="#8E44AD" Style="{StaticResource StepRepeatBtnStyleSmall}"/>
                                            <RepeatButton Grid.Row="1" Grid.Column="1" Content="U−"
                                                          Command="{Binding StepMoveCommand}" CommandParameter="U-"
                                                          Background="#8E44AD" Style="{StaticResource StepRepeatBtnStyleSmall}"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Text="{Binding LastStepText}" FontSize="10.5" Margin="2,4,0,0"
                                               Foreground="{DynamicResource TextDisabledBrush}" TextTrimming="CharacterEllipsis"/>

                                    <!-- 真空吸住/放开 -->
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding VacuumStateText}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="🔽 吸住" Style="{StaticResource SuccessButtonStyle}" Padding="10,4"
                                                    Command="{Binding VacuumOnCommand}" Margin="0,0,6,0"/>
                                            <Button Content="🔼 放开" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4"
                                                    Command="{Binding VacuumOffCommand}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <WrapPanel Grid.Row="6" Margin="0,8,0,0">
                                <Button Content="✅ 通过（对准）" Style="{StaticResource SuccessButtonStyle}" Padding="10,5"
                                        Command="{Binding VerdictPassCommand}" Margin="0,0,6,0"/>
                                <Button Content="❌ 偏差" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5"
                                        Command="{Binding VerdictFailCommand}"/>
                                <TextBox Width="58" Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="偏差偏移量(mm，可选)" VerticalContentAlignment="Center"
                                         FontSize="11.5"/>
                                <TextBlock Text="mm" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"
                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                            </WrapPanel>
                            <TextBox Grid.Row="7" Margin="0,6,0,0" Height="22" FontSize="11"
                                     Text="{Binding VerdictNote, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="判定备注(可选)"/>

                            <DataGrid Grid.Row="9" AutoGenerateColumns="False" Style="{StaticResource ModernDataGridStyle}"
                                      ItemsSource="{Binding VerificationPoints}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="30"/>
                                    <DataGridTextColumn Header="像素" Binding="{Binding PixelX, StringFormat={}{0:F0}}" Width="46"/>
                                    <DataGridTextColumn Header="Wx" Binding="{Binding WorldX, StringFormat={}{0:F1}}" Width="*"/>
                                    <DataGridTextColumn Header="Wy" Binding="{Binding WorldY, StringFormat={}{0:F1}}" Width="*"/>
                                    <DataGridTextColumn Header="判定" Binding="{Binding StatusText}" Width="*"/>
                                    <DataGridTextColumn Header="偏移mm" Binding="{Binding OffsetMm, StringFormat={}{0:F2}}" Width="54"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="10" Margin="0,8,0,0" Padding="10,7" CornerRadius="4" Background="#0A107C41">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="💾 完成并保存校验记录"
                                            Style="{StaticResource SuccessButtonStyle}" Padding="12,6"
                                            Click="SaveAndClose_Click"/>
                                    <TextBlock Text="{Binding SummaryText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#FF107C41" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                        </Grid>
            </Border>
        </Grid>

        <!-- 日志 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="会话日志" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource TextDisabledBrush}"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding LogLines}" MaxHeight="74">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</Window>
