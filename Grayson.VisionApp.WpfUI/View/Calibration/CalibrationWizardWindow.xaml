<Window x:Class="Grayson.Vision.WpfUI.View.CalibrationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:halcon="clr-namespace:Grayson.Vision.HalconWrapper.Wpf.Controls;assembly=Grayson.Vision.HalconWrapper.Wpf"
        xmlns:selectors="clr-namespace:Grayson.VisionApp.WpfUI.Selectors"
        xmlns:conv="clr-namespace:Grayson.Vision.WpfUI.Common.Converters"
        Title="通用视觉标定向导" Height="720" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Templates/NinePointStepViews.xaml"/>
				<ResourceDictionary Source="Templates/HandEyeWithRotationStepViews.xaml"/>
				<ResourceDictionary Source="Templates/CheckerboardStepViews.xaml"/>
				<ResourceDictionary Source="Templates/PixelScaleStepViews.xaml"/>
			</ResourceDictionary.MergedDictionaries>

			<BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>

           

			<selectors:Step3DataTemplateSelector x:Key="Step3Selector"
				NinePointTemplate="{StaticResource NinePointStep3Template}"
				HandEyeWithRotationTemplate="{StaticResource HandEyeWithRotationStep3Template}"
				CheckerboardTemplate="{StaticResource CheckerboardStep3Template}"
				PixelScaleTemplate="{StaticResource PixelScaleStep3Template}"/>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="16"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="16"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- 1. Step 顶部进度条导航 -->
		<Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="16,12" CornerRadius="6">
			<UniformGrid Columns="4">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Border Width="24" Height="24" CornerRadius="12" Background="{Binding Step0Background}">
						<TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<TextBlock Text=" 1. 硬件绑定" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Border Width="24" Height="24" CornerRadius="12" Background="{Binding Step1Background}">
						<TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<TextBlock Text=" 2. 特征配置" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Border Width="24" Height="24" CornerRadius="12" Background="{Binding Step2Background}">
						<TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<TextBlock Text=" 3. 数据采集" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
				</StackPanel>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<Border Width="24" Height="24" CornerRadius="12" Background="{Binding Step3Background}">
						<TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					</Border>
					<TextBlock Text=" 4. 计算与发布" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
				</StackPanel>
			</UniformGrid>
		</Border>

		<!-- 2. 主内容区：TabControl 切换 4 个 Step -->
		<TabControl x:Name="MainTabs" Grid.Row="2" SelectedIndex="{Binding CurrentStep}" BorderThickness="0" Background="Transparent"
					SelectionChanged="MainTabs_SelectionChanged">
			<TabControl.ItemContainerStyle>
				<Style TargetType="TabItem">
					<Setter Property="Visibility" Value="Collapsed"/>
				</Style>
			</TabControl.ItemContainerStyle>

            <!-- Step 0: 硬件与物理场景绑定 -->
            <TabItem>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="650" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="步骤 1：物理场景与硬件绑定" FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="关联相机设备:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding CameraDeviceList}"
                                          SelectedItem="{Binding SelectedCameraDevice}">
                                    <!-- 下拉列表每一项 -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DeviceKey}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="关联运动控制器:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                                          ItemsSource="{Binding MotionDeviceList}"
                                                          SelectedItem="{Binding SelectedMotionDevice}">
                                    <!-- 下拉列表每一项 -->
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DeviceKey}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>

                                </ComboBox>
                            </Grid>

                            <Border Margin="0,10,0,4" Padding="12,10" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4">
                                <StackPanel>
                                    <TextBlock Text="当前绑定摘要" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding HardwareBindingSummary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding StepGuideTip}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Separator Margin="0,12" Background="{DynamicResource BorderBrush}"/>

                            <!-- 物理场景配置 (核心优化) -->
                            <TextBlock Text="物理场景设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{DynamicResource PrimaryBrush}"/>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="相机安装方式:" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <RadioButton Content="眼在手外 (Eye-to-Hand 相机固定)" 
                                     IsChecked="{Binding TargetProfile.EyeMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EyeToHand}" 
                                     Margin="0,0,16,0" VerticalAlignment="Center"/>
                                    <RadioButton Content="眼在手上 (Eye-in-Hand 相机随动)" 
                                     IsChecked="{Binding TargetProfile.EyeMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=EyeInHand}" 
                                     VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="末端夹具/吸嘴:" VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1" Content="轴末端带旋转工具 (开启 TCP 旋转中心拟合)" 
                              IsChecked="{Binding TargetProfile.HasToolOffset}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="绑定前置畸变标定:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" 
          ItemsSource="{Binding AvailableDistortionProfiles}" 
          SelectedValue="{Binding TargetProfile.BoundDistortionProfileId}"
          SelectedValuePath="Id">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <!-- 替换原 Step 0 中的网格步长及下方配置 -->

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标定 X 轴选择:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
              ItemsSource="{Binding AvailableAxes}"
              SelectedValue="{Binding TargetProfile.BindXAxisIndex}"
              SelectedValuePath="AxisIndex"
              >
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标定 Y 轴选择:" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
              ItemsSource="{Binding AvailableAxes}"
              SelectedValue="{Binding TargetProfile.BindYAxisIndex}"
              SelectedValuePath="AxisIndex"
              >
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="标定中心基准点:" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="X: " VerticalAlignment="Center"/>
                                        <TextBox Width="65" Text="{Binding TargetProfile.BasePosX, StringFormat={}{0:F3}}" Margin="2,0,8,0"/>
                                        <TextBlock Text="Y: " VerticalAlignment="Center"/>
                                        <TextBox Width="65" Text="{Binding TargetProfile.BasePosY, StringFormat={}{0:F3}}" Margin="2,0,8,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="🎯 设当前轴位置为基准" 
                Style="{StaticResource SecondaryButtonStyle}" 
                Height="28" Padding="8,2"
                Command="{Binding SetCurrentAsBasePosCommand}"/>
                                </Grid>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="走位网格步长(mm):" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="X步长: " VerticalAlignment="Center"/>
                                    <TextBox Width="65" Text="{Binding GridStepX}" Margin="4,0,12,0"/>
                                    <TextBlock Text="Y步长: " VerticalAlignment="Center"/>
                                    <TextBox Width="65" Text="{Binding GridStepY}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <!-- Step 1: 算法特征配置 -->
			<TabItem>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="3*"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="2*"/>
					</Grid.ColumnDefinitions>

					<Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="4">
						<halcon:HalconImageDisplayHost x:Name="HalconDisplayStep1" DataContext="{Binding CalibrationImageDisplay}" Loaded="HalconDisplayStep1_Loaded"/>
					</Border>

					<Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="16">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
						<StackPanel>
							<TextBlock Text="步骤 2：标定特征与提取算子配置" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
							<TextBlock Text="{Binding StepGuideTip}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

							<RadioButton Content="圆形 Mark 点 (提取圆心)" 
                                         IsChecked="{Binding TargetProfile.FeatureType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CircleMark}" 
                                         Margin="0,6,0,6"/>
							<RadioButton Content="十字 Mark 点 (形状匹配)" 
                                         IsChecked="{Binding TargetProfile.FeatureType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CrossMark}" 
                                         Margin="0,0,0,12"/>

							<!-- 特征提取参数实时调节面板：滑块绑定 ExtractOptions（INotifyPropertyChanged），
								 调节后触发 ReapplyFeatureExtraction，VM 内 300ms 防抖自动重试，所见即所得。 -->
							<Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,4,0,0">
								<StackPanel>
									<DockPanel Margin="0,0,0,4">
										<TextBlock Text="特征提取参数" FontWeight="SemiBold" FontSize="13" DockPanel.Dock="Left"/>
										<Button Content="↻ 立即重试" Style="{StaticResource SecondaryButtonStyle}" Height="22" Padding="8,0" Margin="0,0,0,0" Click="RetryExtract_Click" DockPanel.Dock="Right"/>
										<TextBlock Text="拖动滑杆 300ms 后自动重试" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,6,0"/>
									</DockPanel>

									<!-- 圆形 Mark 参数组（FeatureType == CircleMark 时显示） -->
									<StackPanel>
										<StackPanel.Style>
											<Style TargetType="StackPanel">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding TargetProfile.FeatureType}" Value="CircleMark">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</StackPanel.Style>

										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="阈值下限" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCircleThresholdMin" Minimum="0" Maximum="254" Height="24" Value="{Binding ExtractOptions.ThresholdMin}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCircleThresholdMin, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="阈值上限" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCircleThresholdMax" Minimum="1" Maximum="255" Height="24" Value="{Binding ExtractOptions.ThresholdMax}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCircleThresholdMax, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="最小圆度" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCircleCircularity" Minimum="0.1" Maximum="1.0" Height="24" Value="{Binding ExtractOptions.MinCircularity}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCircleCircularity, StringFormat={}{0:F2}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="最小面积" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCircleMinArea" Minimum="1" Maximum="5000" Height="24" Value="{Binding ExtractOptions.MinArea}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCircleMinArea, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="最大面积" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCircleMaxArea" Minimum="100" Maximum="2000000" Height="24" Value="{Binding ExtractOptions.MaxArea}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCircleMaxArea, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="搜索半径" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCircleSearchRadius" Minimum="10" Maximum="800" Height="24" Value="{Binding ExtractOptions.SearchRadius}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCircleSearchRadius, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="亚像素阈值" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCircleSubPix" Minimum="1" Maximum="255" Height="24" Value="{Binding ExtractOptions.SubPixThreshold}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCircleSubPix, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
									</StackPanel>

									<!-- 十字 Mark 参数组（FeatureType == CrossMark 时显示） -->
									<StackPanel>
										<StackPanel.Style>
											<Style TargetType="StackPanel">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding TargetProfile.FeatureType}" Value="CrossMark">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</StackPanel.Style>

										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="暗色阈值上限" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossDarkMax" Minimum="1" Maximum="254" Height="24" Value="{Binding ExtractOptions.CrossDarkThresholdMax}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossDarkMax, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="亮色阈值下限" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossLightMin" Minimum="1" Maximum="254" Height="24" Value="{Binding ExtractOptions.CrossLightThresholdMin}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossLightMin, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="最小面积" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossMinArea" Minimum="1" Maximum="5000" Height="24" Value="{Binding ExtractOptions.CrossMinArea}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossMinArea, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="最大面积" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossMaxArea" Minimum="100" Maximum="100000000" Height="24" Value="{Binding ExtractOptions.CrossMaxArea}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossMaxArea, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="最小宽/高" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossMinSize" Minimum="1" Maximum="100" Height="24" Value="{Binding ExtractOptions.CrossMinSize}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossMinSize, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="最大宽/高" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossMaxSize" Minimum="50" Maximum="5000" Height="24" Value="{Binding ExtractOptions.CrossMaxSize}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossMaxSize, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
									</StackPanel>
								</StackPanel>
							</Border>

							<Button Content="📷 抓图并提取特征" Style="{StaticResource PrimaryButtonStyle}"
                                    Height="36" Command="{Binding TriggerSampleCommand}" Margin="0,10,0,0"/>

							<TextBlock Text="{Binding LogText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/>
						</StackPanel>
						</ScrollViewer>
					</Border>
				</Grid>
			</TabItem>

			<!-- Step 2: 动态匹配专属采集界面 -->
			<TabItem>
				<ContentControl Content="{Binding TargetProfile}" ContentTemplateSelector="{StaticResource Step3Selector}" />
			</TabItem>

			<!-- Step 3: 标定计算与报告发布 -->
			<TabItem>
				<Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="20">
					<StackPanel MaxWidth="650" HorizontalAlignment="Center" VerticalAlignment="Center">
						<TextBlock Text="步骤 4：标定结果拟合计算与报告" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

						<Button Content="🧮 立即执行标定拟合计算" Style="{StaticResource PrimaryButtonStyle}" Height="40"
                                Command="{Binding RunCalibrationCommand}" Margin="0,0,0,20"/>

						<Border Background="{DynamicResource CardBackgroundBrush}" Padding="16" CornerRadius="6">
							<StackPanel>
								<TextBlock Text="计算评估指标：" FontWeight="Bold" Margin="0,0,0,8"/>
                                <!-- 1. 重投影 RMS 误差 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="重投影均方根误差 (RMS Error):" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CalculatedRms, StringFormat={}{0:F5} mm}" 
               FontWeight="Bold" Foreground="#FF0078D4" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 2. 矩阵文件路径 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="矩阵文件暂存路径:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OutputHomMatPath}" 
               HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" 
               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
						</Border>
					</StackPanel>
				</Border>
			</TabItem>
		</TabControl>

		<!-- 3. 底部导航栏 -->
		<Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" Padding="12,8" CornerRadius="6">
			<Grid>
				<Button Content="上一步" Style="{StaticResource SecondaryButtonStyle}" Width="100" HorizontalAlignment="Left" Command="{Binding PrevStepCommand}"/>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button Content="取消" Style="{StaticResource DangerButtonStyle}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>

					<Button Content="下一步 ➔" Style="{StaticResource PrimaryButtonStyle}" Width="120"
                            Command="{Binding NextStepCommand}"
                            Visibility="{Binding IsNotLastStep, Converter={StaticResource BoolToVis}}"/>

					<Button Content="✔ 完成并保存" Style="{StaticResource SuccessButtonStyle}" Width="120"
                            Command="{Binding SaveResultCommand}"
                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}"/>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>