									<!-- 十字 Mark 参数组（FeatureType == CrossMark 时显示） -->
									<StackPanel>
										<StackPanel.Style>
											<Style TargetType="StackPanel">
												<Setter Property="Visibility" Value="Collapsed"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding TargetProfile.FeatureType}" Value="CrossMark">
														<Setter Property="Visibility" Value="Visible"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</StackPanel.Style>

										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="暗色阈值上限" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossDarkMax" Minimum="1" Maximum="254" Height="24" Value="{Binding ExtractOptions.CrossDarkThresholdMax}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossDarkMax, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="亮色阈值下限" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossLightMin" Minimum="1" Maximum="254" Height="24" Value="{Binding ExtractOptions.CrossLightThresholdMin}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossLightMin, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="最小面积" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossMinArea" Minimum="1" Maximum="5000" Height="24" Value="{Binding ExtractOptions.CrossMinArea}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossMinArea, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="最大面积" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossMaxArea" Minimum="100" Maximum="100000000" Height="24" Value="{Binding ExtractOptions.CrossMaxArea}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossMaxArea, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="最小宽/高" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossMinSize" Minimum="1" Maximum="100" Height="24" Value="{Binding ExtractOptions.CrossMinSize}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossMinSize, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
										<Grid Margin="0,2">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="96"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="52"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="最大宽/高" FontSize="12" VerticalAlignment="Center"/>
											<Slider Grid.Column="1" x:Name="slCrossMaxSize" Minimum="50" Maximum="5000" Height="24" Value="{Binding ExtractOptions.CrossMaxSize}" ValueChanged="FeatureSlider_ValueChanged" VerticalAlignment="Center"/>
											<TextBlock Grid.Column="2" Text="{Binding Value, ElementName=slCrossMaxSize, StringFormat={}{0:F0}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
										</Grid>
									</StackPanel>
								</StackPanel>
							</Border>

							<Button Content="📷 抓图并提取特征" Style="{StaticResource PrimaryButtonStyle}"
                                    Height="36" Command="{Binding TriggerSampleCommand}" Margin="0,10,0,0"/>

							<TextBlock Text="{Binding LogText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/>
						</StackPanel>
						</ScrollViewer>
					</Border>
				</Grid>
			</TabItem>

			<!-- Step 2: 动态匹配专属采集界面 -->
			<TabItem>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<StackPanel Grid.Row="0" Margin="0,0,0,6" Visibility="{Binding ShowSamplingProgressStrip, Converter={StaticResource BoolToVis}}">
						<Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="采样进度: " VerticalAlignment="Center" FontWeight="SemiBold"/>
							<TextBlock Text="{Binding SamplingProgressText}" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{StaticResource PrimaryBrush}"/>
							<ItemsControl ItemsSource="{Binding NineCells}" VerticalAlignment="Center">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><UniformGrid Columns="9" Rows="1"/></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Width="22" Height="22" Margin="2,0" CornerRadius="4" Background="{Binding StatusBrush}" ToolTip="{Binding Index, StringFormat='点 {0}：绿=已采 红=缺失 橙=不可靠 灰=未采'}">
											<TextBlock Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="White"/>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock Text="{Binding RotationFitSummaryText}" VerticalAlignment="Center" Margin="16,0,0,0"
									   Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RotationFitSummaryText}" Visibility="{Binding HasRotationStage, Converter={StaticResource BoolToVis}}"/>
						</StackPanel>
					</Border>
						<Border Visibility="{Binding ShowPreSamplingVerifyWarning, Converter={StaticResource BoolToVis}}" Background="#FBF3DC" BorderBrush="#D9A12E" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,6,0,0">
							<TextBlock Text="⚠ 尚未在『步骤2 特征配置』成功识别过特征（识别质量分仍为“尚未提取”）。若直接自动采样，轴走位后大概率大量漏点。建议先返回步骤2 点【📷 抓图并提取特征】确认分数 ≥70 再回来采集；确认特征可识别后仍可直接开始（本提示不阻断）。" TextWrapping="Wrap" FontSize="12" Foreground="#5B4300"/>
						</Border>
					</StackPanel>
					<!-- Step3 内容：H/e/s 会话 = 类型模板(九点/旋转/棋盘/像素当量)；
					     t 会话 = 对针专用视图（EyeInHand 间接对针：抬Z抓拍→点选→结算 TCO）。
					     互斥显隐：隐藏的 ContentControl 不被测量 → DataTemplate 不实例化，
					     避免出现两套 HalconImageDisplayHost 干扰显示上下文扫描（RefreshDisplayContextAdapter）。 -->
					<ContentControl Grid.Row="1" Content="{Binding TargetProfile}" ContentTemplateSelector="{StaticResource Step3Selector}"
                                    Visibility="{Binding ShowTypeSamplingContent, Converter={StaticResource BoolToVis}}"/>

					<Grid Grid.Row="1" Visibility="{Binding ShowToolOffsetAlignView, Converter={StaticResource BoolToVis}}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="3*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="2*"/>
						</Grid.ColumnDefinitions>

						<!-- 左：间接对针特征成像（抬Z后拍到的同一特征，单击点选） -->
						<Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="4">
							<Grid>
								<halcon:HalconImageDisplayHost x:Name="HalconDisplayAlign" ShowToolbar="False"
                                    DataContext="{Binding DataContext.CalibrationImageDisplay, RelativeSource={RelativeSource AncestorType=Window}}"/>
								<Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Background="#99000000" Padding="10,6" CornerRadius="4">
									<StackPanel>
										<TextBlock Foreground="White" FontWeight="Bold" FontSize="12" Text="间接对针 · 特征成像"/>
										<TextBlock Foreground="#FF00FF66" FontSize="11" Margin="0,2,0,0" Text="单击画面中的特征 → 黄十字 = 对准像素 p_tip"/>
									</StackPanel>
								</Border>
								<!-- 点选覆盖层：只收点击不绘制（视口覆盖层命中铁律），转成图像坐标交给 VM 记 p_tip -->
								<Border Background="Transparent" PreviewMouseLeftButtonDown="AlignHost_PreviewMouseLeftButtonDown" Cursor="Cross">
									<TextBlock Text="📌 点选模式：单击【工具头尖刚才压住的那个特征】"
											   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
											   Foreground="#88000000" FontSize="11" Background="#22000000" Padding="10,3"/>
								</Border>
							</Grid>
						</Border>

						<!-- 右：结算链状态与动作 -->
						<Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="12">
							<StackPanel>
								<TextBlock Text="🔍 间接对针结算链" FontWeight="Bold" FontSize="14"/>
								<TextBlock Text="{Binding ToolOffsetAlignStepGuideText}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>

								<Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
									<StackPanel>
										<TextBlock Text="1️⃣ 基准位 R_n" FontWeight="SemiBold" FontSize="12"/>
										<TextBlock Text="{Binding ToolOffsetAlignRnLine}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
									</StackPanel>
								</Border>

	<CheckBox Content="🚫 相机不随 Z 升降（固定相机工位：任意 Z 都能吸取/点选/结算）"
			  IsChecked="{Binding CameraMountFixed, Mode=TwoWay}"
			  Margin="0,6,0,0" FontSize="11"/>
	<TextBlock Text="{Binding CameraMountInfoText}" TextWrapping="Wrap" FontSize="10.5"
			   Foreground="{DynamicResource TextSecondaryBrush}"/>

	<Button Content="{Binding ToolOffsetAlignCaptureButtonText}" Command="{Binding AlignEihCaptureCommand}"
			Style="{StaticResource SecondaryButtonStyle}" Height="30" Margin="0,10,0,0"/>
	<TextBlock Text="{Binding ToolOffsetAlignCaptureHintText}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,3,0,0"/>

								<Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
									<StackPanel>
										<TextBlock Text="2️⃣ 对准像素 p_tip（点选结果）" FontWeight="SemiBold" FontSize="12"/>
										<TextBlock Text="{Binding ToolOffsetAlignPickText}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
									</StackPanel>
								</Border>

								<Button Content="🔍 结算 TCO 并写入档案" Command="{Binding SettleToolOffsetEihCommand}"
                                        Style="{StaticResource SuccessButtonStyle}" Height="32" Margin="0,10,0,0"/>
								<TextBlock Text="结算写 TCO(ToolOffsetWx/Wy·EyeInHandIndirect) + p_tip(ToolAlignPixelX/Y) + R_n(NozzleAlignX/Y) 三元组；保存后本步与『计算』步门禁放行。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" Margin="0,3,0,0"/>

								<Border Background="#E8F4E8" CornerRadius="4" Padding="10,8" Margin="0,10,0,0"
                                        Visibility="{Binding TargetProfile.IsToolOffsetCalibrated, Converter={StaticResource BoolToVis}}">
									<TextBlock Text="{Binding ToolOffsetSettledStatusText}" TextWrapping="Wrap" FontSize="11.5" Foreground="#1B5E20"/>
								</Border>
							</StackPanel>
						</Border>
					</Grid>
				</Grid>
			</TabItem>

			<!-- Step 3: 标定计算与报告发布 -->
			<TabItem>
				<Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="20">
					<StackPanel MaxWidth="650" HorizontalAlignment="Center" VerticalAlignment="Center">
						<StackPanel Visibility="{Binding ShowComputeSection, Converter={StaticResource BoolToVis}}">
						<TextBlock Text="{Binding ComputeSectionHeader}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

						<Button Content="🧮 立即执行标定拟合计算" Style="{StaticResource PrimaryButtonStyle}" Height="40"
                                Command="{Binding RunCalibrationCommand}" Margin="0,0,0,20"/>

						<Border Background="{DynamicResource CardBackgroundBrush}" Padding="16" CornerRadius="6">
							<StackPanel>
								<!-- 2026-09-06 H 平移评估区（RMS/逐点残差）：仅 H 平移类会话显示；e 旋转会话只保留下方旋转拟合/残差 -->
								<StackPanel Visibility="{Binding ShowHResidualSection, Converter={StaticResource BoolToVis}}">
								<TextBlock Text="计算评估指标：" FontWeight="Bold" Margin="0,0,0,8"/>
                                <!-- 1. 重投影 RMS 误差 -->
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="重投影均方根误差 (RMS Error):" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CalculatedRms, StringFormat={}{0:F5} mm}" 
               FontWeight="Bold" Foreground="#FF0078D4" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 逐点残差可视化（拟合后）：点号/像素/偏差mm，>0.5mm 标红 -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="逐点残差（反向校验：像素→世界 vs 实际放置点）：" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding ResidualSummaryText}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding ResidualRows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,6" Background="{DynamicResource SurfaceBrush}" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                                    <Setter Property="Background" Value="#FCEBEB"/>
                                                                    <Setter Property="BorderBrush" Value="#E24B4A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11">
                                                        <Run Text="{Binding Index, Mode=OneWay, StringFormat=#{0}}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding Pixel, Mode=OneWay}"/>
                                                        <Run Text="  偏差 "/>
                                                        <Run Text="{Binding ResidualText, Mode=OneWay}"/>
                                                        <Run Text=" mm"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
								</StackPanel><!-- /H 平移评估区 -->

                                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasRotationStage, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="旋转中心 / 偏心拟合图（蓝=角度采样点 · 红=圆心 · 橙=偏心端 θ=0）：" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding RotationCenterResult}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,2"/>
                                    <TextBlock Text="{Binding RotationCenterWorldResult}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <ItemsControl ItemsSource="{Binding RotationPlotDots}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas Width="230" Height="150" Background="{DynamicResource BackgroundBrush}"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Canvas.Left="{Binding X}" Canvas.Top="{Binding Y}" Width="{Binding Size}" Height="{Binding Size}" CornerRadius="10"
                                                        Background="{Binding Brush}" BorderBrush="White" BorderThickness="0.8" ToolTip="{Binding Label}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding RotationPlotLegend}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- P3 e 会话：旋转采样残差明细（逐角度径向偏差 vs 圆拟合；拟合后出现，>0.5px 标红） -->
                                <StackPanel Margin="0,12,0,0"
                                            Visibility="{Binding HasRotationResidual, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="旋转采样残差明细（逐角度径向偏差 vs 圆拟合，>0.5px 标红）：" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding RotationResidualSummaryText}" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding RotationResidualRows}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" Margin="0,0,6,6" Background="{DynamicResource SurfaceBrush}" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsWarn}" Value="True">
                                                                    <Setter Property="Background" Value="#FCEBEB"/>
                                                                    <Setter Property="BorderBrush" Value="#E24B4A"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="11">
                                                        <Run Text="{Binding Index, StringFormat=#{0}}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding AngleText}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding RadiusText}"/>
                                                        <Run Text="  偏差 "/>
                                                        <Run Text="{Binding ResidualText}"/>
                                                        <Run Text=" px"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 2. 矩阵文件路径（H 平移矩阵专属；e 旋转/对针/像素当量会话无矩阵文件） -->
                                <Grid Margin="0,4"
                                      Visibility="{Binding ShowHResidualSection, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="矩阵文件暂存路径:" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OutputHomMatPath}" 
               HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" 
               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
						</Border>
						</StackPanel>

						<!-- ===== v2 发布验收独立步（体检+保存发布） ===== -->
						<StackPanel Visibility="{Binding ShowVerifySection, Converter={StaticResource BoolToVis}}">
						<TextBlock Text="{Binding VerifySectionHeader}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"
								   Visibility="{Binding IsSessionV2, Converter={StaticResource BoolToVis}}"/>
						<Border Background="{DynamicResource CardBackgroundBrush}" Padding="16" CornerRadius="6" Margin="0,12,0,0">
							<StackPanel>
							<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
								<TextBlock FontWeight="Bold" VerticalAlignment="Center">
									<Run Text="🧾 发布前体检"/><Run Text="（绿=通过 · 黄=提醒可确认后保存 · 红=阻断保存）" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
								</TextBlock>
								<CheckBox Content="放宽门禁(诊断模式)" IsChecked="{Binding RelaxShapeGate, Mode=TwoWay}" Margin="14,0,0,0" VerticalAlignment="Center"
								          ToolTip="开启后：RMS 严重超差、矩阵形状非法(σ1/σ2≠1)、固定相机负行列式(镜像)、体检未执行 四项红阻降级为黄色提醒（仍弹确认框）——用于相机安装几何/轴方向约定问题尚未现场处理时的临时放行；相机调平或方向确认后应取消勾选恢复严格门禁。注意：『矩阵尚未生成』永远保持红阻，勾选无效。"/>
							</StackPanel>
								<ItemsControl ItemsSource="{Binding PublishChecks}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Border CornerRadius="4" Padding="8,4" Margin="0,0,0,4" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
												<Border.Style>
													<Style TargetType="Border">
														<Style.Triggers>
															<DataTrigger Binding="{Binding Level}" Value="0"><Setter Property="BorderBrush" Value="#3F9D4F"/></DataTrigger>
															<DataTrigger Binding="{Binding Level}" Value="1"><Setter Property="BorderBrush" Value="#D9A12E"/></DataTrigger>
															<DataTrigger Binding="{Binding Level}" Value="2"><Setter Property="BorderBrush" Value="#E24B4A"/></DataTrigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
												<StackPanel Orientation="Horizontal">
													<TextBlock FontWeight="Bold" Margin="0,0,6,0" Text="✔">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Style.Triggers>
																	<DataTrigger Binding="{Binding Level}" Value="1"><Setter Property="Text" Value="⚠"/><Setter Property="Foreground" Value="#D9A12E"/></DataTrigger>
																	<DataTrigger Binding="{Binding Level}" Value="2"><Setter Property="Text" Value="✘"/><Setter Property="Foreground" Value="#E24B4A"/></DataTrigger>
																	<DataTrigger Binding="{Binding Level}" Value="0"><Setter Property="Foreground" Value="#3F9D4F"/></DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
													<TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
												</StackPanel>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<TextBlock Text="{Binding PublishSummaryText}" FontWeight="Bold" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="13"/>
							</StackPanel>
						</Border>
						</StackPanel>
					</StackPanel>
				</Border>
			</TabItem>
		</TabControl>

		<!-- 3. 底部导航栏 -->
		<Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}" Padding="12,8" CornerRadius="6">
			<Grid>
				<Button Content="上一步" Style="{StaticResource SecondaryButtonStyle}" Width="100" HorizontalAlignment="Left" Command="{Binding PrevStepCommand}"/>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button Content="⧉ 复制排障日志" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            Command="{Binding CopyTroubleshootCommand}"
                            ToolTip="把 配置快照+最近60行日志 复制到剪贴板，出问题直接粘贴给维护者"/>
					<Button Content="取消" Style="{StaticResource DangerButtonStyle}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>

					<Button Content="下一步 ➔" Style="{StaticResource PrimaryButtonStyle}" Width="120"
                            Command="{Binding NextStepCommand}"
                            Visibility="{Binding IsNotLastStep, Converter={StaticResource BoolToVis}}"/>

					<Button Content="✔ 完成并保存" Style="{StaticResource SuccessButtonStyle}" Width="120"
                            Command="{Binding SaveResultCommand}"
                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVis}}"/>
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>