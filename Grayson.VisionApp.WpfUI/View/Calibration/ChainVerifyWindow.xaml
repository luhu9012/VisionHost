<Window x:Class="Grayson.Vision.WpfUI.View.ChainVerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="链校验台（范式2 · L1 门禁可视 + L2 数学校验）" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="审计对象（Recipes\Workstations\{工位码}\Calib\Chain.json；与生产端同一把尺，只读不改）">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="工位码：" VerticalAlignment="Center"/>
                <TextBox Width="120" x:Name="StationBox" KeyDown="StationBox_KeyDown"/>
                <Button Content="审计" Click="Audit_Click" FontWeight="Bold"/>
                <TextBlock x:Name="VerdictText" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" x:Name="RowGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" IsReadOnly="True" Margin="0,2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="70"/>
                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="90"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="110"/>
                    <DataGridTextColumn Header="像素当量[mm/px]" Binding="{Binding PixelScaleMmPerPx}" Width="110"/>
                    <DataGridTextColumn Header="形状偏差" Binding="{Binding ShapeDev}" Width="90"/>
                    <DataGridTextColumn Header="条件数" Binding="{Binding CondNumber}" Width="80"/>
                    <DataGridTextColumn Header="RMS[mm]" Binding="{Binding RmsMm}" Width="80"/>
                    <DataGridTextColumn Header="点数" Binding="{Binding PointPairs}" Width="50"/>
                    <DataGridTextColumn Header="CalibZ[mm]" Binding="{Binding CalibZMm}" Width="80"/>
                    <DataGridTextColumn Header="DeltaRef" Binding="{Binding DeltaRefText}" Width="130"/>
                    <DataGridTextColumn Header="问题" Binding="{Binding ProblemText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBox Grid.Row="1" x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,2"/>
            <TextBlock Grid.Row="2" x:Name="EdgeText" TextWrapping="Wrap" Foreground="DarkCyan" FontSize="11"/>
        </Grid>

        <GroupBox Grid.Row="2" Header="说明">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="Gray"
                       Text="L1=门禁可视（G0~G4 与生产端同源 fail-closed）；L2=数学校验（形状门复验/条件数/像素当量量级/EIH 平移量级/DeltaRef 自洽提示）。RMS 重算复验（重喂点对）与指哪打哪属 L3 真机页——需重新采集，不在本台。"/>
        </GroupBox>
    </Grid>
</Window>
