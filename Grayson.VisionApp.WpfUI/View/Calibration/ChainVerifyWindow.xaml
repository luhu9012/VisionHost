<Window x:Class="Grayson.Vision.WpfUI.View.ChainVerifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="链校验台（范式2 · L1 门禁可视 + L2 数学校验）" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <!-- ★2026-09-28 主题适配：原先这里的裸隐式样式（无 BasedOn）会顶掉应用级主题，
             使按钮/输入框/表格回落到系统亮色。现一律 BasedOn 主题样式；
             GroupBox 全局无隐式样式，此处补一个基于主题色的模板。 -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{DynamicResource BackgroundLightBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}"
                                           FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource AccentLightBrush}"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="审计对象（与生产端同一把尺，只读不改）">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="工位码：" VerticalAlignment="Center"/>
                    <TextBox Width="120" x:Name="StationBox" KeyDown="StationBox_KeyDown"/>
                    <Button Content="审计" Click="Audit_Click" FontWeight="Bold"/>
                    <TextBlock x:Name="VerdictText" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="PathText" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </GroupBox>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid Grid.Row="0" x:Name="RowGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      HeadersVisibility="Column" IsReadOnly="True" Margin="0,2">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="70"/>
                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="90"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="110"/>
                    <DataGridTextColumn Header="像素当量[mm/px]" Binding="{Binding PixelScaleMmPerPx}" Width="110"/>
                    <DataGridTextColumn Header="形状偏差" Binding="{Binding ShapeDev}" Width="90"/>
                    <DataGridTextColumn Header="条件数" Binding="{Binding CondNumber}" Width="80"/>
                    <DataGridTextColumn Header="RMS[mm]" Binding="{Binding RmsMm}" Width="80"/>
                    <DataGridTextColumn Header="点数" Binding="{Binding PointPairs}" Width="50"/>
                    <DataGridTextColumn Header="CalibZ[mm]" Binding="{Binding CalibZMm}" Width="80"/>
                    <DataGridTextColumn Header="DeltaRef" Binding="{Binding DeltaRefText}" Width="130"/>
                    <DataGridTextColumn Header="问题" Binding="{Binding ProblemText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBox Grid.Row="1" x:Name="DetailBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontSize="11" Margin="0,2"/>
            <TextBlock Grid.Row="2" x:Name="EdgeText" TextWrapping="Wrap" Foreground="{DynamicResource InfoBrush}" FontSize="11"/>
        </Grid>

        <GroupBox Grid.Row="2" Header="说明">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="L1=门禁可视（G0~G4 与生产端同源 fail-closed）；L2=数学校验（形状门复验/条件数/像素当量量级/EIH 平移量级/DeltaRef 自洽提示）。★真机「指哪打哪」已实现为独立的【🎯 真机验证】台（L3）——标定中心主线卡第三个按钮，在那里走「相机看点 → 链求值 → 逆解 → 真机到位 → 复测」闭环并给放行结论；本台保持只读审计，不驱动机器。"/>
        </GroupBox>
    </Grid>
</Window>
