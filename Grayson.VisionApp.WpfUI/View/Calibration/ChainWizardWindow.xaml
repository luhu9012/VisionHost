<Window x:Class="Grayson.Vision.WpfUI.View.ChainWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="940" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- ★主题适配：一律 BasedOn 主题样式，禁止裸隐式样式顶掉应用级主题 -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{DynamicResource BackgroundLightBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}"
                                           FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource AccentLightBrush}"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 小标题 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}"/>
        </Style>
        <!-- 轴操控方向按钮 -->
        <Style x:Key="JogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <!-- ================= 工作台三区布局：左导航 | 中工作区 | 右轴操控 ================= -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：工位头（一行到底，不堆叠） -->
        <Border Grid.Row="0" Background="{DynamicResource BackgroundLightBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding WindowTitle}" FontWeight="Bold"
                           FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource AccentLightBrush}"/>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="左下『坐标系传导链』展开可见拓扑与矩阵式｜点步骤清单任一步 → 中间工作区自动切到位"/>
            </DockPanel>
        </Border>

        <!-- 主体三列 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="330" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- ======== 左区：步骤导航 + 推导说明 + 传导链（可折叠） ======== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="6">
                <StackPanel>
                    <GroupBox Header="步骤清单（点一步 → 中间切到该步）">
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="StepRowBorder" Background="Transparent" CornerRadius="3"
                                            Padding="4,2" Margin="0,1" MouseLeftButtonUp="StepRow_Click"
                                            Cursor="Hand">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StepLabel}" Width="22" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Status}" Width="56" FontWeight="Bold"
                                                           FontSize="11"/>
                                                <TextBlock Text="{Binding Workflow}" TextWrapping="Wrap" Width="180"
                                                           FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="22,1,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="StepRowBorder" Property="Background"
                                                    Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>

                    <GroupBox Header="链骨架推导（工位档案 → 推导器）">
                        <TextBlock Text="{Binding PlanNotes}" TextWrapping="Wrap" FontSize="11"/>
                    </GroupBox>

                    <Expander Header="坐标系传导链（拓扑 + 矩阵式）" IsExpanded="False"
                              Foreground="{DynamicResource AccentLightBrush}" Margin="0,0,0,6">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="① 拓扑" Style="{StaticResource SectionTitle}" FontSize="11"/>
                            <TextBlock Text="{Binding TopologyDiagram}" FontFamily="Consolas" FontSize="10"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="② 标定阶段：逐节点解什么" Style="{StaticResource SectionTitle}"
                                       FontSize="11" Margin="0,6,0,3"/>
                            <TextBlock Text="{Binding CalibMath}" FontFamily="Consolas" FontSize="10"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="③ 生产消费：像素→世界→法兰" Style="{StaticResource SectionTitle}"
                                       FontSize="11" Margin="0,6,0,3"/>
                            <TextBlock Text="{Binding ConsumeMath}" FontFamily="Consolas" FontSize="10"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"/>

            <!-- ======== 中区：相机视图（大）+ 采集工具栏 + 点对表 ======== -->
            <Grid Grid.Column="2" Margin="6,6,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- 当前步骤引导 -->
                <Border Grid.Row="0" Background="{DynamicResource BackgroundLightBrush}"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0"
                        Padding="8,5" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="{Binding StepGuide}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <!-- 工具步提示：中区自动切换为 TCP 采集面板 -->
                        <TextBlock Text="▶ 本步属『工具/TCP』标定——中区已切换为『针尖对点 pivoting』采集面板（转 U 角扎同一针尖→回读回填→求解→写入）。"
                                   TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Visibility="{Binding IsToolStepSelected, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- 相机视图（相机步） / pivoting 采集面板（工具步）——互斥显示 -->
                <Grid Grid.Row="1">
                    <GroupBox Header="相机视图（Tab=链上相机）"
                              Visibility="{Binding IsCameraStepSelected, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <!-- 采集工具栏 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="相机：" VerticalAlignment="Center"/>
                            <ComboBox Width="150" ItemsSource="{Binding CameraDeviceList}"
                                      SelectedItem="{Binding SelectedCameraDevice, Mode=TwoWay}"
                                      DisplayMemberPath="DeviceName"/>
                            <Button Content="刷新" Click="RefreshCameras_Click"/>
                            <Button Content="连接" Click="ConnectCamera_Click"/>
                            <Button Content="单帧取图" Click="SnapFromCamera_Click" FontWeight="Bold"/>
                            <Button Content="载入图像…" Click="LoadImage_Click"/>
                            <TextBlock Text="{Binding CameraConnectedText}" VerticalAlignment="Center"
                                       Margin="8,0,0,0" FontWeight="Bold" Foreground="{DynamicResource InfoBrush}"/>
                        </StackPanel>
                        <!-- 图像（大） -->
                        <TabControl Grid.Row="1" ItemsSource="{Binding Sections}"
                                    SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
                            <TabControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}"/>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding FitResult}" TextWrapping="Wrap"
                                                       FontSize="11" Margin="0,0,0,2"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="左键点选=回填选中行像素" FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="　右键=写入 DeltaRefPixel（下相机必测）"
                                                           FontSize="10" Foreground="{DynamicResource WarningBrush}"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding IsDownCorrect, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding MountHeader}" FontWeight="Bold" FontSize="11"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                Background="#22000000">
                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto">
                                                <Image Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                       Source="{Binding Image}"
                                                       MouseLeftButtonUp="CameraImage_Click"
                                                       MouseRightButtonUp="CameraImage_RightClick"/>
                                            </ScrollViewer>
                                        </Border>
                                    </DockPanel>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </Grid>
                    </GroupBox>

                    <!-- 工具 TCP 采集面板（pivoting，T14）：工具步的中区工作面 -->
                    <GroupBox Header="工具 TCP 标定（针尖对点 Pivoting）——法兰转 U 角扎同一针尖，每角回读一次"
                              Visibility="{Binding IsToolStepSelected, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 工具选择 + 同心 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="工具：" VerticalAlignment="Center"/>
                                <ComboBox Width="140" ItemsSource="{Binding ToolRows}"
                                          SelectedItem="{Binding PivotTool, Mode=TwoWay}"
                                          DisplayMemberPath="ToolId"/>
                                <CheckBox Content="同心（已测，显式落 0,0）" Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding PivotTool.IsConcentric, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding PivotReadyText}" FontWeight="Bold" Margin="10,0,0,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource InfoBrush}"/>
                            </StackPanel>

                            <!-- 对针点表 -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding PivotRows}"
                                      SelectedItem="{Binding SelectedPivotRow, Mode=TwoWay}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                      MaxHeight="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Note}" Width="44" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="U°" Binding="{Binding UDeg}" Width="*"/>
                                    <DataGridTextColumn Header="法兰X" Binding="{Binding FlangeX}" Width="*"/>
                                    <DataGridTextColumn Header="法兰Y" Binding="{Binding FlangeY}" Width="*"/>
                                    <DataGridTextColumn Header="残差mm" Binding="{Binding ResidualText}" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResidualHigh}" Value="True">
                                                <Setter Property="Background" Value="#26D03A3A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>

                            <!-- 操作按钮 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="添加点" Click="AddPivotPoint_Click"/>
                                <Button Content="删除选中" Click="RemovePivotPoint_Click"/>
                                <Button Content="回填对针点(U,X,Y)" Click="FillPivotPose_Click" FontWeight="Bold"/>
                                <Button Content="求解 pivoting" Click="SolvePivoting_Click" FontWeight="Bold"/>
                                <Button Content="写入工具偏移" Click="ApplyPivot_Click"/>
                                <TextBlock Text="　提示：先在右栏『回读位姿』（须读到 U），或示教器手抄后直接改表" FontSize="10"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- 求解结果 -->
                            <TextBlock Grid.Row="3" Text="{Binding PivotResultText}" TextWrapping="Wrap"
                                       FontSize="11" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- 采集参数行（相机步） -->
                <WrapPanel Grid.Row="2" Margin="0,4,0,4"
                           Visibility="{Binding IsCameraStepSelected, Converter={StaticResource BoolToVis}}">
                    <Button Content="添加点" Click="AddPoint_Click"/>
                    <Button Content="删除选中" Click="RemovePoint_Click"/>
                    <Button Content="拟合" Click="FitSection_Click" FontWeight="Bold"/>
                    <TextBlock Text="　标定高度 Z(mm)：" VerticalAlignment="Center"/>
                    <TextBox Width="80" Text="{Binding SelectedSection.CalibZText}"/>
                    <TextBlock Text="　DeltaRef(下相机) Col,Row：" VerticalAlignment="Center"
                               Visibility="{Binding SelectedSection.IsDownCorrect, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Width="70" Text="{Binding SelectedSection.DeltaRefCol}"
                             Visibility="{Binding SelectedSection.IsDownCorrect, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Width="70" Text="{Binding SelectedSection.DeltaRefRow}"
                             Visibility="{Binding SelectedSection.IsDownCorrect, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="　PhotoPose X,Y：" VerticalAlignment="Center"
                               Visibility="{Binding SelectedSection.IsEih, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Width="80" Text="{Binding SelectedSection.PhotoPoseX}"
                             Visibility="{Binding SelectedSection.IsEih, Converter={StaticResource BoolToVis}}"/>
                    <TextBox Width="80" Text="{Binding SelectedSection.PhotoPoseY}"
                             Visibility="{Binding SelectedSection.IsEih, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>

                <!-- 点对表（相机步；残差列=拟合后逐点反馈，标红=离群建议重采） -->
                <GroupBox Grid.Row="3" Header="点对表（选中行 = 图像点选回填目标）"
                          Visibility="{Binding IsCameraStepSelected, Converter={StaticResource BoolToVis}}">
                    <DataGrid ItemsSource="{Binding SelectedSection.Points}"
                              SelectedItem="{Binding SelectedSection.SelectedRow, Mode=TwoWay}"
                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Note}" Width="40" IsReadOnly="True"/>
                            <DataGridTextColumn Header="世界X" Binding="{Binding WorldX}" Width="*"/>
                            <DataGridTextColumn Header="世界Y" Binding="{Binding WorldY}" Width="*"/>
                            <DataGridTextColumn Header="像素Col" Binding="{Binding PixelCol}" Width="*"/>
                            <DataGridTextColumn Header="像素Row" Binding="{Binding PixelRow}" Width="*"/>
                            <DataGridTextColumn Header="拍照X(EIH)" Binding="{Binding PhotoX}" Width="*"/>
                            <DataGridTextColumn Header="拍照Y(EIH)" Binding="{Binding PhotoY}" Width="*"/>
                            <DataGridTextColumn Header="拍照U°(EIH)" Binding="{Binding PhotoU}" Width="*"/>
                            <DataGridTextColumn Header="残差mm" Binding="{Binding ResidualText}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResidualHigh}" Value="True">
                                        <Setter Property="Background" Value="#26D03A3A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"/>

            <!-- ======== 右区：轴操控 + 工具偏移 ======== -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Padding="6,6,0,0">
                <StackPanel>
                    <GroupBox Header="轴操控（走位 → 取图 → 点选）">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="运动设备：" VerticalAlignment="Center"/>
                                <ComboBox Width="120" ItemsSource="{Binding MotionDeviceList}"
                                          SelectedItem="{Binding SelectedMotionDevice, Mode=TwoWay}"
                                          DisplayMemberPath="DeviceName"/>
                                <Button Content="刷新" Click="RefreshMotion_Click"/>
                                <Button Content="连接" Click="ConnectMotion_Click"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MotionConnectedText}" FontWeight="Bold" FontSize="11"
                                       Foreground="{DynamicResource InfoBrush}" Margin="0,0,0,4"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="步长mm：" VerticalAlignment="Center"/>
                                <TextBox Width="60" Text="{Binding JogStep}"/>
                                <TextBlock Text=" 速度：" VerticalAlignment="Center"/>
                                <TextBox Width="55" Text="{Binding JogSpeed}"/>
                            </StackPanel>

                            <!-- 十字点动板 -->
                            <Grid HorizontalAlignment="Left" Margin="0,4,0,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="1" Content="Y+" Style="{StaticResource JogButton}"
                                        Click="JogYp_Click"/>
                                <Button Grid.Row="1" Grid.Column="0" Content="X−" Style="{StaticResource JogButton}"
                                        Click="JogXm_Click"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="◎" FontSize="16" Margin="6,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="X+" Style="{StaticResource JogButton}"
                                        Click="JogXp_Click"/>
                                <Button Grid.Row="2" Grid.Column="1" Content="Y−" Style="{StaticResource JogButton}"
                                        Click="JogYm_Click"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="轴映射 X/Y/U：" VerticalAlignment="Center"/>
                                <TextBox Width="34" Text="{Binding AxisX}"/>
                                <TextBox Width="34" Text="{Binding AxisY}"/>
                                <TextBox Width="34" Text="{Binding AxisU}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="回读位姿" Click="ReadPose_Click" FontWeight="Bold"/>
                                <Button Content="回填当前点到选中行" Click="FillPose_Click"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentPoseText}" FontFamily="Consolas" FontSize="13"
                                       FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="{Binding MotionAccessHint}" TextWrapping="Wrap" FontSize="10"
                                       Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MotionLog}" TextWrapping="Wrap" FontSize="10"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="工具偏移（主=对针直量；副=相对主 Δ）">
                        <StackPanel>
                            <DataGrid ItemsSource="{Binding ToolRows}" MaxHeight="180"
                                      AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="工具" Binding="{Binding ToolId}" IsReadOnly="True" Width="70"/>
                                    <DataGridTextColumn Header="dx" Binding="{Binding OffsetDx}" Width="70"/>
                                    <DataGridTextColumn Header="dy" Binding="{Binding OffsetDy}" Width="70"/>
                                    <DataGridCheckBoxColumn Header="同心" Binding="{Binding IsConcentric, Mode=TwoWay}" Width="46"/>
                                    <DataGridTemplateColumn Header="裁决" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="设主工具" Padding="4,1" Click="SwitchMaster_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="{Binding ToolRows[0].KindHeader}" TextWrapping="Wrap" FontSize="10"
                                       Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部：校验 + 保存 -->
        <Border Grid.Row="2" Background="{DynamicResource BackgroundLightBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,5">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="校验 G0~G4" Click="Validate_Click"/>
                    <Button Content="刷新步骤状态" Click="RefreshSteps_Click"/>
                    <Button Content="保存 Chain.json" Click="Save_Click" FontWeight="Bold"/>
                    <TextBlock Text="落盘 = Recipes\Workstations\{工位码}\Calib\Chain.json（生产端唯一真源）"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding ValidateResult}" TextWrapping="Wrap" FontSize="11"/>
                <TextBlock Text="{Binding SaveResult}" TextWrapping="Wrap" FontWeight="Bold" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
