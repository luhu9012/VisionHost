<Window x:Class="Grayson.Vision.WpfUI.View.ChainWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 相机采集区模板（每台链上相机一个 Tab；数据模板=九点表+图像点选） -->
        <DataTemplate x:Key="CameraSectionTemplate">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="{Binding MountHeader}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="添加点" Click="AddPoint_Click"/>
                    <Button Content="删除选中" Click="RemovePoint_Click"/>
                    <Button Content="拟合" Click="FitSection_Click" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical">
                    <TextBlock Text="{Binding FitResult}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Button Content="载入图像…" Click="LoadImage_Click"/>
                        <TextBlock Text="左键点击图像 = 回填选中行像素"
                                   Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="；右键 = 写入 DeltaRefPixel（下相机纠偏必测）"
                                   Foreground="DarkOrange" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding IsDownCorrect, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2"
                                Visibility="{Binding IsDownCorrect, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="DeltaRefPixel（吸嘴 U 轴图像投影 R_cdown）Col,Row："
                                   VerticalAlignment="Center"/>
                        <TextBox Width="100" Text="{Binding DeltaRefCol}"/>
                        <TextBox Width="100" Text="{Binding DeltaRefRow}"/>
                    </StackPanel>
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Points}"
                              SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              Margin="0,2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="50"/>
                            <DataGridTextColumn Header="世界X[mm]" Binding="{Binding WorldX}" Width="*"/>
                            <DataGridTextColumn Header="世界Y[mm]" Binding="{Binding WorldY}" Width="*"/>
                            <DataGridTextColumn Header="像素Col" Binding="{Binding PixelCol}" Width="*"/>
                            <DataGridTextColumn Header="像素Row" Binding="{Binding PixelRow}" Width="*"/>
                            <DataGridTextColumn Header="拍照X(EIH)" Binding="{Binding PhotoX}" Width="*"/>
                            <DataGridTextColumn Header="拍照Y(EIH)" Binding="{Binding PhotoY}" Width="*"/>
                            <DataGridTextColumn Header="拍照U°(EIH)" Binding="{Binding PhotoU}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Background="#22000000">
                        <Image Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Source="{Binding Image}"
                               MouseLeftButtonUp="CameraImage_Click"
                               MouseRightButtonUp="CameraImage_RightClick"/>
                    </Border>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：推导说明（自动裁决+人工确认项） -->
        <GroupBox Grid.Row="0" Header="链骨架推导（工位档案事实 → ChainTopologyPlanner；链的形状由工位状况决定）">
            <TextBlock Text="{Binding PlanNotes}" TextWrapping="Wrap" FontSize="11"/>
        </GroupBox>

        <!-- 步骤清单（依赖排序，状态随采集进度刷新） -->
        <GroupBox Grid.Row="1" Header="步骤清单（Workflow 编号对齐《框架设计文档 V2.1》；WF-12=本仓 DeltaRefPixel）">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding StepLabel}" Width="26" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Status}" Width="64" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Target}" Width="80" Foreground="DarkCyan"/>
                            <TextBlock Text="{Binding Workflow}" Width="270"/>
                            <TextBlock Text="{Binding Hint}" Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </GroupBox>

        <!-- 中部：相机采集 Tab（动态） + 工具偏移表 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TabControl Grid.Row="0" ItemsSource="{Binding Sections}"
                        ContentTemplate="{StaticResource CameraSectionTemplate}"
                        Margin="2,4">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
            <GroupBox Grid.Row="1" Header="工具偏移（主=对针直量 T_TCP→Flange；副=相对主 Δ；同轴工具实测=(0,0)）">
                <DataGrid ItemsSource="{Binding ToolRows}"
                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ToolId" Binding="{Binding ToolId}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding KindHeader}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Offset dx[mm]" Binding="{Binding OffsetDx}" Width="110"/>
                        <DataGridTextColumn Header="Offset dy[mm]" Binding="{Binding OffsetDy}" Width="110"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Ready}" IsReadOnly="True" Width="70"/>
                        <DataGridTemplateColumn Header="裁决" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="设为主工具" Padding="4,1"
                                            Click="SwitchMaster_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- 底部：校验 + 保存 -->
        <GroupBox Grid.Row="3" Header="校验与落盘">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Button Content="校验 G0~G4" Click="Validate_Click"/>
                    <Button Content="刷新步骤状态" Click="RefreshSteps_Click"/>
                    <Button Content="保存 Chain.json" Click="Save_Click" FontWeight="Bold"/>
                    <TextBlock Text="落盘路径 = Recipes\Workstations\{工位码}\Calib\Chain.json（生产端唯一真源）"
                               Foreground="Gray" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding ValidateResult}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SaveResult}" TextWrapping="Wrap" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
