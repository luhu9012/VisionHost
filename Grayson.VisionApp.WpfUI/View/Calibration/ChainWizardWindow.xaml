<Window x:Class="Grayson.Vision.WpfUI.View.ChainWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="940" Width="1320"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- ★2026-09-28 主题适配：原先这里的裸隐式样式（无 BasedOn）会顶掉应用级主题，
             使按钮/输入框/表格回落到系统亮色。现一律 BasedOn 主题样式；
             GroupBox 全局无隐式样式，此处补一个基于主题色的模板。 -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}"/>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{DynamicResource BackgroundLightBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}"
                                           FontWeight="SemiBold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource AccentLightBrush}"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 相机采集区模板（每台链上相机一个 Tab；数据模板=九点表+图像点选） -->
        <DataTemplate x:Key="CameraSectionTemplate">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="{Binding MountHeader}" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="添加点" Click="AddPoint_Click"/>
                    <Button Content="删除选中" Click="RemovePoint_Click"/>
                    <Button Content="拟合" Click="FitSection_Click" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical">
                    <TextBlock Text="{Binding FitResult}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Button Content="载入图像…" Click="LoadImage_Click"/>
                        <TextBlock Text="左键点击图像 = 回填选中行像素"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="；右键 = 写入 DeltaRefPixel（下相机纠偏必测）"
                                   Foreground="{DynamicResource WarningBrush}" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding IsDownCorrect, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2"
                                Visibility="{Binding IsDownCorrect, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="DeltaRefPixel（吸嘴 U 轴图像投影 R_cdown）Col,Row："
                                   VerticalAlignment="Center"/>
                        <TextBox Width="100" Text="{Binding DeltaRefCol}"/>
                        <TextBox Width="100" Text="{Binding DeltaRefRow}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="标定高度 Z(mm)（九点标定时机械手的 Z；生产拍照 Z 必须与之一致）："
                                   VerticalAlignment="Center"/>
                        <TextBox Width="100" Text="{Binding CalibZText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2"
                                Visibility="{Binding IsEih, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="拍照基准位 PhotoPose（EIH 生产/示教在此机位拍照）X,Y："
                                   VerticalAlignment="Center"/>
                        <TextBox Width="100" Text="{Binding PhotoPoseX}"/>
                        <TextBox Width="100" Text="{Binding PhotoPoseY}"/>
                    </StackPanel>
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <DataGrid Grid.Row="0" ItemsSource="{Binding Points}"
                              SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                              Margin="0,2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="50"/>
                            <DataGridTextColumn Header="世界X[mm]" Binding="{Binding WorldX}" Width="*"/>
                            <DataGridTextColumn Header="世界Y[mm]" Binding="{Binding WorldY}" Width="*"/>
                            <DataGridTextColumn Header="像素Col" Binding="{Binding PixelCol}" Width="*"/>
                            <DataGridTextColumn Header="像素Row" Binding="{Binding PixelRow}" Width="*"/>
                            <DataGridTextColumn Header="拍照X(EIH)" Binding="{Binding PhotoX}" Width="*"/>
                            <DataGridTextColumn Header="拍照Y(EIH)" Binding="{Binding PhotoY}" Width="*"/>
                            <DataGridTextColumn Header="拍照U°(EIH)" Binding="{Binding PhotoU}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="#22000000">
                        <Image Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Source="{Binding Image}"
                               MouseLeftButtonUp="CameraImage_Click"
                               MouseRightButtonUp="CameraImage_RightClick"/>
                    </Border>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：推导说明（自动裁决+人工确认项） -->
        <GroupBox Grid.Row="0" Header="链骨架推导（工位档案事实 → ChainTopologyPlanner；链的形状由工位状况决定）">
            <TextBlock Text="{Binding PlanNotes}" TextWrapping="Wrap" FontSize="11"/>
        </GroupBox>

        <!-- ★坐标系传导链可视化（2026-09-28）：拓扑图 + 标定阶段的矩阵式 + 生产消费公式 -->
        <GroupBox Grid.Row="1" Header="坐标系传导链（本工位怎么标、怎么用 —— 全矩阵表达）">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="1.35*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#14000000" CornerRadius="3" Padding="6" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="① 拓扑" FontWeight="Bold" Margin="0,0,0,3"
                                   Foreground="{DynamicResource AccentLightBrush}"/>
                        <TextBlock Text="{Binding TopologyDiagram}" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#14000000" CornerRadius="3" Padding="6" Margin="3,0,3,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                        <StackPanel>
                            <TextBlock Text="② 标定阶段：逐节点解什么" FontWeight="Bold" Margin="0,0,0,3"
                                       Foreground="{DynamicResource AccentLightBrush}"/>
                            <TextBlock Text="{Binding CalibMath}" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Column="2" Background="#14000000" CornerRadius="3" Padding="6" Margin="3,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                        <StackPanel>
                            <TextBlock Text="③ 生产消费：像素→世界→法兰" FontWeight="Bold" Margin="0,0,0,3"
                                       Foreground="{DynamicResource AccentLightBrush}"/>
                            <TextBlock Text="{Binding ConsumeMath}" FontFamily="Consolas" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </GroupBox>

        <!-- 步骤清单（★可点击：点一步 → 右侧操作区切到该步对应区域） -->
        <GroupBox Grid.Row="2" Header="步骤清单（点击某一步 → 下方操作区自动切到该步；点一次即到位）">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="StepRowBorder" Background="Transparent" CornerRadius="3"
                                Padding="2,1" Margin="0,1" MouseLeftButtonUp="StepRow_Click"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StepLabel}" Width="26" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Status}" Width="64" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Target}" Width="80" Foreground="{DynamicResource InfoBrush}"/>
                                <TextBlock Text="{Binding Workflow}" Width="270"/>
                                <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="StepRowBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <!-- ★当前步骤引导栏（随步骤清单点选实时更新） -->
        <Border Grid.Row="3" Background="{DynamicResource BackgroundLightBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1,0,0,0"
                Padding="8,4" Margin="4,3,4,0">
            <TextBlock Text="{Binding StepGuide}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Border>

        <!-- 中部：相机采集 Tab（动态） + 工具偏移表 -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TabControl Grid.Row="0" x:Name="CameraTabs" ItemsSource="{Binding Sections}"
                        SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                        ContentTemplate="{StaticResource CameraSectionTemplate}"
                        Margin="2,4">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
            <GroupBox Grid.Row="1" Header="工具偏移（主=对针直量 T_TCP→Flange；副=相对主 Δ；同轴工具实测=(0,0)）">
                <DataGrid ItemsSource="{Binding ToolRows}"
                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ToolId" Binding="{Binding ToolId}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding KindHeader}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="Offset dx[mm]" Binding="{Binding OffsetDx}" Width="110"/>
                        <DataGridTextColumn Header="Offset dy[mm]" Binding="{Binding OffsetDy}" Width="110"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Ready}" IsReadOnly="True" Width="70"/>
                        <DataGridTemplateColumn Header="裁决" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="设为主工具" Padding="4,1"
                                            Click="SwitchMaster_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <!-- 底部：校验 + 保存 -->
        <GroupBox Grid.Row="5" Header="校验与落盘">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Button Content="校验 G0~G4" Click="Validate_Click"/>
                    <Button Content="刷新步骤状态" Click="RefreshSteps_Click"/>
                    <Button Content="保存 Chain.json" Click="Save_Click" FontWeight="Bold"/>
                    <TextBlock Text="落盘路径 = Recipes\Workstations\{工位码}\Calib\Chain.json（生产端唯一真源）"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding ValidateResult}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding SaveResult}" TextWrapping="Wrap" FontWeight="Bold"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
