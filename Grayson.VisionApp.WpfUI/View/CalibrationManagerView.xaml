<UserControl x:Class="Grayson.Vision.WpfUI.View.CalibrationManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:calib="clr-namespace:Grayson.Vision.Contracts.Calibration.Models;assembly=Grayson.Vision.Contracts"
             mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="920"
             xmlns:conv="clr-namespace:Grayson.Vision.WpfUI.Common.Converters"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <!-- 注册转换器 -->
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="280"/>
			<ColumnDefinition Width="10"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>
		
		<!-- 左侧：标定 Profile 方案列表 -->
		<Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Padding="8" CornerRadius="4">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="8"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

			

                <!-- 在左侧列表头部新增组合按钮 -->
                <Grid Grid.Row="0">
                    <TextBlock Text="标定配置方案" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- 1. 修改新增按钮：挂载 Click 事件，并在 ContextMenu 加上 x:Name -->
                        <Button Content="+ 新建 ▾" Style="{StaticResource PrimaryButtonStyle}"
							Height="28" Padding="8,0" Click="BtnNewProfile_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="NewProfileMenu">
                                    <MenuItem Header="🎯 九点手眼标定 (Nine-Point Hand-Eye)"
										  Command="{Binding NewProfileCommand}">
                                        <MenuItem.CommandParameter>
                                            <calib:CalibrationType>NinePointHandEye</calib:CalibrationType>
                                        </MenuItem.CommandParameter>
                                    </MenuItem>
                                    <MenuItem Header="🏁 2D 棋盘格/圆点标定 (Checkerboard 2D)"
										  Command="{Binding NewProfileCommand}">
                                        <MenuItem.CommandParameter>
                                            <calib:CalibrationType>Checkerboard2D</calib:CalibrationType>
                                        </MenuItem.CommandParameter>
                                    </MenuItem>
                                    <MenuItem Header="📏 像素比例标定 (Pixel Scale)"
										  Command="{Binding NewProfileCommand}">
                                        <MenuItem.CommandParameter>
                                            <calib:CalibrationType>PixelScale</calib:CalibrationType>
                                        </MenuItem.CommandParameter>
                                    </MenuItem>
                                    <MenuItem Header="📐 多点仿射变换 (Affine Transform)"
										  Command="{Binding NewProfileCommand}">
                                        <MenuItem.CommandParameter>
                                            <calib:CalibrationType>HandEyeWithRotation</calib:CalibrationType>
                                        </MenuItem.CommandParameter>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Button Content="🗑 删除" Style="{StaticResource DangerButtonStyle}"
							Command="{Binding DeleteProfileCommand}" Height="28" Padding="8,0" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding CalibrationProfiles}"
                         SelectedItem="{Binding SelectedCalibrationProfile}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid Margin="4,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<!-- 状态指示灯 (绿:已标定, 红:未标定) -->
								<Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
									<Ellipse.Style>
										<Style TargetType="Ellipse">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsCalibrated}" Value="True">
													<Setter Property="Fill" Value="#FF107C41"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding IsCalibrated}" Value="False">
													<Setter Property="Fill" Value="#FFA80000"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Ellipse.Style>
								</Ellipse>
                                <!-- ✅ 替换后：包含名称与物理模式彩色 Tag 标签 -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                    <!-- 标定物理模式 Tag 渲染组 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <!-- 1. 标定类型 Tag -->
                                        <Border Background="#107C41" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding Type}" Foreground="White" FontSize="10"/>
                                        </Border>

                                        <!-- 2. 眼在手上 / 眼在手外 Tag -->
                                        <Border Background="#0078D4" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding EyeMode}" Foreground="White" FontSize="10"/>
                                        </Border>

                                        <!-- 3. 是否带 TCP 工具旋转中心 Tag -->
                                        <Border Background="#D13438" CornerRadius="3" Padding="4,2" 
                Visibility="{Binding HasToolOffset, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="TCP偏移" Foreground="White" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
					<Button Content="导入" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ImportCommand}" Width="auto" Height="auto"/>
					<Button Content="导出" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportCommand}" Width="auto" Height="auto" Margin="6,0,0,0"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- 右侧：详情与作用域发布 -->
		<Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Padding="12" CornerRadius="4">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="12"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="12"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- 头部工具栏 -->
				<Grid Grid.Row="0">
					<TextBlock Text="{Binding SelectedCalibrationProfile.Name, FallbackValue='请选择标定方案', TargetNullValue='请选择标定方案'}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

					<Button Content="🚀 启动标定向导..." HorizontalAlignment="Right"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding OpenWizardCommand}" Height="30" Padding="12,0"/>
				</Grid>

				<!-- 核心指标评估 KPI Dashboard 卡片 -->
				<Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="12">
					<UniformGrid Columns="3">
						<StackPanel>
							<TextBlock Text="标定类型" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Text="{Binding SelectedCalibrationProfile.Type, FallbackValue='-'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
						</StackPanel>
						<StackPanel>
							<TextBlock Text="重投影误差 (RMS)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Text="{Binding SelectedCalibrationProfile.RmsError, StringFormat={}{0:F4} mm, FallbackValue='N/A'}"
                                       FontSize="13" FontWeight="Bold" Foreground="#FF0078D4" Margin="0,4,0,0"/>
						</StackPanel>
						<StackPanel>
							<TextBlock Text="绑定工位/设备" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Text="{Binding SelectedCalibrationProfile.BindingInfo, FallbackValue='未绑定'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
						</StackPanel>
					</UniformGrid>
				</Border>

				<!-- 下部：发布设置与在线转换验证 -->
				<Grid Grid.Row="4">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="12"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<!-- 作用域发布收拢 -->
					<GroupBox Grid.Row="0" Header="标定矩阵应用与分发" Foreground="{DynamicResource TextPrimaryBrush}">
						<StackPanel Orientation="Horizontal" Margin="8">
							<TextBlock Text="发布目标域:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
							<ComboBox Width="160" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="{Binding SelectedScopeIndex}">
								<ComboBoxItem Content="当前设备 (Device)"/>
								<ComboBoxItem Content="工位全局 (Workstation)"/>
								<ComboBoxItem Content="特定配方 (Recipe)"/>
							</ComboBox>

							<Button Content="应用标定矩阵" Style="{StaticResource SuccessButtonStyle}"
                                    Command="{Binding SaveToDeviceCommand}" Margin="12,0,0,0" Padding="16,0"/>
						</StackPanel>
					</GroupBox>

					<!-- 在线坐标映射校验 -->
					<GroupBox Grid.Row="2" Header="在线坐标映射校验 (Pixel ➔ World)" Foreground="{DynamicResource TextPrimaryBrush}">
						<Grid Margin="8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0" Margin="0,0,8,0">
								<TextBlock Text="输入像素坐标 (Px, Py):" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
								<StackPanel Orientation="Horizontal">
									<TextBox Width="70" Text="{Binding TestPixelX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
									<TextBox Width="70" Text="{Binding TestPixelY, UpdateSourceTrigger=PropertyChanged}"/>
								</StackPanel>
							</StackPanel>

							<StackPanel Grid.Column="1">
								<TextBlock Text="转换物理坐标 (Wx, Wy mm):" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
								<TextBlock Text="{Binding TestWorldResult, FallbackValue='X: 0.000, Y: 0.000'}"
                                           FontWeight="Bold" Foreground="#FF107C41" VerticalAlignment="Center" Margin="0,4,0,0"/>
							</StackPanel>

							<Button Grid.Column="2" Content="测试转换" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding TestMapCommand}" VerticalAlignment="Bottom" Height="28" Padding="12,0"/>
						</Grid>
					</GroupBox>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>