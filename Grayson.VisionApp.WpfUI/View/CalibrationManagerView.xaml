<UserControl x:Class="Grayson.Vision.WpfUI.View.CalibrationManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="920"
             xmlns:conv="clr-namespace:Grayson.Vision.WpfUI.Common.Converters"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <!-- 注册转换器 -->
        <conv:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <conv:CalibrationQuantityToTextConverter x:Key="CalibTypeToTextConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- 📐 页头：标题 + 工位定位胶囊 + 模式说明 + 回全库（2026-09-05 镜像模板工作台交互） -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="10,10,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="← 回全库"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" VerticalAlignment="Center"
                            Command="{Binding BackToGlobalCommand}"
                            Visibility="{Binding IsStationScope, Converter={StaticResource BoolToVis}}"
                            ToolTip="解除工位定位，回到全局方案浏览模式"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📐 标定中心" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Background="#1E107C41" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="定位：" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ScopeChipText}" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,6,0,0">
                    <TextBlock Text="{Binding ScopeHintText}"
                               FontSize="11.5" Foreground="{StaticResource TextDisabledBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ScopeNoteText}" FontSize="11.5" Foreground="#FF107C41"
                               TextWrapping="Wrap" Margin="0,3,0,0"
                               Visibility="{Binding HasScopeNote, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 档案标定计划任务卡（2026-09-05 P3：从档案推导"该做哪些标定"，H/e 拆分按槽×吸嘴实例化） -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="10,10,10,0"
                Visibility="{Binding CandidatesVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="✕ 稍后处理" Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,4" VerticalAlignment="Center" Command="{Binding DismissCandidatesCommand}"
                            ToolTip="暂不批量创建；可稍后手工新建单个方案"/>
                    <TextBlock Text="📋 档案标定计划 —— 按需求推导本工位应做的标定" FontSize="13" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="相机 H 按槽共享一条；工具偏心/旋转按吸嘴各一条（双吸嘴不必重复九点）。勾选主线任务 → 「按计划创建」，再逐个进向导绑定相机/轴。"
                           FontSize="11.5" Foreground="{StaticResource TextDisabledBrush}" TextWrapping="Wrap" Margin="0,3,0,8"/>

                <ItemsControl ItemsSource="{Binding Candidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                                  Checked="CandidateCheck_Changed" Unchecked="CandidateCheck_Changed"/>
                                        <Border Background="#22378ADD" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ChipText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </Border>
                                        <Border Background="#1E107C41" CornerRadius="9" Padding="7,1" Margin="4,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindBadge}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#FF107C41"/>
                                        </Border>
                                        <TextBlock Text="{Binding TagText}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#FF107C41" VerticalAlignment="Center" Text="{Binding TypeDisplay}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Suggestion}" FontSize="11"
                                               Foreground="{StaticResource TextDisabledBrush}" Margin="28,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding CandidatesSummary}" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="✔ 按计划创建标定方案" Style="{StaticResource SuccessButtonStyle}"
                            Padding="16,6" Command="{Binding CreateCandidatesCommand}"
                            ToolTip="按勾选任务创建 CalibrationProfile（相机H 与 工具偏心e 自动按槽/吸嘴预填）"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
		<!-- 左侧：标定 Profile 方案列表 -->
		<Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Padding="8" CornerRadius="4">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="8"/>
					<RowDefinition Height="*"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>

			

                <!-- 在左侧列表头部新增组合按钮 -->
                <Grid Grid.Row="0">
                    <TextBlock Text="标定配置方案" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- 1. 修改新增按钮：挂载 Click 事件，菜单项由 code-behind 按 CalibrationTypeOptions
                             统一数据源动态生成（与右侧类型下拉完全一致；开发中(TODO)项灰显禁用） -->
                        <Button Content="+ 新建 ▾" Style="{StaticResource PrimaryButtonStyle}"
							Height="28" Padding="8,0" Click="BtnNewProfile_Click">
                            <Button.ContextMenu>
                                <ContextMenu x:Name="NewProfileMenu"/>
                            </Button.ContextMenu>
                        </Button>

                        <Button Content="🗑 删除" Style="{StaticResource DangerButtonStyle}"
							Command="{Binding DeleteProfileCommand}" Height="28" Padding="8,0" Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
                <ListBox Grid.Row="2" ItemsSource="{Binding VisibleProfiles}"
                         SelectedItem="{Binding SelectedCalibrationProfile}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid Margin="4,4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
								</Grid.ColumnDefinitions>

								<!-- 状态指示灯 (绿:已标定, 红:未标定) -->
								<Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
									<Ellipse.Style>
										<Style TargetType="Ellipse">
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsCalibrated}" Value="True">
													<Setter Property="Fill" Value="#FF107C41"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding IsCalibrated}" Value="False">
													<Setter Property="Fill" Value="#FFA80000"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Ellipse.Style>
								</Ellipse>
                                <!-- ✅ 替换后：包含名称与物理模式彩色 Tag 标签 -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>

                                    <!-- 标定物理模式 Tag 渲染组 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <!-- 1. 标定类型 Tag（中文名，如 九点手眼 / 九点+旋转(偏心)） -->
                                        <Border Background="#107C41" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding Type, Converter={StaticResource CalibTypeToTextConverter}}" Foreground="White" FontSize="10"/>
                                        </Border>

                                        <!-- 2. 眼在手上 / 眼在手外 Tag -->
                                        <Border Background="#0078D4" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding EyeMode}" Foreground="White" FontSize="10"/>
                                        </Border>

                                        <!-- 2.1 吸嘴号 Tag（仅多吸嘴时显示） -->
                                        <Border Background="#8A4B08" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NozzleKey}" Value="1">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NozzleKey}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding NozzleKey, StringFormat=吸嘴{0}}" Foreground="White" FontSize="10"/>
                                        </Border>

                                        <!-- 2.2 相机槽 Tag（复合工位用来区分上/下固定相机） -->
                                        <Border Background="#5A2D82" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CameraSlotKey}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CameraSlotKey}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding CameraSlotKey}" Foreground="White" FontSize="10"/>
                                        </Border>

                                        <!-- 3. 是否带 TCP 工具旋转中心 Tag -->
                                        <Border Background="#D13438" CornerRadius="3" Padding="4,2" 
                Visibility="{Binding HasToolOffset, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="TCP偏移" Foreground="White" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
					<Button Content="导入" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ImportCommand}" Width="auto" Height="auto"/>
					<Button Content="导出" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ExportCommand}" Width="auto" Height="auto" Margin="6,0,0,0"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- 右侧：详情与作用域发布 -->
		<Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Padding="12" CornerRadius="4">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="12"/>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="12"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<!-- 头部工具栏：方案名称可编辑（失焦自动保存，类型切换也会自动改名）+ P3 任务卡区（动作在卡上，无平行三按钮） -->
				<StackPanel Grid.Row="0">
					<Grid>
						<TextBox x:Name="ProfileNameBox"
                                 Text="{Binding SelectedCalibrationProfile.Name, UpdateSourceTrigger=LostFocus, TargetNullValue='', FallbackValue=''}"
                                 LostFocus="ProfileNameBox_LostFocus"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                 Margin="0,0,8,0" Padding="6,3"
                                 ToolTip="方案名称可直接编辑（失焦自动保存）"/>
						<TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource TextDisabledBrush}"
                                   Text="引导/校验/对针/发布均以任务卡为准"/>
					</Grid>

					<!-- P3：本方案 → 0..N 张任务卡（H/e/t/s 按量拆分），动作直接挂在卡上 -->
					<Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="10" Margin="0,8,0,0"
                            Visibility="{Binding HasDerivedCards, Converter={StaticResource BoolToVis}}">
						<StackPanel>
							<DockPanel>
								<Button DockPanel.Dock="Right" Content="⚡ 一键顺序标定 H→e→t" Height="22" Padding="10,0" FontSize="11"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                        Visibility="{Binding CanAutoChain, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding AutoChainCommand}"
                                        ToolTip="按依赖序连做本方案未发布的必做任务：每段独立向导，段间弹窗确认（选“否”即中止）。"/>
								<TextBlock Text="{Binding CardWorkbenchTitle}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
							</DockPanel>
							<ItemsControl ItemsSource="{Binding DerivedCards}" Margin="0,6,0,0">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
											<StackPanel>
												<DockPanel>
													<Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding StateBrush}"/>
													<Border Background="#22378ADD" CornerRadius="9" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
														<TextBlock Text="{Binding QuantityBadge}" Foreground="White" FontWeight="Bold" FontSize="12"/>
													</Border>
													<Border Background="#338A4B08" CornerRadius="9" Padding="6,1" Margin="4,0,0,0" VerticalAlignment="Center"
                                                            Visibility="{Binding IsOptional, Converter={StaticResource BoolToVis}}">
														<TextBlock Text="可选" FontSize="10" Foreground="#FFB97B2B"/>
													</Border>
													<TextBlock Text="{Binding QuantityText}" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
													<Border Background="{Binding StateBrush}" CornerRadius="9" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
														<TextBlock Text="{Binding StateText}" Foreground="White" FontSize="10.5"/>
													</Border>
													<TextBlock Text="{Binding ScopeText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="10,0,0,0" VerticalAlignment="Center"/>
													<TextBlock Text="{Binding LayoutText}" FontSize="11" Foreground="{StaticResource TextDisabledBrush}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
													<TextBlock Text="{Binding PathText}" FontSize="10.5" Foreground="{StaticResource TextDisabledBrush}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"/>
												</DockPanel>

												<StackPanel Margin="26,4,0,0" Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}">
													<TextBlock Text="{Binding Card.Reason}" FontSize="10.5" Foreground="{StaticResource TextDisabledBrush}"
                                                               TextWrapping="Wrap" Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}"/>
													<TextBlock Text="{Binding DepText}" FontSize="10.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                                               Margin="0,1,0,0"
                                                               Visibility="{Binding HasDep, Converter={StaticResource BoolToVis}}"/>
													<TextBlock Text="{Binding StateDetail}" FontSize="10.5" Foreground="{StaticResource TextDisabledBrush}"
                                                               TextWrapping="Wrap" Margin="0,1,0,0"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
												</StackPanel>

												<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
													<Button Content="🚀 引导 / 重标" Style="{StaticResource PrimaryButtonStyle}" Height="24" Padding="10,0"
                                                            Command="{Binding DataContext.RunWizardForCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding ShowWizardAction, Converter={StaticResource BoolToVis}}"/>
													<Button Content="🔍 校验" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="10,0" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.RunVerifierForCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding ShowVerifyAction, Converter={StaticResource BoolToVis}}"/>
													<Button Content="🎯 对针" Style="{StaticResource SecondaryButtonStyle}" Height="24" Padding="10,0" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.RunToolOffsetForCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding ShowAlignAction, Converter={StaticResource BoolToVis}}"/>
													<Button Content="📌 发布" Style="{StaticResource SuccessButtonStyle}" Height="24" Padding="10,0" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.PublishCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Visibility="{Binding ShowPublishAction, Converter={StaticResource BoolToVis}}"/>
												</StackPanel>
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<!-- 无可派生卡（棋盘/畸变占位或未实现类型）提示 -->
					<TextBlock Text="{Binding CardWorkbenchHint}" FontSize="11" Foreground="{StaticResource TextDisabledBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasNoDerivedCards, Converter={StaticResource BoolToVis}}"/>
				</StackPanel>

			<!-- 核心指标评估 KPI Dashboard 卡片 -->
			<Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="12">
				<StackPanel>
					<UniformGrid Columns="4">
						<StackPanel>
							<TextBlock Text="标定类型（可更改）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<!-- 类型切换：九点手眼 ↔ 九点+旋转(偏心/仿射) 等（HandEyeWithRotation 适配 ST002 Epson 双吸嘴与 ZR 不共轴场景）。
                                 IsAvailable=false 的开发中(TODO)项灰显，无法选中 -->
							<ComboBox ItemsSource="{Binding CalibrationTypeOptions}"
                                      SelectedItem="{Binding SelectedProfileTypeOption}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="26" Margin="0,4,0,0" MaxDropDownHeight="220">
								<ComboBox.ItemContainerStyle>
									<Style TargetType="ComboBoxItem">
										<Setter Property="IsEnabled" Value="{Binding IsAvailable}"/>
										<Setter Property="ToolTip" Value="{Binding Description}"/>
									</Style>
								</ComboBox.ItemContainerStyle>
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Description}" TextTrimming="CharacterEllipsis"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>
						<StackPanel Margin="12,0,0,0">
							<TextBlock Text="吸嘴/工具通道（每吸嘴一套标定）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<ComboBox ItemsSource="{Binding NozzleKeyOptions}"
                                      SelectedValue="{Binding NozzleKeyText, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="26" Margin="0,4,0,0"
                                      ToolTip="双吸嘴与 R/U 不同轴的工位：吸嘴1 与 吸嘴2 各自旋转中心/偏心/矩阵不同，每吸嘴一条独立方案。&#x0a;切换 = 定位该吸嘴的独立方案：已有则直接载入；没有则确认后按当前方案新建空方案，再为它单独跑 H/e 向导并发布。"/>
						</StackPanel>
						<StackPanel>
							<TextBlock Text="重投影误差 (RMS)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Text="{Binding SelectedCalibrationProfile.RmsError, StringFormat={}{0:F4} mm, FallbackValue='N/A'}"
									   FontSize="13" FontWeight="Bold" Foreground="#FF0078D4" Margin="0,4,0,0"/>
						</StackPanel>
						<StackPanel>
							<TextBlock Text="绑定工位/设备" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<TextBlock Text="{Binding SelectedCalibrationProfile.BindingInfo, FallbackValue='未绑定'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"
									   TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedCalibrationProfile.BindingInfo, FallbackValue='未绑定'}"/>
						</StackPanel>
					</UniformGrid>

					<!-- 相机槽 + 相机安装方式（2026-09-11：复合工位的推荐方案判错槽/布局时，直接在标定中心改，不必进向导） -->
					<Grid Margin="0,10,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="14"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0">
							<TextBlock Text="相机槽（可编辑 / 可手填）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<ComboBox ItemsSource="{Binding CameraSlotOptions}"
                                      Text="{Binding ProfileSlotKey, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      IsEditable="True"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="26" Margin="0,4,0,0"
                                      ToolTip="标定产物身份=站|量|槽|吸嘴。复合工位上/下相机必须分槽（如 Cam_A / Cam_C），否则两条标定产物撞同一身份。&#x0a;这里改槽即刻生效并落盘；已标定方案会先弹确认（矩阵属于原槽，改后需重标）。"/>
						</StackPanel>

						<StackPanel Grid.Column="2">
							<TextBlock Text="相机安装方式（可编辑）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<ComboBox ItemsSource="{Binding EyeModeOptions}"
                                      SelectedItem="{Binding ProfileEyeModeOption, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Height="26" Margin="0,4,0,0"
                                      ToolTip="固定相机（上下固定、俯视/仰视）= 眼在手外 EyeToHand；相机随机械手运动 = 眼在手上 EyeInHand。&#x0a;改布局会重算采集路径与 H 推导口径，已标定方案需重跑标定。">
								<ComboBox.ItemContainerStyle>
									<Style TargetType="ComboBoxItem">
										<Setter Property="ToolTip" Value="{Binding Description}"/>
									</Style>
								</ComboBox.ItemContainerStyle>
							</ComboBox>
						</StackPanel>
					</Grid>

					<!-- 相机 / 运动卡绑定（2026-09-15：此前是只读展示 ⇒ 「按计划创建」出来的方案绑到占位值也改不掉。
					     复合工位 Cam_C 两条档案即如此：CameraId=「Cam_C」（槽名被当设备名）/ AxisId=「Axis_X」（占位）
					     且 BoundDeviceId 为空。★注：自 2026-09-15 单轨存储起，矩阵产物目录只由【工位】决定
					     （Recipes\Workstations\<工位>\Calib），这里选的是「标定时打开哪台相机」，不再影响落盘目录。） -->
					<Grid Margin="0,10,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="14"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<StackPanel Grid.Column="0">
							<TextBlock Text="相机设备（可编辑 / 可重绑）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<ComboBox ItemsSource="{Binding BindingCameraOptions}"
									  SelectedItem="{Binding SelectedBindingCamera, Mode=TwoWay}"
									  Style="{StaticResource ModernComboBoxStyle}"
									  Height="26" Margin="0,4,0,0"
									  ToolTip="本方案绑定的物理相机 —— 决定【标定时打开/采图的是哪台相机】。&#x0a;★2026-09-15 起矩阵产物单轨落在工位级目录 Recipes\Workstations\&lt;工位&gt;\Calib\，不再按相机设备落盘：选错相机不会写错目录，但会采错图导致标定结果作废。&#x0a;复合工位上/下相机是两台设备，务必选对。&#x0a;改完若本方案已有标定结果，需对该相机重新执行 H 标定并发布。">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding DeviceName}"/>
											<TextBlock Text="{Binding DeviceKey}" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" Margin="4,0,0,0"/>
										</StackPanel>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>

						<StackPanel Grid.Column="2">
							<TextBlock Text="运动卡 / 机械手（可编辑 / 可重绑）" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
							<ComboBox ItemsSource="{Binding BindingMotionOptions}"
									  SelectedItem="{Binding SelectedBindingMotion, Mode=TwoWay}"
									  Style="{StaticResource ModernComboBoxStyle}"
									  Height="26" Margin="0,4,0,0"
									  ToolTip="走位用的运动卡 / 机械手。标定向导第一步写的就是这两个字段（与本处同一实现）。">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<StackPanel Orientation="Horizontal">
											<TextBlock Text="{Binding DeviceName}"/>
											<TextBlock Text="{Binding DeviceKey}" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}" Margin="4,0,0,0"/>
										</StackPanel>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>
					</Grid>

					<Grid Margin="0,6,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<TextBlock Grid.Column="0" Text="{Binding BindingDeviceHintText}" FontSize="10.5"
								   Foreground="{DynamicResource TextDisabledBrush}" TextWrapping="Wrap"
								   VerticalAlignment="Center" Margin="0,0,10,0"/>
						<Button Grid.Column="1" Content="应用绑定" Command="{Binding RebindDevicesCommand}"
								Style="{StaticResource SecondaryButtonStyle}" Padding="12,3" MinWidth="88"
								ToolTip="把上面选中的相机 / 运动卡写回本方案档案（与标定向导第一步同一实现）。&#x0a;会先弹确认：相机变了 ⇒ 矩阵目录也变，已标定方案需重标。"/>
					</Grid>

					<TextBlock Text="{Binding SlotHintText}" FontSize="10.5" Foreground="{DynamicResource TextDisabledBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
					<!-- 当前生效的标定矩阵路径（应用后立即可见保存位置） -->
					<StackPanel Margin="0,10,0,0">
						<TextBlock Text="当前矩阵文件路径" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
						<TextBlock Text="{Binding SelectedCalibrationProfile.HomMatFilePath, FallbackValue='未生成', TargetNullValue='未生成'}"
								   FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
								   TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedCalibrationProfile.HomMatFilePath}"
								   Margin="0,4,0,0"/>
					</StackPanel>
				</StackPanel>
			</Border>

				<!-- 下部：发布设置与在线转换验证 -->
				<Grid Grid.Row="4">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="12"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<!-- 发布域收拢（2026-09-05 收敛两档：工位级共享 / 特定配方；移除"设备"——矩阵不属于设备实例） -->
					<GroupBox Grid.Row="0" Header="标定矩阵发布（工位级共享 / 特定配方）" Foreground="{DynamicResource TextPrimaryBrush}">
						<StackPanel Margin="8">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="发布目标域:" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
								<ComboBox Width="170" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="{Binding SelectedScopeIndex}">
									<ComboBoxItem Content="工位级 (Workstation)"/>
									<ComboBoxItem Content="特定配方 (Recipe)"/>
								</ComboBox>

								<Button Content="应用标定矩阵" Style="{StaticResource SuccessButtonStyle}"
                                        Command="{Binding SaveMatrixCommand}" Margin="12,0,0,0" Padding="16,0"/>
							</StackPanel>

							<!-- 配方级：选择目标配方（原"按全局 IsActive 盲选"已废除） -->
							<StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding IsRecipeScopeSelected, Converter={StaticResource BoolToVis}}">
								<TextBlock Text="目标配方:" Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
								<ComboBox Width="280" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding PublishRecipeOptions}"
                                          SelectedItem="{Binding SelectedPublishRecipe}"
                                          ToolTip="发布到该配方专属目录，并回写其流程内『标定转换』节点的矩阵路径（运行时真正消费方）">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock>
												<Run Text="{Binding RecipeName, Mode=OneWay}"/>
												<Run Text=" ("/>
												<Run Text="{Binding RecipeCode, Mode=OneWay}"/>
												<Run Text=")"/>
											</TextBlock>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
								<TextBlock Text="发布后自动回写配方内标定节点路径"
                                           Foreground="{StaticResource TextDisabledBrush}" FontSize="10"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
							</StackPanel>

							<TextBlock Text="{Binding ScopeTargetHint}" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="10.5" TextWrapping="Wrap" Margin="0,6,0,0"/>

							<!-- 旋转标定结果 → 业务落点补偿（VisionPickPlace / MahjongDualNozzle 偏心公式，替代旧 NozzleToolOffset 手工示教） -->
							<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
								<TextBlock Text="旋转标定几何 → 工位业务落点补偿:" Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
								<Button Content="📤 发布偏心到业务配置"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding PublishEccCommand}"
                                        Padding="12,0" Height="28"/>
								<TextBlock Text="（方案已绑工位、吸嘴号 1/2，且已完成旋转中心标定(e) 或物理对针后可用；写入 Ecc / U0(ToolAlignU) / O / 相机安装方式并热更新）"
                                           Foreground="{DynamicResource TextDisabledBrush}" FontSize="10"
                                           VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="300"/>
							</StackPanel>
							<TextBlock Text="{Binding PublishEccStatusText, FallbackValue=''}"
                                       Foreground="#FF107C41" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
						</StackPanel>
					</GroupBox>

					<!-- 在线坐标映射校验（2026-09-10 双向：Pixel ➔ World / World ➔ Pixel） -->
					<GroupBox Grid.Row="2" Header="在线坐标映射校验（双向）" Foreground="{DynamicResource TextPrimaryBrush}">
						<Grid Margin="8">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="6"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>

							<!-- 正向：Pixel → World -->
							<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
								<TextBlock Text="① 像素 → 机械 (Px, Py):" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
								<StackPanel Orientation="Horizontal">
									<TextBox Width="70" Text="{Binding TestPixelX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
									<TextBox Width="70" Text="{Binding TestPixelY, UpdateSourceTrigger=PropertyChanged}"/>
								</StackPanel>
								<TextBlock Text="{Binding TestWorldResult, FallbackValue='X: 0.000, Y: 0.000'}"
										   FontWeight="Bold" Foreground="#FF107C41" Margin="0,5,0,0"/>
							</StackPanel>

							<!-- 反向：World → Pixel -->
							<StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,0">
								<TextBlock Text="② 机械 → 像素 (Wx, Wy mm):" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
								<StackPanel Orientation="Horizontal">
									<TextBox Width="70" Text="{Binding TestWorldX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
									<TextBox Width="70" Text="{Binding TestWorldY, UpdateSourceTrigger=PropertyChanged}"/>
								</StackPanel>
								<TextBlock Text="{Binding TestPixelResult, FallbackValue='Px: 0.0, Py: 0.0'}"
										   FontWeight="Bold" Foreground="#FF107C41" Margin="0,5,0,0"/>
							</StackPanel>

							<Button Grid.Row="0" Grid.Column="2" Content="测试转换" Style="{StaticResource SecondaryButtonStyle}"
									Command="{Binding TestMapCommand}" VerticalAlignment="Bottom" Height="28" Padding="12,0"/>
						</Grid>
					</GroupBox>
				</Grid>
			</Grid>
		</Border>
	</Grid>
    </DockPanel>
</UserControl>