<UserControl x:Class="Grayson.Vision.WpfUI.View.CameraTuneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Grayson.Vision.WpfUI.Common.Converters"
             xmlns:controls="clr-namespace:Grayson.Vision.HalconWrapper.Wpf.Controls;assembly=Grayson.Vision.HalconWrapper.Wpf"
             mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="1280"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- 深色折叠区(全局没有 Expander 样式,默认模板是浅色文字,在深色底上看不见) -->
        <Style x:Key="DarkExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderButton" Focusable="False" Cursor="Hand"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="Arrow" Text="▸" Margin="0,0,6,0"
                                                           Foreground="{StaticResource TextDisabledBrush}"/>
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="▾"/>
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="14,2,0,4"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ 左列:实时画面 + 结论/处方 ═══════════ -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Black" CornerRadius="4"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <controls:HalconImageDisplayHost DataContext="{Binding CameraDisplayVm}"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsGrabbing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <TextBlock Text="点右侧『▶ 连接并预览』后这里显示实时画面" Foreground="#999" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                    <StackPanel>
                        <TextBlock Text="结论 / 处方" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding ResultText}" FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ═══════════ 右列:一条主线 ①②③ ═══════════ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="📏 相机装调助手" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,6"/>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="装相机只要两件事:① 光轴垂直于工面(垂直度) ② 画面亮/匀/清楚(成像)。两个页签各管一件,都过绿字再进标定。"/>

                <!-- 当前动作 + 链路状态:一眼看出"能不能用" -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                     Fill="{Binding CamStatusBrush}"/>
                            <TextBlock Text="{Binding CamStatusText}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding FrameInfoText}" FontSize="11" Margin="18,3,0,0"
                                   Foreground="{StaticResource TextDisabledBrush}"/>
                        <TextBlock Text="{Binding ProgressText}" FontSize="12" Margin="0,6,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource AccentLightBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ① 设备绑定 -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="① 相机" Style="{StaticResource SectionTitleTextStyle}"/>
                        <ComboBox ItemsSource="{Binding CameraDeviceList}" SelectedItem="{Binding SelectedCameraDevice}"
                                  Margin="0,4,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding DeviceKey}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="未发现相机——到『设备管理』登记/扫描后点『🔄 刷新设备』。"
                                   FontSize="11" Foreground="{StaticResource TextDisabledBrush}" TextWrapping="Wrap"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding CameraEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="▶ 连接并预览" Command="{Binding CmdConnect}" Padding="12,4" Margin="0,0,6,6"/>
                            <Button Content="开预览" Command="{Binding CmdStartPreview}" Padding="10,4" Margin="0,0,6,6"/>
                            <Button Content="停预览" Command="{Binding CmdStopPreview}" Padding="10,4" Margin="0,0,6,6"/>
                            <Button Content="📸 抓帧评分" Command="{Binding CmdSnap}" Padding="10,4" Margin="0,0,6,6"/>
                            <Button Content="断开" Command="{Binding CmdDisconnect}" Padding="10,4" Margin="0,0,6,6"/>
                            <Button Content="🔄 刷新设备" Command="{Binding CmdRefreshDevices}" Padding="10,4" Margin="0,0,0,6"/>
                        </WrapPanel>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDisabledBrush}"
                                   Text="预览走连续取流;抓帧/扫描会自动切软触发,做完自动切回预览。"/>
                    </StackPanel>
                </Border>

                <!-- ② 两个体检页签 -->
                <TabControl Margin="0,0,0,10">
                    <!-- ══════ Tab1:垂直度调平 ══════ -->
                    <TabItem Header="📐 垂直度调平">
                        <StackPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="选参照 → 开始 → 看读数" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,6"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="不用走位:单帧里就刻着垂直度。垂直时参照物投影规整,倾斜时呈梯形/单方向压扁。"/>
                                    <ComboBox ItemsSource="{Binding PerpModeNames}" SelectedIndex="{Binding PerpModeIndex}"
                                              IsEnabled="{Binding IsNotGuiding}"/>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{StaticResource TextDisabledBrush}"
                                               Text="A 点阵靶:工面放圆点阵靶(可打印),占画面 ≥50%,最稳;B 矩形边:用工件/治具矩形轮廓;C 正交边:现场两条近正交直线,应急粗调。"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="▶ 开始实时引导" Command="{Binding CmdStartGuide}" Padding="14,5" Margin="0,0,8,0"/>
                                        <Button Content="■ 停止" Command="{Binding CmdStopGuide}" Padding="14,5"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#1AFFFFFF" CornerRadius="4" Padding="8,6" Margin="0,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="俯仰 Rx" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding GuideRxText}" FontSize="24" FontWeight="Bold" Foreground="#FFD98E"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="4" Padding="8,6" Margin="4,0">
                                            <StackPanel>
                                                <TextBlock Text="翻滚 Ry" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding GuideRyText}" FontSize="24" FontWeight="Bold" Foreground="#FFD98E"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#1AFFFFFF" CornerRadius="4" Padding="8,6" Margin="4,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="正交偏差" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding GuideOrthoText}" FontSize="24" FontWeight="Bold" Foreground="#FFD98E"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="#14FFFFFF" CornerRadius="3" Padding="8,6" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding GuideVerdictText}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{Binding GuideVerdictBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Text="{Binding GuideStatusText}" FontSize="11" Margin="0,6,0,0"
                                               Foreground="{StaticResource TextDisabledBrush}"/>

                                    <Expander Style="{StaticResource DarkExpander}" Header="怎么调?(方向提示与读数约定)">
                                        <StackPanel>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="读数取平滑值,手调时只看趋势:一直往小的方向调,调到不再下降就是最小。正=画面下/右更近,现场以试调方向为准。读数压到最小仍下不去(≠0),才怀疑畸变/基准问题。检测不稳时:对焦、让参照充满画面、避开强反光。"/>
                                            <TextBlock Text="{Binding GuideDetailText}" FontSize="11" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" Foreground="{StaticResource TextDisabledBrush}"/>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Style="{StaticResource DarkExpander}" Header="进阶:定量验收(需运动轴)">
                                        <StackPanel>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDisabledBrush}"
                                                       Text="免走位引导是「边调边看」的定性工具;要出与九点标定同口径的数字(两轴当量差/剪切/夹角/RMS),用下面两种。"/>
                                            <TextBlock Text="运动设备 / 轴绑定" Style="{StaticResource FormLabelStyle}" Margin="0,6,0,2"/>
                                            <ComboBox ItemsSource="{Binding MotionDeviceList}" SelectedItem="{Binding SelectedMotionDevice}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding DeviceKey}"/></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="未发现运动/机器人——到『设备管理』登记后点『🔄 刷新设备』。"
                                                       FontSize="11" Foreground="{StaticResource TextDisabledBrush}" TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding MotionEmpty, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <WrapPanel Margin="0,6,0,0">
                                                <TextBlock Text="X轴" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ComboBox Width="46" ItemsSource="{Binding AxisNumbers}" SelectedItem="{Binding BindX}" Margin="0,0,8,0"/>
                                                <TextBlock Text="Y轴" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ComboBox Width="46" ItemsSource="{Binding AxisNumbers}" SelectedItem="{Binding BindY}" Margin="0,0,8,0"/>
                                                <TextBlock Text="Z轴" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ComboBox Width="46" ItemsSource="{Binding AxisNumbers}" SelectedItem="{Binding BindZ}"/>
                                            </WrapPanel>

                                            <Separator Margin="0,8,0,4" Background="{StaticResource BorderBrush}"/>

                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="A · 走位透视比对(无需 Z 轴)"/>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6"
                                                       Foreground="{StaticResource TextDisabledBrush}"
                                                       Text="把 Mark 对到视野中心(不登记就以当前位置为网格原点),程序按网格自动走位拍图,输出与九点标定同口径的体检。相机固定、靶随 XY 台移动亦可。视野需 ≥2×步长。"/>
                                            <WrapPanel Margin="0,0,0,6">
                                                <TextBlock Text="网格:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                                <ComboBox Width="130" ItemsSource="{Binding GridPatterns}" SelectedIndex="{Binding GridPatternIndex}" Margin="0,0,8,0"/>
                                                <TextBlock Text="特征:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                                <ComboBox Width="100" ItemsSource="{Binding FeatureKinds}" SelectedIndex="{Binding FeatureTypeIndex}" Margin="0,0,8,0"/>
                                                <TextBlock Text="步长 mm:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                                <TextBox Width="50" Text="{Binding GridStepText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                            </WrapPanel>
                                            <Button Content="▶ 走位比对" Command="{Binding CmdStartGridCheck}" Padding="12,4" HorizontalAlignment="Left"/>

                                            <Separator Margin="0,10,0,4" Background="{StaticResource BorderBrush}"/>

                                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="B · 三点对焦扫描(检测 → 复测,出倾角与垫厚)"/>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6"
                                                       Foreground="{StaticResource TextDisabledBrush}"
                                                       Text="把靶分别放到视野两侧拉开的位置,每个位置各『登记当前为一点』(≥2 点可算,3 点可同时给左右/前后双向倾角),再扫描:每点自动上下扫 Z 找最清晰位置,三点 Z 一致即垂直。"/>
                                            <WrapPanel Margin="0,0,0,6">
                                                <TextBlock Text="点动步长 mm:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Width="46" Text="{Binding MoveStepText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Content="X−" Command="{Binding CmdMoveXm}" Padding="8,3" Margin="0,0,4,0"/>
                                                <Button Content="X+" Command="{Binding CmdMoveXp}" Padding="8,3" Margin="0,0,4,0"/>
                                                <Button Content="Y−" Command="{Binding CmdMoveYm}" Padding="8,3" Margin="0,0,4,0"/>
                                                <Button Content="Y+" Command="{Binding CmdMoveYp}" Padding="8,3" Margin="0,0,4,0"/>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,0,0,6">
                                                <Button Content="登记当前为一点" Command="{Binding CmdRecordPoint}" Padding="10,3" Margin="0,0,6,0"/>
                                                <Button Content="清空登记" Command="{Binding CmdClearPoints}" Padding="10,3"/>
                                            </WrapPanel>
                                            <ListBox ItemsSource="{Binding Points}" MaxHeight="110" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="2,2">
                                                            <TextBlock FontSize="12" Text="{Binding Name}"/>
                                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="{Binding BestZText, StringFormat=最清晰 Z*: {0} mm}"/>
                                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="{Binding CurveSummary}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <WrapPanel Margin="0,0,0,6">
                                                <TextBlock Text="扫描半程 mm:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Width="46" Text="{Binding ScanRangeText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="步长 mm:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Width="46" Text="{Binding ScanStepText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="容差 mm:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Width="46" Text="{Binding TolText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                            </WrapPanel>
                                            <WrapPanel Margin="0,0,0,6">
                                                <TextBlock Text="安装孔距 mm:" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <TextBox Width="46" Text="{Binding MountText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                            </WrapPanel>
                                            <WrapPanel>
                                                <Button Content="▶ 三点扫描" Command="{Binding CmdStartScan}" Padding="12,5" Margin="0,0,8,0"/>
                                                <Button Content="中止" Command="{Binding CmdStopScan}" Padding="12,5"/>
                                            </WrapPanel>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                                       Foreground="{StaticResource TextDisabledBrush}"
                                                       Text="扫描中请勿移动设备;峰落在扫描端点=范围不够,加大半程。结果进左侧『结论/处方』。"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- ══════ Tab2:成像与打光 ══════ -->
                    <TabItem Header="💡 成像与打光">
                        <StackPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="调光 → 采帧 → 看报告" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Text="工件与打光先就位,画面覆盖工件有效区域(避开夹爪遮挡)。滑杆改动即时下发。"/>
                                    <WrapPanel Margin="0,0,0,4">
                                        <TextBlock Text="曝光" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                        <Slider Width="150" Minimum="100" Maximum="60000" Value="{Binding ExposureUs}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Width="64" Text="{Binding ExposureUs, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="µs" VerticalAlignment="Center" Foreground="{StaticResource TextDisabledBrush}"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <TextBlock Text="增益" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                                        <Slider Width="150" Minimum="0" Maximum="24" Value="{Binding GainVal}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Width="64" Text="{Binding GainVal, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="dB" VerticalAlignment="Center" Foreground="{StaticResource TextDisabledBrush}"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <Button Content="📷 采一帧并评分" Command="{Binding CmdSnapGrade}" Padding="10,4" Margin="0,0,6,0"/>
                                        <Button Content="🧾 生成体检报告" Command="{Binding CmdAnalyzeImaging}" Padding="10,4" Margin="0,0,6,0"/>
                                        <Button Content="重置参数" Command="{Binding CmdResetImagingParams}" Padding="10,4"/>
                                    </WrapPanel>
                                    <Border Background="#1AFFFFFF" CornerRadius="3" Padding="8,5" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding FrameGradeText}" FontSize="12" TextWrapping="Wrap" Foreground="#FFD98E"/>
                                    </Border>
                                    <Expander Style="{StaticResource DarkExpander}" Header="调参小抄 / 判定口径">
                                        <StackPanel>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="亮度均值目标 100~180(≈中灰):过暗→加曝光(优先)或增益,过亮→反之;每改一次就『采一帧并评分』看变化。"/>
                                            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource TextDisabledBrush}"
                                                       Text="判定口径:过曝 ≥245 / 欠曝 ≤10 灰阶占比;均匀性 = 3×3 分块亮度 CV(≤8% 佳);左右/前后差标的是画面方位。过曝区无特征必须消除;暗角/遮挡也会让四角偏暗,先排除再调光。"/>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="体检报告(逐项判定 + 打光处方)" Style="{StaticResource SectionTitleTextStyle}"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding ImagingReportText}" FontSize="12" LineHeight="18" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- ③ 历史与日志(默认收起,不占视线) -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10" Padding="12">
                    <StackPanel>
                        <TextBlock Text="③ 复测历史 / 导出 / 日志" Style="{StaticResource SectionTitleTextStyle}"/>
                        <ListBox ItemsSource="{Binding Runs}" MaxHeight="110" Margin="0,4,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource TextDisabledBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding PassText}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="导出报告(.txt)" Command="{Binding CmdSaveReport}" Padding="10,3" Margin="0,0,8,0"/>
                            <Button Content="清日志" Command="{Binding CmdClearLog}" Padding="10,3"/>
                        </WrapPanel>
                        <Expander Style="{StaticResource DarkExpander}" Header="运行日志">
                            <ListBox ItemsSource="{Binding Logs}" MaxHeight="200" FontSize="11" Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
