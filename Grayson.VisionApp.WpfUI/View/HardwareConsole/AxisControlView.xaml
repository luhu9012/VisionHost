<UserControl x:Class="Grayson.Vision.WpfUI.View.HardwareConsole.AxisControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：板卡筛选、连接控制与参数控制 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="运动控制器选择" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,15"/>

                    <TextBlock Text="目标运动控制器 (板卡):" Style="{StaticResource FormLabelStyle}"/>
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" 
                                  ItemsSource="{Binding MotionDeviceList}" 
                                  DisplayMemberPath="DeviceName" 
                                  SelectedItem="{Binding SelectedMotionDevice}"/>
                        <Button Grid.Column="1" 
                                Content="🔄" 
                                Command="{Binding RefreshDevicesCommand}" 
                                Margin="6,0,0,0" 
                                ToolTip="刷新设备列表" 
                                Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <!-- 连接状态显示与动作按钮组 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="当前状态: " Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>

                    <UniformGrid Columns="2" Margin="0,0,0,15">
                        <Button Content="🔌 连接" Command="{Binding ConnectCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,4,0"/>
                        <Button Content="❌ 断开" Command="{Binding DisconnectCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,0,0,0"/>
                    </UniformGrid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>

                    <!-- 操控轴选择与使能 -->
                    <TextBlock Text="选择操控轴:" Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding AxisList}" DisplayMemberPath="AxisName" SelectedItem="{Binding SelectedAxis}" Margin="0,4,0,10"/>

                    <Button Content="{Binding IsServoOn, StringFormat='⚡ 伺服使能: {0}'}" 
                            Command="{Binding ToggleServoCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Margin="0,0,0,15"/>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>

                    <!-- 运动参数编辑 -->
                    <TextBlock Text="JOG 步长 (mm):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding JogStep, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,15"/>

                    <TextBlock Text="运动速度 (mm/s):" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding AxisSpeed, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,20"/>

                    <Button Content="🏠 选中轴回零 (Home)" Command="{Binding HomeAxisCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右侧：JOG 方向手柄与实时坐标展示 -->
        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏：急停控制 -->
                <DockPanel Grid.Row="0">
                    <TextBlock Text="JOG 点动操控与实时位姿" Style="{StaticResource SubTitleTextStyle}" VerticalAlignment="Center"/>
                    <Button Content="🚨 全轴急停" Command="{Binding EmergencyStopCommand}" Background="#E74C3C" Foreground="White" FontWeight="Bold" Padding="12,6" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- 中间：JOG 点动按键组 -->
                <UniformGrid Grid.Row="1" Columns="3" Rows="3" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border/>
                    <Button Content="Y+ (正向)" Command="{Binding JogCommand}" CommandParameter="Y+" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Border/>

                    <Button Content="X- (负向)" Command="{Binding JogCommand}" CommandParameter="X-" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="🛑 停止" Command="{Binding StopAxisCommand}" Background="#E67E22" Foreground="White" FontWeight="Bold"/>
                    <Button Content="X+ (正向)" Command="{Binding JogCommand}" CommandParameter="X+" Style="{StaticResource PrimaryButtonStyle}"/>

                    <Border/>
                    <Button Content="Y- (负向)" Command="{Binding JogCommand}" CommandParameter="Y-" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Border/>
                </UniformGrid>

                <!-- 底部：坐标展示区 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <TextBlock Text="X轴: " Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Text="{Binding AxisXPos, StringFormat={}{0:F3} mm}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,25,0"/>
                    <TextBlock Text="Y轴: " Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Text="{Binding AxisYPos, StringFormat={}{0:F3} mm}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,25,0"/>
                    <TextBlock Text="Z轴: " Style="{StaticResource FormLabelStyle}"/>
                    <TextBlock Text="{Binding AxisZPos, StringFormat={}{0:F3} mm}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>