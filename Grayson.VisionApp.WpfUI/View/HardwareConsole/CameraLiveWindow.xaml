<Window x:Class="Grayson.Vision.WpfUI.View.HardwareConsole.CameraLiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Grayson.Vision.HalconWrapper.Wpf.Controls;assembly=Grayson.Vision.HalconWrapper.Wpf"
        xmlns:converters="clr-namespace:Grayson.Vision.WpfUI.Common.Converters"
        Title="相机实时画面（轴动监控）"
        Height="620" Width="860" MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- 顶部：相机选择与状态栏 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" Padding="12,8" CornerRadius="6" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="相机设备:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding CameraDeviceList}"
                          SelectedItem="{Binding SelectedCameraDevice}" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DeviceKey}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" Margin="4,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#BDC3C7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLive}" Value="True">
                                        <Setter Property="Fill" Value="#2ECC71"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中部：Halcon 实时图像显示区 -->
        <Border Background="Black" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" ClipToBounds="True">
            <Grid>
                <!-- Halcon 智能窗口渲染宿主：支持滚轮缩放/拖动平移/双击适配 -->
                <controls:HalconImageDisplayHost DataContext="{Binding CameraDisplayVm}"/>

                <!-- 占位提示：仅无实时图像时显示，不拦截鼠标交互 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Panel.ZIndex="10" IsHitTestVisible="False"
                            Visibility="{Binding IsLive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center" Foreground="#444"/>
                    <TextBlock Text="等待相机图像..." HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
