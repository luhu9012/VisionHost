<UserControl x:Class="Grayson.Vision.WpfUI.View.HardwareConsole.IoMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="选择 IO 控制设备:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <!-- 此处绑定的设备源类型建议从 DeviceInfo 改为 IDevice 接口，方便获取设备状态 -->
                <ComboBox Grid.Column="1" ItemsSource="{Binding IoDeviceList}"  SelectedItem="{Binding SelectedIoDevice}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DeviceKey}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- 连接状态指示与控制按钮 (参考通信调试界面) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <!-- 状态灯：绿=已连接，红=未连接 -->
                    <Ellipse Width="12" Height="12" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#DC3545"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="#28A745"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatusText}" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Button Content="⚡ 连接" Command="{Binding ConnectCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,6,0"/>
                    <Button Content="⏹ 断开" Command="{Binding DisconnectCommand}" Style="{StaticResource DangerButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- DI 输入 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0">
                <HeaderedContentControl>
                    <HeaderedContentControl.Header>
                        <TextBlock Text="数字量输入 (DI 点位实时状态)" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                    </HeaderedContentControl.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding InputIOList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="4" Padding="10" Margin="4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="14" Height="14" Margin="0,0,10,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#444444"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </HeaderedContentControl>
            </Border>

            <!-- DO 输出 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0">
                <HeaderedContentControl>
                    <HeaderedContentControl.Header>
                        <TextBlock Text="数字量输出 (DO 强制切换控制)" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                    </HeaderedContentControl.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OutputIOList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="4" Padding="8" Margin="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                                            <!-- 找到 DO 输出部分的 ToggleButton 控件 -->
                                            <ToggleButton Grid.Column="1" 
                                              Content="{Binding StateText}" 
                                              IsChecked="{Binding IsActive, Mode=OneWay}" 
                                              Command="{Binding DataContext.ToggleOutputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding}"
                                              Padding="12,4"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </HeaderedContentControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>