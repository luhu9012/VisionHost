<UserControl x:Class="Grayson.Vision.WpfUI.View.HardwareConsole.RobotDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Grayson.Vision.WpfUI.Common.Converters"
             xmlns:local="clr-namespace:Grayson.Vision.WpfUI.View.HardwareConsole"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <conv:IntToBoolConverter x:Key="IntToBoolConverter"/>

        <!-- 单轴步进 RepeatButton 样式：按下高亮、禁用透明 -->
        <Style x:Key="StepRepeatBtnStyle" TargetType="RepeatButton">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Delay" Value="450"/>
            <Setter Property="Interval" Value="260"/>
            <Setter Property="ToolTip" Value="单击走一步；按住连续微动（松开即停，最多再走一步）"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="0,5">
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：设备连接 + 示教点管理 ==================== -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="机械手设备与示教点" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>

                    <!-- 设备选择 -->
                    <TextBlock Text="目标机械手 (Epson SCARA):" Style="{StaticResource FormLabelStyle}"/>
                    <Grid Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding RobotDeviceList}" SelectedItem="{Binding SelectedRobot}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceKey}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="🔄" Command="{Binding RefreshRobotsCommand}"
                                Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>

                    <!-- 状态与连接 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="当前状态: " Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding ConnectionStatusText}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="通信通道: " Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding TransportText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>

                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <Button Content="⚡ 连接" Command="{Binding ConnectCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="⏹ 断开" Command="{Binding DisconnectCommand}" Style="{StaticResource DangerButtonStyle}"/>
                    </UniformGrid>

                    <!-- 机器人操作按钮组 -->
                    <UniformGrid Columns="3" Margin="0,8,0,10">
                        <Button Content="🔌 伺服" Command="{Binding ToggleServoCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"
                                ToolTip="{Binding IsServoOn, StringFormat='伺服当前: {0}'}"/>
                        <Button Content="🏠 Home" Command="{Binding HomeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0"/>
                        <Button Content="🛑 停止" Command="{Binding StopCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </UniformGrid>
                    <Button Content="🚨 全轴急停" Command="{Binding EmergencyStopCommand}"
                            Background="#E74C3C" Foreground="White" FontWeight="Bold" Padding="12,6"
                            HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,10"/>

                    <!-- 示教点管理 -->
                    <TextBlock Text="示教点管理 (为工位业务流准备点位)" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding TeachPointName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="示教点名称（留空自动编号，同名覆盖）"/>
                        <Button Grid.Column="1" Content="📌 存当前点" Command="{Binding SaveTeachPointCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0"/>
                    </Grid>

                    <ListBox ItemsSource="{Binding TeachPoints}" SelectedItem="{Binding SelectedTeachPoint}"
                             MaxHeight="220" Margin="0,0,0,8"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="4"
                                        Padding="10,7" Margin="0,0,0,6"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <UniformGrid Columns="2">
                        <Button Content="▶️ 回放走位" Command="{Binding PlayTeachPointCommand}"
                                Style="{StaticResource SuccessButtonStyle}" Margin="0,0,6,0"/>
                        <Button Content="🗑️ 删除" Command="{Binding DeleteTeachPointCommand}"
                                Style="{StaticResource DangerButtonStyle}"/>
                    </UniformGrid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,10"/>

                    <!-- RC+ 示教点同步（只读，2026-09-11） -->
                    <TextBlock Text="RC+ 示教点同步 (只读, 直接读控制器点文件)"
                               Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="前 N 个点号:" Style="{StaticResource FormLabelStyle}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Margin="8,0"
                                 Text="{Binding RcPointCountText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="从 P0 起算，1~100。读取只访问控制器点文件，不驱动机械手"/>
                        <Button Grid.Column="2" Content="⬇️ 读取" Command="{Binding LoadRcPointsCommand}"
                                Style="{StaticResource SuccessButtonStyle}"/>
                    </Grid>

                    <ListBox ItemsSource="{Binding RcPoints}" SelectedItem="{Binding SelectedRcPoint}"
                             MaxHeight="200" Margin="0,0,0,8"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="4"
                                        Padding="10,7" Margin="0,0,0,6"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <!-- 占位行（未定义/读取失败）标红加斜体：一眼看出"哪个点没读到"，
                                         而不是整张表少几行让人以为同步成功 -->
                                    <TextBlock Text="{Binding}" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnreadable}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        <Setter Property="FontStyle" Value="Italic"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{Binding RcPointsStatusText}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <UniformGrid Columns="2">
                        <Button Content="▶️ 回放走位" Command="{Binding PlayRcPointCommand}"
                                Style="{StaticResource SuccessButtonStyle}" Margin="0,0,6,0"
                                ToolTip="把选中的 RC+ 点位写入目标框并走位（与手动走位同链路）"/>
                        <Button Content="📥 并入示教点" Command="{Binding ImportRcPointsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="批量并入上方示教点列表（同名覆盖，落盘供业务流消费）"/>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== 右侧：坐标监视 + 走位控制 + 真空阀 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部：四轴坐标监视 -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📷 相机画面" Command="{Binding ShowCameraLiveCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" Margin="0,0,12,0"
                                    ToolTip="打开相机实时画面（非模态），机械手运动时可同步观察视角"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                                <Ellipse Width="12" Height="12" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#BDC3C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMoving}" Value="True">
                                                    <Setter Property="Fill" Value="#3498DB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="运行中" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="12" Height="12" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#DC3545"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServoOn}" Value="True">
                                                    <Setter Property="Fill" Value="#28A745"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding IsServoOn, StringFormat='伺服: {0}'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="四轴实时坐标 (X / Y / Z / U)" Style="{StaticResource SubTitleTextStyle}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Border Background="#FF1A1A1A" Padding="12" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="X (大臂, mm)" Foreground="#7F8C8D" FontSize="12"/>
                                <TextBlock Text="{Binding PosX, StringFormat={}{0:F2}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Y (小臂, mm)" Foreground="#7F8C8D" FontSize="12"/>
                                <TextBlock Text="{Binding PosY, StringFormat={}{0:F2}}" FontSize="20" FontWeight="Bold" Foreground="#27AE60"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Z (吸嘴, mm)" Foreground="#7F8C8D" FontSize="12"/>
                                <TextBlock Text="{Binding PosZ, StringFormat={}{0:F2}}" FontSize="20" FontWeight="Bold" Foreground="#E67E22"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="U (旋转, deg)" Foreground="#7F8C8D" FontSize="12"/>
                                <TextBlock Text="{Binding PosU, StringFormat={}{0:F2}}" FontSize="20" FontWeight="Bold" Foreground="#8E44AD"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ★ 单轴步进（2026-09-02 引入；09-06 改遥控器式键位）：单击单步 / 按住连续微动（RepeatButton），
                         沿笛卡尔轴相对走位（X/Y/Z/U 槽位 0~3），每步经脚本 SafeGo 安全钳位；
                         Z 行程 -150~0（Home 顶端 Z≈0、向下为负）：上行截断到顶端 / 到底拒绝（VM 钳位） -->
                    <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="单轴步进（单击单步 / 按住连续）" Style="{StaticResource SubTitleTextStyle}" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="步长 (mm/°):" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Width="72" Style="{StaticResource ModernComboBoxStyle}"
                                              ItemsSource="{Binding StepSizeOptions}"
                                              SelectedItem="{Binding SelectedStepSize}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                            <!-- 键位 = 示教遥控器式：左 3×3 十字方向键（X/Y 平面走位）＋右 Z/U 键组 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="78"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="46"/>
                                        <RowDefinition Height="46"/>
                                        <RowDefinition Height="46"/>
                                    </Grid.RowDefinitions>

                                    <RepeatButton Grid.Row="0" Grid.Column="1" Content="▲ Y+"
                                                  Command="{Binding StepAxisCommand}" CommandParameter="Y+"
                                                  Background="#27AE60" Style="{StaticResource StepRepeatBtnStyle}"
                                                  ToolTip="Y+ 正向微动（示教遥控：上键）"/>
                                    <RepeatButton Grid.Row="1" Grid.Column="0" Content="◀ X−"
                                                  Command="{Binding StepAxisCommand}" CommandParameter="X-"
                                                  Background="#3498DB" Style="{StaticResource StepRepeatBtnStyle}"
                                                  ToolTip="X− 负向微动（示教遥控：左键）"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="X / Y"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                    <RepeatButton Grid.Row="1" Grid.Column="2" Content="X+ ▶"
                                                  Command="{Binding StepAxisCommand}" CommandParameter="X+"
                                                  Background="#3498DB" Style="{StaticResource StepRepeatBtnStyle}"
                                                  ToolTip="X+ 正向微动（示教遥控：右键）"/>
                                    <RepeatButton Grid.Row="2" Grid.Column="1" Content="▼ Y−"
                                                  Command="{Binding StepAxisCommand}" CommandParameter="Y-"
                                                  Background="#27AE60" Style="{StaticResource StepRepeatBtnStyle}"
                                                  ToolTip="Y− 负向微动（示教遥控：下键）"/>
                                </Grid>

                                <Border Width="1" Background="{StaticResource BorderBrush}" Height="88" Margin="16,2"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="72"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="46"/>
                                        <RowDefinition Height="46"/>
                                    </Grid.RowDefinitions>

                                    <RepeatButton Grid.Row="0" Grid.Column="0" Content="▲ Z+"
                                                  Command="{Binding StepAxisCommand}" CommandParameter="Z+"
                                                  Background="#E67E22" Style="{StaticResource StepRepeatBtnStyle}"
                                                  ToolTip="Z+ 上行（至顶端 0mm 自动截断，防撞顶）"/>
                                    <RepeatButton Grid.Row="1" Grid.Column="0" Content="▼ Z−"
                                                  Command="{Binding StepAxisCommand}" CommandParameter="Z-"
                                                  Background="#E67E22" Style="{StaticResource StepRepeatBtnStyle}"
                                                  ToolTip="Z− 下行（到底端 -150mm 自动截断）"/>
                                    <RepeatButton Grid.Row="0" Grid.Column="1" Content="U+"
                                                  Command="{Binding StepAxisCommand}" CommandParameter="U+"
                                                  Background="#8E44AD" Style="{StaticResource StepRepeatBtnStyle}"
                                                  ToolTip="U+ 正向旋转（角度增大）"/>
                                    <RepeatButton Grid.Row="1" Grid.Column="1" Content="U−"
                                                  Command="{Binding StepAxisCommand}" CommandParameter="U-"
                                                  Background="#8E44AD" Style="{StaticResource StepRepeatBtnStyle}"
                                                  ToolTip="U− 反向旋转（角度减小）"/>
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{Binding LastAxisStepText}" Foreground="{StaticResource TextDisabledBrush}"
                                       FontSize="11" Margin="2,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastAxisStepText}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== 底部：可滚动工作区（可达域画布 + 走位 + 真空阀） ==================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>

                <!-- ★ 可达域与九点预演（2026-09-11 新增）
                     画的是【实测】可达域（不是理想圆环），绿色区域 = 九点全部安全的基准位集合。
                     把基准位拖进绿区，标定走位就不会再撞机 / 被控制器拒绝。 -->
                <local:RobotReachMapView Margin="0,0,0,12"/>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- 走位面板 -->
                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0" Padding="14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="整点走位" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="模式: " Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                                <RadioButton Content="PTP (Go)" IsChecked="{Binding MoveModeIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                                             GroupName="RobotMoveMode" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton Content="CP (Move)" IsChecked="{Binding MoveModeIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                                             GroupName="RobotMoveMode" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>

                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <StackPanel Margin="2,4">
                                <TextBlock Text="目标 X:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding TargetX, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="目标 Y:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding TargetY, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="目标 Z:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding TargetZ, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="目标 U:" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding TargetU, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="速度 (mm/s):" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding SpeedPct, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <TextBlock Text="（TCP 模式钳位 1~100；RC+ SDK 模式直接下发）" Style="{StaticResource FormLabelStyle}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextDisabledBrush}"/>
                        </StackPanel>

                        <Button Content="🎯 走位到目标点" Command="{Binding MoveToPointCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Height="38" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- 真空阀测试 -->
                <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="真空阀测试 (双吸嘴)" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,4"/>
                        <TextBlock Text="吸嘴1 = SPEL+ OUT15 / 吸嘴2 = SPEL+ OUT14（单吸嘴机型仅吸嘴1）"
                                   Style="{StaticResource FormLabelStyle}" Foreground="{StaticResource TextDisabledBrush}" Margin="0,0,0,12"/>

                        <Button Content="{Binding Vaccum1On, StringFormat='吸嘴1 真空: {0}'}"
                                Command="{Binding ToggleVaccum1Command}" Height="44" FontSize="14" FontWeight="Bold" Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Vaccum1On}" Value="True">
                                            <Setter Property="Background" Value="#2ECC71"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{Binding Vaccum2On, StringFormat='吸嘴2 真空: {0}'}"
                                Command="{Binding ToggleVaccum2Command}" Height="44" FontSize="14" FontWeight="Bold">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Vaccum2On}" Value="True">
                                            <Setter Property="Background" Value="#2ECC71"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
                </Grid>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
