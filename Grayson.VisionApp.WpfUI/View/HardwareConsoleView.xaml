<UserControl x:Class="Grayson.Vision.WpfUI.View.HardwareConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Grayson.Vision.WpfUI.Common.Converters"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!-- 核心修复：基于全局深色样式 ModernDataGridColumnHeaderStyle 继承，确保背景依然是深色，同时重置对齐 -->
        <Style x:Key="LeftAlignedHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="8,0,8,0"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource BackgroundBrush}">
            <TabControl Style="{StaticResource ModernTabControlStyle}">

                <!-- 1. 相机调测 Panel -->
            <TabItem Header="📷 相机调试" Style="{StaticResource ModernTabItemStyle}">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：图像渲染与抓拍展示区域 -->
                    <Border Grid.Column="0" Background="Black" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <Grid>
                            <Image Source="{Binding CameraImageSource}" Stretch="Uniform"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" 
                            Visibility="{Binding IsGrabbing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                                <TextBlock Text="📷" FontSize="48" HorizontalAlignment="Center" Foreground="#444"/>
                                <TextBlock Text="相机未开流或无实时图像信号" Foreground="{StaticResource TextDisabledBrush}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右侧：完整控制与参数设置面板 -->
                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="相机设备控制台" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>

                                <!-- 1. 选择相机设备 -->
                                <TextBlock Text="目标相机设备 (设备池):" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding CameraDeviceList}" DisplayMemberPath="DeviceKey" SelectedItem="{Binding SelectedCameraDevice}" Margin="0,4,0,10"/>

                                <!-- 2. 连接与断开控制栏 -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="⚡ 连接相机" Command="{Binding ConnectCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,4,0"/>
                                    <Button Grid.Column="1" Content="⏹ 断开连接" Command="{Binding DisconnectCommand}" Style="{StaticResource DangerButtonStyle}" Margin="4,0,0,0"/>
                                </Grid>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                                <!-- 3. 常见采集与光学参数调整 -->
                                <TextBlock Text="曝光时间 (us):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ExposureTime, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,10"/>

                                <TextBlock Text="增益 (Gain):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding GainValue, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,10"/>

                                <!-- 4. 触发模式选择 -->
                                <TextBlock Text="触发模式 (Trigger Mode):" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox SelectedIndex="{Binding SelectedTriggerMode}" Style="{StaticResource ModernComboBoxStyle}" Margin="0,4,0,10">
                                    <ComboBoxItem Content="0 - 连续采集 (Free Run)"/>
                                    <ComboBoxItem Content="1 - 软触发模式 (Software)"/>
                                    <ComboBoxItem Content="2 - 硬件外触发 (Line0)"/>
                                </ComboBox>

                                <TextBlock Text="目标帧率 (AcquisitionFrameRate / fps):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding AcquisitionFrameRate, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,10"/>

                                <!--<TextBlock Text="实际帧率 (ResultingFrameRate / fps):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox IsReadOnly="True" IsTabStop="False" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ResultingFrameRate, Mode=OneWay}" Margin="0,4,0,10"/>

                                <TextBlock Text="分辨率 (Width x Height):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox IsReadOnly="True" IsTabStop="False" Style="{StaticResource ModernTextBoxStyle}" Margin="0,4,0,10">
                                    <TextBox.Text>
                                        <MultiBinding StringFormat="{}{0} x {1}">
                                            <Binding Path="ImageWidth" Mode="OneWay"/>
                                            <Binding Path="ImageHeight" Mode="OneWay"/>
                                        </MultiBinding>
                                    </TextBox.Text>
                                </TextBox>-->

                                <TextBlock Text="像素格式 (PixelFormat):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox IsReadOnly="True" IsTabStop="False" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PixelFormat, Mode=OneWay}" Margin="0,4,0,15"/>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>

                                <!-- 5. 采集流程控制 -->
                                <Button Content="▶ 开启连续采集" Command="{Binding StartGrabCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,0,8"/>
                                <Button Content="⏹ 停止采集" Command="{Binding StopGrabCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,0,8"/>
                                <Button Content="⚡ 软触发一次 (SoftTrigger)" Command="{Binding SoftwareTriggerCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,10"/>

                                <!-- 6. 保存当前帧图像 -->
                                <TextBlock Text="保存当前帧:" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="BMP" Command="{Binding SaveImageCommand}" CommandParameter="bmp" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,3,0"/>
                                    <Button Grid.Column="1" Content="JPG" Command="{Binding SaveImageCommand}" CommandParameter="jpg" Style="{StaticResource SecondaryButtonStyle}" Margin="3,0,3,0"/>
                                    <Button Grid.Column="2" Content="PNG" Command="{Binding SaveImageCommand}" CommandParameter="png" Style="{StaticResource SecondaryButtonStyle}" Margin="3,0,3,0"/>
                                    <Button Grid.Column="3" Content="TIF" Command="{Binding SaveImageCommand}" CommandParameter="tif" Style="{StaticResource SecondaryButtonStyle}" Margin="3,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <!-- 2. 运动控制轴 Panel -->
                <TabItem Header="⚙️ 轴点动调试" Style="{StaticResource ModernTabItemStyle}">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：控制器设备选择与轴选择 -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="运动控制器选择" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,15"/>

                                <!-- 1. 选择运动控制卡设备 -->
                                <TextBlock Text="目标运动控制器 (板卡):" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding MotionDeviceList}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedMotionDevice}" Margin="0,4,0,15"/>

                                <!-- 2. 选中控制器下的具体轴 -->
                                <TextBlock Text="选择操控轴:" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding AxisList}" DisplayMemberPath="AxisName" SelectedItem="{Binding SelectedAxis}" Margin="0,4,0,15"/>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>

                                <TextBlock Text="JOG 步长 (mm):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding JogStep}" Margin="0,4,0,15"/>

                                <TextBlock Text="运动速度 (mm/s):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding AxisSpeed}" Margin="0,4,0,20"/>

                                <Button Content="🏠 选中轴回零 (Home)" Command="{Binding HomeAxisCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>

                        <!-- 右侧：JOG 方向手柄与坐标反馈 -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="JOG 点动操控与实时位姿" Style="{StaticResource SubTitleTextStyle}"/>

                                <!-- 点动控制按钮九宫格 -->
                                <UniformGrid Grid.Row="1" Columns="3" Rows="3" Width="300" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border/>
                                    <Button Content="Y+ (正向)" Command="{Binding JogCommand}" CommandParameter="Y+" Style="{StaticResource PrimaryButtonStyle}"/>
                                    <Border/>

                                    <Button Content="X- (负向)" Command="{Binding JogCommand}" CommandParameter="X-" Style="{StaticResource PrimaryButtonStyle}"/>
                                    <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="150" Margin="10">
                                        <TextBlock Text="JOG" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold"/>
                                    </Border>
                                    <Button Content="X+ (正向)" Command="{Binding JogCommand}" CommandParameter="X+" Style="{StaticResource PrimaryButtonStyle}"/>

                                    <Border/>
                                    <Button Content="Y- (负向)" Command="{Binding JogCommand}" CommandParameter="Y-" Style="{StaticResource PrimaryButtonStyle}"/>
                                    <Border/>
                                </UniformGrid>

                                <!-- 坐标反馈 -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                    <TextBlock Text="X轴: " Style="{StaticResource FormLabelStyle}"/>
                                    <TextBlock Text="{Binding AxisXPos, StringFormat={}{0:F3} mm}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,25,0"/>
                                    <TextBlock Text="Y轴: " Style="{StaticResource FormLabelStyle}"/>
                                    <TextBlock Text="{Binding AxisYPos, StringFormat={}{0:F3} mm}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,0,25,0"/>
                                    <TextBlock Text="Z轴: " Style="{StaticResource FormLabelStyle}"/>
                                    <TextBlock Text="{Binding AxisZPos, StringFormat={}{0:F3} mm}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

            <!-- 3. 数字量 IO 监视 Panel (完善版) -->
            <TabItem Header="🔌 数字量 IO 监视" Style="{StaticResource ModernTabItemStyle}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部：选择 IO 板卡设备 -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="选择 IO 控制设备 (设备池):" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding IoDeviceList}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedIoDevice}" Width="320" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 下方：IO 点位矩阵 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 数字量输入 (DI 状态) -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0">
                            <HeaderedContentControl>
                                <HeaderedContentControl.Header>
                                    <TextBlock Text="数字量输入 (DI 点位实时状态)" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                                </HeaderedContentControl.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding InputIOList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="4" Padding="10" Margin="4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="14" Height="14" Margin="0,0,10,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="#444444"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </HeaderedContentControl>
                        </Border>

                        <!-- 数字量输出 (DO 手动切换) -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0">
                            <HeaderedContentControl>
                                <HeaderedContentControl.Header>
                                    <TextBlock Text="数字量输出 (DO 强制切换控制)" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                                </HeaderedContentControl.Header>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding OutputIOList}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="4" Padding="8" Margin="4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                                                        <ToggleButton Grid.Column="1" Content="{Binding StateText}" IsChecked="{Binding IsActive, Mode=TwoWay}" Padding="12,4"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </HeaderedContentControl>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 4. 新增：通信调试与报文监视 Panel -->
            <TabItem Header="📡 通信调测" Style="{StaticResource ModernTabItemStyle}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部：设备选择与日志控制操作栏 -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="目标通信设备:" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AllCommunicationDevices}" DisplayMemberPath="DeviceKey" SelectedItem="{Binding SelectedCommDevice}"/>

                            <Button Grid.Column="3" Content="🗑 清空通信日志" Command="{Binding ClearCommLogCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                    </Border>

                    <!-- 中间：通信数据收发明细表 -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="0">
                        <DataGrid ItemsSource="{Binding CommLogs}" AutoGenerateColumns="False" IsReadOnly="True"  ColumnHeaderStyle="{StaticResource LeftAlignedHeaderStyle}"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Width="110"/>
                                <DataGridTemplateColumn Header="方向" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="4,2" HorizontalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#222"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Direction}" Value="TX">
                                                                <Setter Property="Background" Value="#007ACC"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Direction}" Value="RX">
                                                                <Setter Property="Background" Value="#28A745"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Direction}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="报文内容 / 命令" Binding="{Binding Content}" Width="*"/>
                                <DataGridTextColumn Header="备注/状态" Binding="{Binding Remark}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- 底部：结构化调试控制台（易用、明确） -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. 指令类型 -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="操作类型:" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding CommandTypeList}" SelectedItem="{Binding SelectedCmdType}"/>
                            </StackPanel>

                            <!-- 2. 寄存器地址 -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="地址 (Address):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding TargetAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- 3. 写入值（仅写入操作有效） -->
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="写入值 (Value):" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding WriteValue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </StackPanel>

                            <!-- 4. 调试执行说明 -->
                            <TextBlock Grid.Column="3" Text="提示：点击发送将直接调用具体驱动的 Read/Write 方法并在上方观察报文" 
                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,15,10,0"/>

                            <!-- 5. 发送按钮 -->
                            <Button Grid.Column="4" Content="⚡ 执行" Command="{Binding SendCustomRawCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
        </Grid>
    </UserControl>