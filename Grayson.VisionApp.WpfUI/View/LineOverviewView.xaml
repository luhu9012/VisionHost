<UserControl x:Class="Grayson.Vision.WpfUI.View.LineOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Grayson.Vision.WpfUI.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">
    <Grid Background="{StaticResource BackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部标题与切换工具栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="📊 产线拓扑总览" Style="{StaticResource TitleTextStyle}" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Style="{StaticResource CardBorderStyle}" Padding="2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="📊 统计卡片" Command="{Binding ToggleViewModeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,4,0" Padding="12,5"/>
                        <Button Content="🖼 缩略图监控" Command="{Binding ToggleViewModeCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"/>
                    </StackPanel>
                </Border>

                <ComboBox Width="180" Margin="0,0,8,0"
                          Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding Lines}" 
                          SelectedItem="{Binding SelectedLine}"/>
                <Button Content="🔄 刷新" Style="{StaticResource PrimaryButtonStyle}" 
                        Padding="14,6" Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 2. 提示说明 -->
        <TextBlock Grid.Row="2" 
                   Text="提示：双击卡片可直接进入单工位实时监控；缩略图模式下维持标准图像比例。" 
                   Style="{StaticResource BodyTextStyle}" 
                   Foreground="{StaticResource TextDisabledBrush}"/>

        <!-- 3. 卡片自适应网格 -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding StationCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GridColumns, FallbackValue=3}" VerticalAlignment="Top"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MinHeight="260" Margin="8" 
                                VerticalAlignment="Top"
                                Style="{StaticResource CardBorderStyle}" 
                                Background="{StaticResource SurfaceBrush}"
                                MouseLeftButtonDown="CardBorder_MouseLeftButtonDown"
                                MouseLeftButtonUp="CardBorder_MouseLeftButtonUp">
                            <Border.InputBindings>
                                <MouseBinding Gesture="LeftDoubleClick" 
                                              Command="{Binding DataContext.MonitorStationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                              CommandParameter="{Binding}"/>
                            </Border.InputBindings>
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 标题栏 -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StationName}" Style="{StaticResource SubTitleTextStyle}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <Ellipse Grid.Column="1" Width="14" Height="14" Fill="{Binding StateBrushKey, FallbackValue={StaticResource TextDisabledBrush}}" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Grid.Row="1" Text="{Binding StationCode, StringFormat='编号: {0}'}" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>

                                <!-- 中间展现区：显式声明 x:Name 供 Trigger 查找 -->
                                <Grid Grid.Row="2" Margin="0,12" MinHeight="160">
                                    <!-- A. 统计视图 -->
                                    <Grid x:Name="CompactView" Visibility="Visible" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <TextBlock Text="总数" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextDisabledBrush}"/>
                                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource SubTitleTextStyle}" FontSize="24" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <TextBlock Text="OK" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextDisabledBrush}"/>
                                            <TextBlock Text="{Binding OkCount}" Style="{StaticResource SubTitleTextStyle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock Text="NG" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource TextDisabledBrush}"/>
                                            <TextBlock Text="{Binding NgCount}" Style="{StaticResource SubTitleTextStyle}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- B. 缩略图视图 -->
                                    <Border x:Name="ThumbnailView" Visibility="Collapsed" Background="#0A0A0A" CornerRadius="4" ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding LatestThumbnail}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtWaiting" 
                                                       Text="等待图像信号..." 
                                                       Style="{StaticResource CaptionTextStyle}" 
                                                       Foreground="{StaticResource TextDisabledBrush}" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" 
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- 底部信息 -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource BodyTextStyle}" FontWeight="Bold" FontSize="14" Foreground="{Binding StateBrushKey, FallbackValue={StaticResource TextDisabledBrush}}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding YieldText, StringFormat='良率: {0}'}" Style="{StaticResource BodyTextStyle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- DataTemplate 触发器配置 -->
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="{x:Static vm:CardViewMode.Thumbnail}">
                                <Setter TargetName="CompactView" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ThumbnailView" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LatestThumbnail}" Value="{x:Null}">
                                <Setter TargetName="TxtWaiting" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>