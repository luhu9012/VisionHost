<UserControl x:Class="Grayson.VisionApp.WpfUI.View.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Grayson.VisionApp.WpfUI.View"
             xmlns:conv="clr-namespace:Grayson.Vision.WpfUI.Common.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="0,0,-92,-18">
        <!-- 背景装饰 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="0"/>
                <GradientStop Color="{StaticResource BackgroundColor}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 左侧装饰面板 -->
        <Grid HorizontalAlignment="Left" Width="400">
            <StackPanel VerticalAlignment="Center" Margin="60,0,37,0">
                <TextBlock Text="工业视觉上位机系统" 
                           Style="{StaticResource TitleTextStyle}"
                           FontSize="32"
                           Foreground="White" Width="288"/>
                <TextBlock Text="Grayson Vision Application" 
                           FontSize="18"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,10,0,0"/>
                <TextBlock Text="智能检测 · 精准控制 · 高效生产" 
                           FontSize="14"
                           Foreground="{StaticResource AccentLightBrush}"
                           Margin="0,40,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 右侧登录卡片 -->
        <Border Width="400" Height="500"
                HorizontalAlignment="Right"
                Margin="0,0,100,0"
                Background="{StaticResource BackgroundCardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="8" BlurRadius="20"/>
            </Border.Effect>

            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="系统登录" 
                               Style="{StaticResource SubTitleTextStyle}"
                               FontSize="24"
                               HorizontalAlignment="Center"/>
                    <Rectangle Height="2" 
                               Fill="{StaticResource AccentBrush}"
                               Margin="0,15,0,0"
                               Width="60"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 登录表单 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Height="334" Margin="0,0,10,0">
                    <!-- 用户名 -->
                    <TextBlock Text="用户名" Margin="0,20,0,8"/>
                    <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="40"
                             FontSize="16" FontFamily="Microsoft YaHei UI" Padding="0,0,0,0"/>

                    <!-- 密码 -->
                    <TextBlock Text="密码" Margin="0,20,0,8"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 Height="40"
                                 FontSize="14"
                                 PasswordChanged="PasswordBox_PasswordChanged" Padding="0,0,0,0"/>

                    <!-- 记住密码 -->
                    <CheckBox Content="记住密码"
                              IsChecked="{Binding RememberPassword}"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              Margin="0,15,0,0"/>

                    <!-- 错误消息 -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               TextWrapping="Wrap"
                               Margin="0,15,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToBoolConverter}, ConverterParameter=False}"/>

                    <!-- 登录按钮 -->
                    <Button Content="登录"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="45"
                            FontSize="16"
                            Margin="0,30,0,0"
                            IsEnabled="{Binding IsLoggingIn, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

                    <!-- 加载指示-->
                    <TextBlock Text="正在登录..."
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"
                               Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <!-- 底部信息 -->
                <StackPanel Grid.Row="2">
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12">
                        <Run Text="默认账号:"/>
                        <LineBreak/>
                        <Run Text="admin/admin123 (管理员)"/>
                        <LineBreak/>
                        <Run Text="engineer/eng123 (工程师)"/>
                        <LineBreak/>
                        <Run Text="operator/op123 (操作员)"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 版本信息 -->
        <TextBlock Text="Version 1.0.0 | Copyright © 2026 Grayson.VisionApp"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,20"/>
    </Grid>
</UserControl>
