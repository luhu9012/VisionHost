<Window x:Class="Grayson.Vision.WpfUI.View.ModelAssetEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="{Binding WindowTitle}" Height="640" Width="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource SubTitleTextStyle}"/>
            <TextBlock Text="注册深度学习推理资产的元数据；文件本体请放置于运行目录 Config\Models\{AssetCode}\ 下。"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="资产代码：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding AssetCodeText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Center"
                                     ToolTip="唯一；切换模型种类时自动按新种类生成（MDL-DET/SEG/CLS/ANO-###）"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模型名称：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Center"
                                     ToolTip="如：PCB缺陷YOLOv8s / 电池极片异常-分类"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="模型种类：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding ModelKindOptions}" SelectedItem="{Binding SelectedKind}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="框架：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding FrameworkOptions}" SelectedItem="{Binding SelectedFramework}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="状态：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"/>
                        </Grid>
                        <DockPanel>
                            <TextBlock Text="模型文件：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="选择文件…" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnPickFile"/>
                            <TextBox Text="{Binding FileNameText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding FileHintText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="输入规格：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding InputSpecText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Center"
                                     ToolTip="如 1x3x640x640 RGB"/>
                            <TextBlock Grid.Column="3" Text="默认阈值：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4" Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Center"
                                     ToolTip="0~1，任务模板引用时作为默认置信度门槛"/>
                        </Grid>
                        <TextBlock Text="类别表（逗号分隔）：" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ClassNamesText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" Height="46"
                                 ToolTip="检测/分割/分类模型输出类别；异常检测可留空"/>
                        <TextBlock Text="关键指标：" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding MetricsText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" Height="34"
                                 ToolTip="如 mAP50 0.923 / Acc 0.995（训练端产出回填）"/>
                        <TextBlock Text="备注（来源/训练说明）：" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,4"/>
                        <TextBox Text="{Binding RemarkText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap" Height="46"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Padding="18,7" Margin="0,0,10,0" Click="OnCancel"/>
            <Button Content="保存资产" Style="{StaticResource PrimaryButtonStyle}" Padding="22,7" Click="OnSave"/>
        </StackPanel>
    </Grid>
</Window>
