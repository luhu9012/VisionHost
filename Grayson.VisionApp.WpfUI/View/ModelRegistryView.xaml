<UserControl x:Class="Grayson.Vision.WpfUI.View.ModelRegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1180"
             Foreground="{DynamicResource TextPrimaryBrush}">

    <DockPanel Margin="12">
        <!-- ===== 页头 ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 刷新" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"
                            Margin="6,0,0,0" Command="{Binding RefreshCommand}"/>
                    <Button Content="🗑 删除" Style="{StaticResource DangerButtonStyle}" Padding="12,5"
                            Margin="6,0,0,0" Command="{Binding DeleteCommand}" ToolTip="删除注册信息（不动模型文件）"/>
                    <Button Content="✏️ 编辑" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"
                            Margin="6,0,0,0" Command="{Binding EditCommand}"/>
                    <Button Content="＋ 注册模型" Style="{StaticResource PrimaryButtonStyle}" Padding="14,5"
                            Margin="6,0,0,0" Command="{Binding NewCommand}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🧠 模型仓库" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="深度学习/测量任务的推理资产注册中心（ONNX / HALCON DLTool）—— 任务模板中心按 ModelAssetCode 引用，推理经 Plugins.Inference.OnnxRuntime 执行"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 统计 + 搜索 ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#228F7BF2" CornerRadius="10" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock Text="{Binding TotalCount, StringFormat=模型总数：{0}}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#1E43B781" CornerRadius="10" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ReadyCount, StringFormat=就绪可用：{0}}" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="搜索：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                    <TextBox Width="280" Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按代码 / 名称 / 备注模糊搜索"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 列表 ===== -->
        <DataGrid Style="{StaticResource ModernDataGridStyle}"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="34" FontSize="12.5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="资产代码" Binding="{Binding Code}" Width="110"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="190"/>
                <DataGridTextColumn Header="模型种类" Binding="{Binding KindText}" Width="100"/>
                <DataGridTextColumn Header="框架" Binding="{Binding FrameworkText}" Width="110"/>
                <DataGridTextColumn Header="输入规格" Binding="{Binding InputSpec}" Width="110"/>
                <DataGridTextColumn Header="类别" Binding="{Binding ClassSummary}" Width="170"/>
                <DataGridTextColumn Header="指标" Binding="{Binding Metrics}" Width="140"/>
                <DataGridTemplateColumn Header="文件" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileMark}" FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#E8716B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Asset.IsFileInLibrary}" Value="True">
                                                    <Setter Property="Foreground" Value="#43B781"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding FileName}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="#A8B3C0" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="64"/>
                <DataGridTextColumn Header="更新" Binding="{Binding UpdatedText}" Width="78"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
