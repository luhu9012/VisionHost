<UserControl x:Class="Grayson.Vision.WpfUI.View.PluginManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="650" d:DesignWidth="1050">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部 Header 标题与操作栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🧩" FontSize="22" Margin="0,0,10,0"/>
                <TextBlock Text="驱动插件管理" Style="{StaticResource TitleTextStyle}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- 搜索过滤框 -->
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernTextBoxStyle}" Width="220" Height="34" Margin="0,0,12,0" 
                         VerticalContentAlignment="Center"
                         ToolTip="输入名称、DeviceId、品牌进行过滤..."/>

                <Button Content="🔄 重新扫描插件目录" Command="{Binding ScanPluginsCommand}" 
                        Style="{StaticResource PrimaryButtonStyle}" Height="34"/>
            </StackPanel>
        </Grid>

        <!-- 2. 插件统计汇总卡片 -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📦" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="插件总数" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding TotalCount}" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,0" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📷" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="相机驱动" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding CameraCount}" Foreground="{StaticResource SuccessBrush}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,0" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📟" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PLC 驱动" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding PlcCount}" Foreground="{StaticResource InfoBrush}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚙️" FontSize="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="运动控制驱动" Style="{StaticResource FormLabelStyle}"/>
                        <TextBlock Text="{Binding MotionCount}" Foreground="{StaticResource WarningBrush}" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 3. 主驱动列表表格 DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding LoadedPlugins}" SelectedItem="{Binding SelectedPlugin}"
                  Style="{StaticResource ModernDataGridStyle}">
            <DataGrid.Columns>
                <!-- 设备类别图标与文本 -->
                <DataGridTemplateColumn Header="类别" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0">
                                <TextBlock Text="{Binding CategoryIcon}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding CategoryName}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="驱动标识 (DeviceId)" Binding="{Binding DeviceId}" Width="180"/>
                <DataGridTextColumn Header="驱动显示名称" Binding="{Binding Name}" Width="180"/>
                <DataGridTextColumn Header="品牌 (Brand)" Binding="{Binding Brand}" Width="140"/>
                <DataGridTextColumn Header="驱动版本" Binding="{Binding Version}" Width="90"/>
                <DataGridTextColumn Header="所属 DLL 程序集" Binding="{Binding AssemblyName}" Width="220"/>
                <DataGridTextColumn Header="实现类全名 (ClassType)" Binding="{Binding ClassTypeName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. 底部选中驱动的详细属性展示 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{Binding SelectedPlugin.Name}" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,10,0"/>
                        <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPlugin.DeviceId, StringFormat='ID: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedPlugin.Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13"/>
                </StackPanel>

                <!-- 简单装载状态指示 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="已装载并就绪" Foreground="{StaticResource SuccessBrush}" FontWeight="Medium"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>