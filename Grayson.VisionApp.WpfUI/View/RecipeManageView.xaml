<UserControl x:Class="Grayson.Vision.WpfUI.View.RecipeManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 顶部工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 内容主体（左右分栏） -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. 顶部工具栏 ================= -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📦" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="配方管理" Style="{StaticResource SubTitleTextStyle}"/>
                </StackPanel>

                <!-- 搜索框 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="30,0,0,0">
                    <TextBlock Text="搜索配方：" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                             Width="220" Height="32" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- 快捷操作按钮群 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="+ 新建配方" 
                            Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding CreateRecipeCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="🚀 切换/应用配方" 
                            Style="{StaticResource SuccessButtonStyle}" 
                            Command="{Binding ApplyRecipeCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="🗑️ 删除" 
                            Style="{StaticResource DangerButtonStyle}" 
                            Command="{Binding DeleteRecipeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. 主体区（左列表，右参数配置） ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 左侧配方表格列表 -->
                <ColumnDefinition Width="3.5*"/>
                <!-- 间隔 -->
                <ColumnDefinition Width="8"/>
                <!-- 右侧配方详细参数修改区 -->
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左侧：配方列表 ========== -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
                <DataGrid Style="{StaticResource ModernDataGridStyle}"
                          ItemsSource="{Binding FilteredRecipes}"
                          SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <!-- 运行状态标记 -->
                        <DataGridTemplateColumn Header="状态" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- 生效中为绿色，非生效中为暗色 -->
                                        <Ellipse Width="10" Height="10">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#FF5A5A5A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="配方编号" Binding="{Binding RecipeCode}" Width="120"/>
                        <DataGridTextColumn Header="配方名称" Binding="{Binding RecipeName}" Width="*"/>
                        <DataGridTextColumn Header="产品类别" Binding="{Binding ProductCategory}" Width="110"/>
                        <DataGridTextColumn Header="绑定视觉流程" Binding="{Binding FlowName}" Width="160"/>
                        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ========== 右侧：配方参数详情与编辑 ========== -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 分组标题 -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️ 配方详细参数" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="{Binding SelectedRecipe.RecipeCode, StringFormat=' ({0})'}" 
                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 属性表单编辑内容 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">

                            <!-- 配方名称 -->
                            <TextBlock Text="配方名称" Style="{StaticResource FormLabelStyle}" Margin="0,4"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                                     Text="{Binding SelectedRecipe.RecipeName, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,12"/>

                            <!-- 产品类别 -->
                            <TextBlock Text="所属产品类别" Style="{StaticResource FormLabelStyle}" Margin="0,4"/>
                            <ComboBox Style="{StaticResource ModernComboBoxStyle}" 
                                      SelectedValue="{Binding SelectedRecipe.ProductCategory, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Margin="0,0,0,12">
                                <ComboBoxItem Content="3C电子"/>
                                <ComboBoxItem Content="新能源锂电"/>
                                <ComboBoxItem Content="半导体"/>
                                <ComboBoxItem Content="汽车零部件"/>
                                <ComboBoxItem Content="通用分类"/>
                            </ComboBox>

                            <!-- 绑定视觉流程 -->
                            <TextBlock Text="关联视觉流程文件" Style="{StaticResource FormLabelStyle}" Margin="0,4"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                                     Text="{Binding SelectedRecipe.FlowName, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,12"/>

                            <!-- 相机曝光时间 (ms) -->
                            <TextBlock Text="默认相机曝光 (us)" Style="{StaticResource FormLabelStyle}" Margin="0,4"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                                     Text="{Binding SelectedRecipe.ExposureTime, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,12"/>

                            <!-- 相机增益 -->
                            <TextBlock Text="默认相机增益 (Gain)" Style="{StaticResource FormLabelStyle}" Margin="0,4"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                                     Text="{Binding SelectedRecipe.Gain, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,12"/>

                            <!-- 判定公差 -->
                            <TextBlock Text="判定公差阈值 (mm)" Style="{StaticResource FormLabelStyle}" Margin="0,4"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                                     Text="{Binding SelectedRecipe.ToleranceMm, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="0,0,0,12"/>

                            <!-- 配方描述 -->
                            <TextBlock Text="配方备注说明" Style="{StaticResource FormLabelStyle}" Margin="0,4"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" 
                                     Text="{Binding SelectedRecipe.Description, UpdateSourceTrigger=PropertyChanged}" 
                                     Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                                     Margin="0,0,0,12"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部保存/放弃按钮 -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <Button Content="💾 保存配方参数" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                HorizontalAlignment="Stretch"
                                Command="{Binding SaveDetailCommand}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>