<Window x:Class="Grayson.Vision.WpfUI.View.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:Grayson.Vision.WpfUI.Common.Converters"
        mc:Ignorable="d"
        Title="Grayson 工业视觉上位机系统"
        Height="900" Width="1440"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Bool 转可见性 / 反转Bool转可见性 -->
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <!--<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>-->

        <!-- ========== 暗色工业风全局 ToolTip 样式（解决白色背景问题） ========== -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 菜单项基础按钮样式: 重置 Padding 为 0，保证绝对左对齐 -->
        <Style x:Key="MenuItemButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 底部功能按钮专用样式 -->
        <Style x:Key="MenuBottomButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <!-- 标题栏 -->
                <RowDefinition Height="Auto"/>
                <!-- 全局严重报警 Banner -->
                <RowDefinition Height="*"/>
                <!-- 内容区 -->
            </Grid.RowDefinitions>

            <!-- ========== 自定义标题栏 ========== -->
            <Grid Grid.Row="0" Background="{StaticResource PrimaryDarkBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧: Logo 和标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0">
                    <TextBlock Text="🏭" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Grayson 工业视觉上位机系统" 
                               FontSize="16" 
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 中间: 系统状态信息 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="3" Padding="10,5" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CurrentUserName}" Foreground="{StaticResource AccentLightBrush}" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BackgroundLightBrush}" CornerRadius="3" Padding="10,5" Margin="5,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding SystemStatus}" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource WarningBrush}" CornerRadius="3" Padding="10,5" Margin="5,0"
                            Visibility="{Binding HasAlarm, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding AlarmCount, StringFormat='报警: {0}'}" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右侧: 窗口控制按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="−" Command="{Binding MinimizeCommand}" Style="{StaticResource IconButtonStyle}" Width="45" Height="50" FontSize="20" Foreground="White"/>
                    <Button Content="□" Command="{Binding MaximizeCommand}" Style="{StaticResource IconButtonStyle}" Width="45" Height="50" FontSize="16" Foreground="White"/>
                    <Button Content="✕" Command="{Binding CloseCommand}" Style="{StaticResource IconButtonStyle}" Width="45" Height="50" FontSize="18" Foreground="White"/>
                </StackPanel>
            </Grid>

            <!-- ========== 全局严重报警 Banner ========== -->
            <Border Grid.Row="1" Background="{StaticResource ErrorBrush}" Padding="16,8"
                    Visibility="{Binding HasCriticalAlarm, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="White" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding CriticalAlarmMessage}"
                               Foreground="White" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Content="查看详情" Command="{Binding NavigateToAlarmCommand}"
                            Style="{StaticResource IconButtonStyle}" Foreground="White" FontSize="12" Margin="16,0,8,0"/>
                    <Button Grid.Column="3" Content="✕" Command="{Binding DismissAlarmBannerCommand}"
                            Style="{StaticResource IconButtonStyle}" Foreground="White" FontSize="14" Width="32"/>
                </Grid>
            </Border>

            <!-- ========== 主内容区域 ========== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <!-- 支持绑定宽度实现菜单动态展收 -->
                    <ColumnDefinition Width="{Binding MenuWidth}"/>
                    <!-- 右侧内容区 -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧导航菜单 -->
                <Border Grid.Column="0" 
                        Background="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 菜单项列表 -->
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding MenuItems}" Margin="0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- 1. 分节标题行 -->
                                            <Border Margin="0,10,0,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsSectionHeader}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsMenuCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentLightBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Border Grid.Column="2" Height="1" Background="{StaticResource BorderBrush}"
                                    VerticalAlignment="Center" Opacity="0.3" Margin="0,0,12,0"/>
                                                </Grid>
                                            </Border>

                                            <!-- 2. 一级菜单项按钮 -->
                                            <Grid Height="42" Margin="0,1">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource MenuItemButtonStyle}"
                                Height="42"
                                ToolTip="{Binding Title}">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4"/>
                                                            <!-- 专用于左侧 ActiveBar 的列，避免重叠挤压 -->
                                                            <ColumnDefinition Width="40"/>
                                                            <!-- 图标列 -->
                                                            <ColumnDefinition Width="*"/>
                                                            <!-- 标题列 -->
                                                            <ColumnDefinition Width="30"/>
                                                            <!-- 箭头列 -->
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 左侧选中指示条 -->
                                                        <Border Grid.Column="0" 
                                        Background="{StaticResource AccentBrush}"
                                        CornerRadius="0,2,2,0"
                                        VerticalAlignment="Stretch"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                        <!-- 图标 -->
                                                        <TextBlock Grid.Column="1" Text="{Binding Icon}"
                                           FontSize="16" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                                        <!-- 一级菜单标题 -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Title}"
                                           FontSize="13.5" FontWeight="Medium"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsMenuCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <!-- 展开/折叠箭头 -->
                                                        <TextBlock Grid.Column="3" Text="{Binding ChevronText}"
                                           FontSize="10" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DataContext.IsMenuCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Button>
                                            </Grid>

                                            <!-- 3. 二级子菜单（规范：适度阶梯缩进，工业标准树状视觉） -->
                                            <ItemsControl ItemsSource="{Binding Children}">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                                    <Condition Binding="{Binding DataContext.IsMenuCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Height="36" Margin="0,1">
                                                            <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MenuItemButtonStyle}"
                                            Height="36"
                                            Background="Transparent"
                                            ToolTip="{Binding Title}">
                                                                <Grid HorizontalAlignment="Stretch">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="4"/>
                                                                        <!-- 左侧指示条 -->
                                                                        <ColumnDefinition Width="20"/>
                                                                        <!-- 缩进留白 (使二级菜单与一级产生微小层级感) -->
                                                                        <ColumnDefinition Width="28"/>
                                                                        <!-- 二级小图标/圆点区 -->
                                                                        <ColumnDefinition Width="*"/>
                                                                        <!-- 标题区 -->
                                                                    </Grid.ColumnDefinitions>

                                                                    <!-- 二级选中指示条 -->
                                                                    <Border Grid.Column="0" 
                                                    Background="{StaticResource AccentBrush}"
                                                    CornerRadius="0,2,2,0"
                                                    VerticalAlignment="Stretch"
                                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                                    <!-- 二级小图标（若无图标可显示默认小圆点） -->
                                                                    <TextBlock Grid.Column="2" Text="{Binding Icon, TargetNullValue='•'}"
                                                       FontSize="12" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Opacity="0.8"/>

                                                                    <!-- 二级菜单文字 -->
                                                                    <TextBlock Grid.Column="3" Text="{Binding Title}"
                                                       FontSize="12.5" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                </Grid>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!-- ========== 底部功能区域 ========== -->
                        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,6">
                            <StackPanel>
                                <!-- 收起/展开控制按钮 -->
                                <Button Command="{Binding ToggleMenuCollapseCommand}"
                                        Style="{StaticResource MenuBottomButtonStyle}"
                                        ToolTip="{Binding ToggleMenuTooltip}">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="◀"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMenuCollapsed}" Value="True">
                                                            <Setter Property="Text" Value="▶"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" Text="收起菜单" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMenuCollapsed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>

                                <!-- 退出登录按钮 -->
                                <Button Command="{Binding LogoutCommand}"
                                        Style="{StaticResource MenuBottomButtonStyle}"
                                        ToolTip="退出登录">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="🚪" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="1" Text="退出登录" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMenuCollapsed}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 右侧内容容器 -->
                <ContentControl x:Name="ContentPresenter"
                                Grid.Column="1"
                                Content="{Binding CurrentPageContent}"
                                Background="{StaticResource BackgroundBrush}"/>
            </Grid>
        </Grid>
    </Border>
</Window>