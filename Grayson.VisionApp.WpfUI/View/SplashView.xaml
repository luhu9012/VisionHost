<Window x:Class="Grayson.Vision.WpfUI.View.SplashView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="720"
        Height="420"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Storyboard x:Key="SplashStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Card"
                             Storyboard.TargetProperty="Opacity"
                             From="0.78"
                             To="1"
                             Duration="0:0:1.8"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="PulseDot"
                             Storyboard.TargetProperty="RenderTransform.ScaleX"
                             From="1"
                             To="1.35"
                             Duration="0:0:0.9"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PulseDot"
                             Storyboard.TargetProperty="RenderTransform.ScaleY"
                             From="1"
                             To="1.35"
                             Duration="0:0:0.9"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="PulseDot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.45"
                             To="1"
                             Duration="0:0:0.9"
                             AutoReverse="True"
                             RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SplashStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Border CornerRadius="18" BorderThickness="1" BorderBrush="#3A4A5E">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1C2330" Offset="0"/>
                    <GradientStop Color="#FF131A24" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Border x:Name="Card" Margin="38" CornerRadius="14" Background="#1AFFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🏭" FontSize="54" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Grayson 工业视觉上位机" Foreground="White" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="系统启动中，请稍候..." Foreground="#BFD3E8" FontSize="14" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="40,0,40,28">
                    <ProgressBar Height="6" IsIndeterminate="True" Background="#253345" Foreground="#4FC3F7" BorderThickness="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Ellipse x:Name="PulseDot" Width="8" Height="8" Fill="#4FC3F7" Opacity="0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" CenterX="4" CenterY="4"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <TextBlock Text=" 初始化核心服务" Foreground="#9DB2C8" FontSize="12" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
