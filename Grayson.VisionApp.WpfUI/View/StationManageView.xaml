<UserControl x:Class="Grayson.Vision.WpfUI.View.StationManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:Grayson.Vision.WpfUI.Common.Converters" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.Resources>
        <converter:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" Margin="12">
        <Grid.ColumnDefinitions>
            <!-- 左侧：产线工位导航树 (280px) -->
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <!-- 右侧：主工作区 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：产线与工位导航 ==================== -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="产线与工位拓扑" Style="{StaticResource SubTitleTextStyle}" Margin="0,0,0,12"/>

                <!-- 操作按钮栏 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="+ 产线" Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" Margin="0,0,6,0" Command="{Binding AddLineCommand}"/>
                    <Button Content="+ 工位" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0" Command="{Binding AddStationCommand}"/>
                    <Button Content="删除" Style="{StaticResource DangerButtonStyle}" Padding="10,5" Command="{Binding DeleteNodeCommand}"/>
                </StackPanel>

                <!-- 产线-工位 树形视图 -->
                <TreeView Grid.Row="2" Background="Transparent" BorderThickness="0"
          ItemsSource="{Binding ProductionLines}"
          SelectedItemChanged="TreeView_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <!-- 1级：产线节点 -->
                        <HierarchicalDataTemplate ItemsSource="{Binding Stations}">
                            <!-- 1级节点的 UI 布局 -->
                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                <TextBlock Text="🏭 " VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LineName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- 2级：工位节点的模板（直接放入 DataTemplate 即可） -->
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,3">
                                        <TextBlock Text="⚙️ " VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StationName}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding StationCode, StringFormat=' ({0})'}" Foreground="{StaticResource TextDisabledBrush}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- ==================== 右侧：工位详细配置与映射 ==================== -->
        <!-- 2. 右侧配置主区 -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶栏：工位元数据配置 -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="工位编号:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedStation.StationCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                        <TextBlock Grid.Column="3" Text="工位名称:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="4" Text="{Binding SelectedStation.StationName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                        <TextBlock Grid.Column="6" Text="超时(ms):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="7" Text="{Binding SelectedStation.TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                        <Button Grid.Column="9" Content="💾 保存工位并同步 Runtime Client" 
                                Style="{StaticResource SuccessButtonStyle}" Command="{Binding SaveStationConfigCommand}"/>
                    </Grid>
                </Border>

                <!-- 核心选项卡：物理硬件领用 vs 配方映射 -->
                <TabControl Grid.Row="2" Style="{StaticResource ModernTabControlStyle}">

                    <!-- Tab 1: 物理硬件领用 -->
                    <TabItem Header="1. 物理硬件分配" Style="{StaticResource ModernTabItemStyle}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="+ 从全局硬件池领用" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddHardwareCommand}" Margin="0,0,8,0"/>
                                <Button Content="移除所选硬件" Style="{StaticResource DangerButtonStyle}" Command="{Binding RemoveHardwareCommand}"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGridStyle}" 
                                      ItemsSource="{Binding SelectedStation.HardwareDevices}" SelectedItem="{Binding SelectedHardware}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceCode}" Width="120"/>
                                    <DataGridTextColumn Header="硬件名称" Binding="{Binding DeviceName}" Width="150"/>
                                    <DataGridTextColumn Header="驱动/类型" Binding="{Binding DeviceType}" Width="140"/>
                                    <DataGridTextColumn Header="连接参数/IP" Binding="{Binding ConnectionString}" Width="160"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: 配方绑定的逻辑 -> 物理映射 -->
                    <TabItem Header="2. 配方逻辑设备映射" Style="{StaticResource ModernTabItemStyle}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="绑定的产品配方：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource ModernComboBoxStyle}" Width="240"
                                          ItemsSource="{Binding AvailableRecipes}" DisplayMemberPath="RecipeName"
                                          SelectedItem="{Binding SelectedStation.BoundRecipe}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="💡 请将流程配方中要求的【逻辑设备】映射至下方【已分配的物理硬件】："
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                            <DataGrid Grid.Row="2" Style="{StaticResource ModernDataGridStyle}"
                                      ItemsSource="{Binding SelectedStation.RecipeDeviceMappings}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="配方逻辑设备" Binding="{Binding LogicalDeviceName}" Width="160" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="要求设备类型" Binding="{Binding LogicalDeviceType}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="能力/规格需求" Binding="{Binding RequiredSpec}" Width="180" IsReadOnly="True"/>

                                    <!-- 动态选择映射到本工位领用的硬件 -->
                                    <DataGridTemplateColumn Header="⚡ 绑定到物理硬件实体" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                                          ItemsSource="{Binding DataContext.SelectedStation.HardwareDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DisplayMemberPath="DeviceName"
                                                          SelectedValuePath="DeviceId"
                                                          SelectedValue="{Binding MappedDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>