<UserControl x:Class="Grayson.Vision.WpfUI.View.StationManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converter="clr-namespace:Grayson.Vision.WpfUI.Common.Converters" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.Resources>
        <converter:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" Margin="12">
        <Grid.ColumnDefinitions>
            <!-- 左侧：产线工位导航树 (280px) -->
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <!-- 右侧：主工作区 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：产线与工位导航 ==================== -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="产线与工位拓扑" Style="{StaticResource SubTitleTextStyle}" Margin="0,0,0,12"/>

                <!-- 操作按钮栏 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="+ 产线" Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" Margin="0,0,6,0" Command="{Binding AddLineCommand}"/>
                    <Button Content="+ 工位" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0" Command="{Binding AddStationCommand}"/>
                    <Button Content="删除" Style="{StaticResource DangerButtonStyle}" Padding="10,5" Command="{Binding DeleteNodeCommand}"/>
                </StackPanel>

                <!-- 产线-工位 树形视图 -->
                <TreeView Grid.Row="2" Background="Transparent" BorderThickness="0"
          ItemsSource="{Binding ProductionLines}"
          SelectedItemChanged="TreeView_SelectedItemChanged">
                    <TreeView.ItemTemplate>
                        <!-- 1级：产线节点 -->
                        <HierarchicalDataTemplate ItemsSource="{Binding Stations}">
                            <!-- 1级节点的 UI 布局 -->
                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                <TextBlock Text="🏭 " VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LineName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- 2级：工位节点的模板（直接放入 DataTemplate 即可） -->
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,3">
                                        <TextBlock Text="⚙️ " VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StationName}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding StationCode, StringFormat=' ({0})'}" Foreground="{StaticResource TextDisabledBrush}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- ==================== 右侧：工位详细配置与映射 ==================== -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 顶栏：优化瘦身后的属性编辑与操作栏 (高度紧凑) -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <!-- 下方：核心选项卡 -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶栏：紧凑型工位基础属性编辑与保存栏 -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundLightBrush}" CornerRadius="6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. 工位编号 -->
                        <TextBlock Grid.Column="0" Text="工位编号:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedStation.StationCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="auto" VerticalContentAlignment="Center"/>

                        <!-- 2. 工位名称 -->
                        <TextBlock Grid.Column="3" Text="工位名称:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="4" Text="{Binding SelectedStation.StationName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="auto" VerticalContentAlignment="Center"/>

                        <!-- 3. 超时阈值 -->
                        <TextBlock Grid.Column="6" Text="超时(ms):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}" Margin="0,0,6,0"/>
                        <TextBox Grid.Column="7" Text="{Binding SelectedStation.TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="auto" VerticalContentAlignment="Center"/>

                        <!-- 4. 启用状态 -->
                        <CheckBox Grid.Column="9" Content="启用工位" IsChecked="{Binding SelectedStation.IsEnabled}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                        <!-- 5. 右侧保存按钮 -->
                        <Button Grid.Column="11" Content="💾 保存工位配置" Style="{StaticResource SuccessButtonStyle}" Padding="14,5" Command="{Binding SaveStationConfigCommand}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 选项卡分类：硬件领用 VS 配方映射 -->
                <TabControl Grid.Row="2" Style="{StaticResource ModernTabControlStyle}">

                    <!-- TAB 1: 领用分配物理硬件设备 -->
                    <TabItem Header="工位领用硬件设备" Style="{StaticResource ModernTabItemStyle}">
                        <Grid Margin="4,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="+ 从硬件池领用设备" Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" Margin="0,0,8,0" Command="{Binding AddHardwareCommand}"/>
                                <Button Content="移除已选硬件" Style="{StaticResource DangerButtonStyle}" Padding="10,5" Command="{Binding RemoveHardwareCommand}"/>
                                <TextBlock Text="（注：此处仅作本工位领用关系映射，设备来源于全局设备池）" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>

                            <!-- 已领用硬件列表 -->
                            <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGridStyle}" 
                                      ItemsSource="{Binding SelectedStation.HardwareDevices}"
                                      SelectedItem="{Binding SelectedHardware}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceCode}" Width="130" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="硬件名称" Binding="{Binding DeviceName}" Width="160" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="驱动/插件类型" Binding="{Binding DeviceType}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="通信地址 / IP" Binding="{Binding ConnectionString}" Width="160" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="通信在线状态" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Ellipse Style="{StaticResource RunningIndicatorStyle}" 
                                                             Fill="{Binding IsConnected, Converter={StaticResource BoolToStatusBrushConverter}, FallbackValue='#FF00C853'}"/>
                                                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="备注说明" Binding="{Binding Remark}" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: 配方绑定与逻辑设备映射 -->
                    <TabItem Header="配方绑定与逻辑设备映射" Style="{StaticResource ModernTabItemStyle}">
                        <Grid Margin="4,8,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 1. 绑定的配方选择栏 -->
                            <Border Grid.Row="0" Background="{StaticResource BackgroundLightBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="绑定工位产品配方：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                                    <ComboBox Style="{StaticResource ModernComboBoxStyle}" Width="240" Height="28"
                                              ItemsSource="{Binding AvailableRecipes}" 
                                              DisplayMemberPath="RecipeName" 
                                              SelectedItem="{Binding SelectedStation.BoundRecipe}"/>

                                    <TextBlock Text="配方版本：" Style="{StaticResource FormLabelStyle}" Margin="20,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedStation.BoundRecipe.Version, FallbackValue='--'}" Style="{StaticResource SectionTitleTextStyle}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 2. 说明提示 -->
                            <TextBlock Grid.Row="1" Text="💡 请将工艺配方中要求的【逻辑设备】映射绑定到本工位【已领用的实际物理硬件】： " 
                                       Style="{StaticResource FormLabelStyle}" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,0,6"/>

                            <!-- 3. 配方逻辑设备 -> 实际硬件映射 DataGrid -->
                            <DataGrid Grid.Row="2" Style="{StaticResource ModernDataGridStyle}"
                                      ItemsSource="{Binding SelectedStation.RecipeDeviceMappings}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="配方逻辑设备" Binding="{Binding LogicalDeviceName}" Width="160" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="逻辑设备类型" Binding="{Binding LogicalDeviceType}" Width="130" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="配方能力要求" Binding="{Binding RequiredSpec}" Width="180" IsReadOnly="True"/>

                                    <!-- 下拉映射列：从本工位已领用的硬件列表中选 -->
                                    <DataGridTemplateColumn Header="映射的物理硬件设备" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource ModernComboBoxStyle}" Height="26"
                                                          ItemsSource="{Binding DataContext.SelectedStation.HardwareDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          DisplayMemberPath="DeviceName"
                                                          SelectedValuePath="DeviceId"
                                                          SelectedValue="{Binding MappedDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>