<UserControl x:Class="Grayson.Vision.WpfUI.View.StationManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:converters="clr-namespace:Grayson.Vision.WpfUI.Common.Converters"
            xmlns:common="clr-namespace:Grayson.Vision.WpfUI.Common"
            xmlns:views="clr-namespace:Grayson.Vision.WpfUI.View"
            mc:Ignorable="d" 
            d:DesignHeight="720" d:DesignWidth="1280">
    <UserControl.Resources>
        <converters:BoolToStatusBrushConverter x:Key="BoolToStatusBrushConverter"/>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" Margin="12">
        <Grid.ColumnDefinitions>
            <!-- 左侧：产线工位导航树 (280px) -->
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="12"/>
            <!-- 右侧：主工作区 -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：产线与工位导航 ==================== -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="产线与工位拓扑" Style="{StaticResource SubTitleTextStyle}" Margin="0,0,0,12"/>

                <!-- 操作按钮栏 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="+ 产线" Style="{StaticResource PrimaryButtonStyle}" Padding="10,5" Margin="0,0,6,0" Command="{Binding DataContext.AddLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="+ 工位" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,6,0" Command="{Binding DataContext.AddStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Content="删除" Style="{StaticResource DangerButtonStyle}" Padding="10,5" Command="{Binding DataContext.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>

                <!-- 产线-工位 树形视图 -->
                <TreeView Grid.Row="2" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding ProductionLines}"
                          SelectedItemChanged="TreeView_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <!-- 1级：产线节点 -->
                        <HierarchicalDataTemplate ItemsSource="{Binding Stations}">
                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                <TextBlock Text="🏭 " VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LineName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- 2级：工位节点 -->
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,3">
                                        <TextBlock Text="⚙️ " VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StationName}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding StationCode, StringFormat=' ({0})'}" Foreground="{StaticResource TextDisabledBrush}" FontSize="11"/>
                                        <TextBlock Text=" | 启用" FontSize="11" Margin="4,0,0,0" Foreground="Green"
                                                   Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text=" | 禁用" FontSize="11" Margin="4,0,0,0" Foreground="Gray"
                                                   Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- ==================== 右侧：工位详细配置与映射 ==================== -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶栏：工位元数据配置 -->
                <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <!-- 快捷按钮列 -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="工位编号:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="1" Text="{Binding SelectedStation.StationCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                        <TextBlock Grid.Column="3" Text="工位名称:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="4" Text="{Binding SelectedStation.StationName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                        <TextBlock Grid.Column="6" Text="超时(ms):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Grid.Column="7" Text="{Binding SelectedStation.TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                        <CheckBox Grid.Column="9"
                                  Content="启用工位"
                                  IsChecked="{Binding SelectedStation.IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalContentAlignment="Center"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  ToolTip="启用的工位可在单工位监控中连接，禁用工位不会被保存到 Runtime"/>

                        <!-- 🎯 新增：从当前工位直达标定中心的快捷入口 -->
                        <Button Grid.Column="12" 
                        Content="🎯 标定中心" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Margin="8,0,0,0"
                        ToolTip="快速打开标定管理中心并自动定位至当前工位"
                        Command="{Binding OpenCalibrationCenterCommand}"/>

                        <Button Grid.Column="13" 
                        Content="💾 保存工位并同步 Runtime Client" 
                        Style="{StaticResource SuccessButtonStyle}" 
                        Margin="8,0,0,0"
                        Command="{Binding SaveStationConfigCommand}"/>
                    </Grid>
                </Border>

                <!-- 核心选项卡：物理硬件领用 vs 配方映射 -->
                <TabControl Grid.Row="2" Style="{StaticResource ModernTabControlStyle}">

                    <!-- Tab 1: 物理硬件分配 -->
                    <TabItem Header="1. 物理硬件分配" Style="{StaticResource ModernTabItemStyle}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="+ 从全局硬件池领用" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddHardwareCommand}" Margin="0,0,8,0"/>
                                <Button Content="移除所选硬件" Style="{StaticResource DangerButtonStyle}" Command="{Binding RemoveHardwareCommand}"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGridStyle}" AutoGenerateColumns="False"
                                      ItemsSource="{Binding SelectedStation.HardwareDevices}" SelectedItem="{Binding SelectedHardware}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="设备编号" Binding="{Binding DeviceCode}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="硬件名称" Binding="{Binding DeviceName}" Width="150" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="驱动/类型" Binding="{Binding DeviceType}" Width="140" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="连接参数/IP" Binding="{Binding ConnectionString}" Width="160" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>



                    <!-- Tab 2: 配方绑定的逻辑 -> 物理映射 -->
                    <TabItem Header="2. 配方逻辑设备映射" Style="{StaticResource ModernTabItemStyle}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="绑定的产品配方：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                                <ComboBox Style="{StaticResource ModernComboBoxStyle}" Width="240"
                                          ItemsSource="{Binding AvailableRecipes}" 
                                          SelectedItem="{Binding SelectedStation.BoundRecipe}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RecipeName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="💡 请将流程配方中要求的【逻辑设备】映射至下方【已分配的物理硬件】："
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                            <DataGrid Grid.Row="2" Style="{StaticResource ModernDataGridStyle}" AutoGenerateColumns="False"
                                      ItemsSource="{Binding SelectedStation.RecipeDeviceMappings}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="配方逻辑设备" Binding="{Binding LogicalDeviceName}" Width="160" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="要求设备类型" Binding="{Binding LogicalDeviceType}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="能力/规格需求" Binding="{Binding RequiredSpec}" Width="180" IsReadOnly="True"/>

                                    <!-- 动态选择映射到本工位领用的硬件 -->
                                    <DataGridTemplateColumn Header="⚡ 绑定到物理硬件实体" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox Style="{StaticResource ModernComboBoxStyle}"
                                                          ItemsSource="{Binding DataContext.SelectedStation.HardwareDevices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        
                                                          SelectedValuePath="DeviceId"
                                                          SelectedValue="{Binding MappedDeviceId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DeviceId}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: 标定管理 -->
                    <!--<TabItem Header="3. 标定管理" Style="{StaticResource ModernTabItemStyle}">
                        <views:CalibrationManagerView DataContext="{Binding DataContext.CalibrationManagerVm, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </TabItem>-->

                    <!-- Tab 3: 触发信号配置 -->
                    <TabItem Header="3. 触发信号配置" Style="{StaticResource ModernTabItemStyle}">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 提示说明 -->
                            <TextBlock Grid.Row="0"
                                       Text="💡 配置工位的触发信号来源。手动=UI 按钮点击；定时器=固定周期自动触发；PLC 位=轮询 PLC 指定地址的 bool 位（上升沿/下降沿）后触发。"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>

                            <!-- 触发源类型与边沿 -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="触发源类型:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{x:Static common:TriggerOptionCatalog.SourceTypeOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedStation.TriggerSourceType}"
                                          ToolTip="选择工位触发信号的来源类型">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>

                                <TextBlock Grid.Column="3" Text="边沿检测:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Grid.Column="4" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{x:Static common:TriggerOptionCatalog.EdgeOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedStation.TriggerEdge}"
                                          ToolTip="选择什么电平变化算一次有效触发（定时器源会自动忽略此项）">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>

                                <TextBlock Grid.Column="6" Text="防抖(ms):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Grid.Column="7" Text="{Binding SelectedStation.DebounceMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            </Grid>

                            <!-- 丢帧策略 -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="丢帧策略:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{x:Static common:TriggerOptionCatalog.DropStrategyOptions}"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedStation.DropStrategy}"
                                          ToolTip="检测周期超过触发节拍（执行中又来新信号）时的处理策略">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </Grid>

                            <!-- Timer 源参数（仅 Timer 类型时可见） -->
                            <StackPanel Grid.Row="5" Margin="0,12,0,0" Visibility="{Binding SelectedStation.TriggerSourceType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Timer}">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="定时器周期(ms):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox Grid.Column="1" Text="{Binding SelectedStation.TimerIntervalMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- PlcBit 源参数（仅 PlcBit 类型时可见） -->
                            <StackPanel Grid.Row="5" Margin="0,12,0,0" Visibility="{Binding SelectedStation.TriggerSourceType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=PlcBit}">
                                <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="PLC 设备:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                        <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                                  ItemsSource="{Binding SelectedStation.PlcDeviceOptions}"
                                                  SelectedValuePath="DeviceId"
                                                  SelectedValue="{Binding SelectedStation.PlcDeviceId}"
                                                  ToolTip="从全局硬件池中选择 PLC 设备">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DeviceId}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Column="3" Text="触发点位地址:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox Grid.Column="4" Text="{Binding SelectedStation.PlcAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"
                                                 ToolTip="PLC 触发点位地址，如 M0.0 / D100.0"/>

                                        <TextBlock Grid.Column="6" Text="轮询间隔(ms):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                        <TextBox Grid.Column="7" Text="{Binding SelectedStation.PollIntervalMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>