<UserControl x:Class="Grayson.Vision.WpfUI.View.StationMonitorExtensions.VisionPickPlaceTeachPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             d:DesignHeight="680" d:DesignWidth="340">
    <Border Background="#140078D4" BorderBrush="#420078D4" BorderThickness="1"
            CornerRadius="4" Padding="10">
        <StackPanel>
            <TextBlock Text="🤖 VisionPickPlace 取放示教 / 角度策略"
                       FontWeight="Bold" FontSize="12" Foreground="#FF0078D4"/>
            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding TeachModeStatusText}"/>
            <TextBlock FontSize="11" Margin="0,3,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}">
                <Run Text="最近视觉输出：wx="/><Run Text="{Binding TeachWxText, Mode=OneWay}" FontWeight="Bold"/><Run Text="  wy="/><Run Text="{Binding TeachWyText, Mode=OneWay}" FontWeight="Bold"/><Run Text="  Angle="/><Run Text="{Binding TeachAngleText, Mode=OneWay}" FontWeight="Bold"/><Run Text="°（点【单次触发】后自动更新）"/>
            </TextBlock>

            <Separator Margin="0,6,0,6" Background="#220078D4"/>

            <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,2,0,3"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="① 点【单次触发】采图（示教模式安全：不走位）→ ② 观察上行走位是否正确 → ③ 随机姿态来料需归正时改下方参数并【保存】"/>

            <!-- 角度策略参数 -->
            <TextBlock Text="⚙ 角度策略（放料前统一工件姿态）"
                       FontWeight="Bold" FontSize="11" Foreground="#FF0078D4" Margin="0,2,0,2"/>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="视觉实测角归正(True/False)" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EnableAngleCorrectionText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="RefAngle(模板参考角°)" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RefAngleText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Sign(方向 1 / -1)" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AngleSignText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="WorkU(吸取角°)" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding WorkUText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="PlaceU(放料角°)" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,4,0"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PlaceUText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center"/>
            </Grid>
            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0"
                       Foreground="{StaticResource TextDisabledBrush}"
                       Text="归正公式：U_place = PlaceU − Sign·(Angle − RefAngle)。True=读 MatchAngle 自动归正随机姿态；False=固定转 PlaceU。相机朝上(下相机检知)=Sign 取 -1。"/>
            <Button Content="💾 保存角度策略（写回配置并热更新）" Style="{StaticResource SuccessButtonStyle}"
                    FontSize="11" Margin="1,5,1,0" Padding="0,6" Command="{Binding SaveAngleConfigCommand}"/>

            <Separator Margin="0,8,0,6" Background="#220078D4"/>

            <!-- 执行参数：位点/姿态/吸嘴（2026-09-06：S3 灌点入口；同心吸嘴 Ecc 全 0） -->
            <TextBlock Text="🎯 执行参数（单位：mm / ms / mm·s⁻¹）"
                       FontWeight="Bold" FontSize="11" Foreground="#FF0078D4" Margin="0,2,0,2"/>
            <TextBlock FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,3"
                       Foreground="{StaticResource TextDisabledBrush}"
                       Text="位点放料位 / 待机位 / 安全Z 为机械坐标（Epson 世界系）；同心吸嘴 = 嘴1 偏心全 0；单吸嘴时 放料2/真空2/嘴2 不参与节拍。"/>

            <TextBlock Text="位点与姿态" FontWeight="SemiBold" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="待机X" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StandbyXText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="StandbyX：工位空闲等待位 X"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="待机Y" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding StandbyYText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="StandbyY：工位空闲等待位 Y"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="安全Z" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SafeZText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="SafeZ：XY 平移时抬升的安全高度 Z"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="吸取Z / 放料Z" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal">
                    <TextBox Width="52" Text="{Binding PickZText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="PickZ：吸嘴下探吸取高度（相对）"/>
                    <TextBlock Text=" / " FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextDisabledBrush}"/>
                    <TextBox Width="52" Text="{Binding PlaceZText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="PlaceZ：下探放料高度（相对）"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="放料1X" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Place1XText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="Place1X：第一块放料位 X（工件中心落点）"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="放料1Y" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Place1YText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="Place1Y：第一块放料位 Y"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="放料2X" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Place2XText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="Place2X：第二块放料位 X（仅双吸嘴）"/>
                <TextBlock Grid.Row="3" Grid.Column="3" Text="放料2Y" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding Place2YText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="Place2Y：第二块放料位 Y（仅双吸嘴）"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="XY速度" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding XySpeedText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="XySpeed：XY/U 联动移动速度（0=用引擎默认）"/>
                <TextBlock Grid.Row="4" Grid.Column="3" Text="Z速度" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding ZSpeedText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="ZSpeed：Z 轴升降速度（0=用引擎默认）"/>
            </Grid>

            <TextBlock Text="吸嘴 · 真空 · 偏心" FontWeight="SemiBold" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="单吸嘴形态" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding UseSingleNozzleText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="UseSingleNozzle：True=单吸嘴（放料2/真空2/嘴2 不参与）；False=双吸嘴"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="真空1/2 IO" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal">
                    <TextBox Width="40" Text="{Binding VacuumIo1Text, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="VacuumIo1：吸嘴1 真空 IO 号"/>
                    <TextBlock Text=" / " FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextDisabledBrush}"/>
                    <TextBox Width="40" Text="{Binding VacuumIo2Text, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="VacuumIo2：吸嘴2 真空 IO 号"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="真空开/关延时" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="52" Text="{Binding VacuumOnDelayText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="VacuumOnDelayMs：吸住后等待（ms）"/>
                    <TextBlock Text=" / " FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextDisabledBrush}"/>
                    <TextBox Width="52" Text="{Binding VacuumOffDelayText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="VacuumOffDelayMs：释放后等待（ms）"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="到位稳定(ms)" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding SettleMsText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="SettleMs：轴到位后的稳定等待（ms）"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="嘴1 偏心X" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Nozzle1EccXText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="Nozzle1EccX：吸嘴1 相对 U 回转中心的偏心 X（同心=0；标定旋转中心后按发布值）"/>
                <TextBlock Grid.Row="2" Grid.Column="3" Text="嘴1 偏心Y" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Nozzle1EccYText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="Nozzle1EccY：吸嘴1 偏心 Y"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="嘴2 偏心X" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Nozzle2EccXText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="Nozzle2EccX：吸嘴2 偏心 X（双吸嘴）"/>
                <TextBlock Grid.Row="3" Grid.Column="3" Text="嘴2 偏心Y" FontSize="10.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,4,1"/>
                <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding Nozzle2EccYText, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2" VerticalContentAlignment="Center" ToolTip="Nozzle2EccY：吸嘴2 偏心 Y（双吸嘴）"/>
            </Grid>
            <Button Content="💾 保存执行参数（写回配置并热更新）" Style="{StaticResource SuccessButtonStyle}"
                    FontSize="11" Margin="1,6,1,0" Padding="0,6" Command="{Binding SaveMotionConfigCommand}"/>

            <Separator Margin="0,8,0,6" Background="#220078D4"/>

            <UniformGrid Columns="2">
                <Button Content="🛠 开启示教模式" Style="{StaticResource SecondaryButtonStyle}"
                        FontSize="11" Margin="1" Padding="0,6" Command="{Binding EnableTeachModeCommand}"/>
                <Button Content="直接退出示教" Style="{StaticResource WarningButtonStyle}"
                        FontSize="11" Margin="1" Padding="0,6" Command="{Binding ExitTeachModeCommand}"/>
            </UniformGrid>

            <Separator Margin="0,8,0,6" Background="#220078D4"/>
            <TextBlock Text="⚙ 参数覆盖管理（代码默认 = 基线）"
                       FontWeight="Bold" FontSize="11" Foreground="#FF0078D4"/>
            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding OverlayInfoText}"/>
            <Button Content="🔄 清除全部覆盖，恢复代码默认值" Style="{StaticResource DangerButtonStyle}"
                    FontSize="11" Margin="1,6,1,0" Padding="0,5" Command="{Binding ResetToDefaultsCommand}"/>
            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="{StaticResource TextDisabledBrush}"
                       Text="说明：本面板持久化 角度策略/TeachMode/位点/姿态/速度/真空 IO/偏心/单双吸嘴 等字段级覆盖；未列参数（轴号、CardAlias、TilePitch 节距、MinScore 等）以 VisionPickPlaceConfig.cs 代码默认为准。偏心也可由旋转中心标定发布写入，二者同源时以最后一次保存为准。"/>
        </StackPanel>
    </Border>
</UserControl>
