<Window x:Class="Grayson.Vision.WpfUI.View.StationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Grayson.Vision.WpfUI.Service"
        Title="{Binding WindowTitle, FallbackValue=新建工位向导（需求驱动）}" Height="780" Width="1200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题与引导 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource SubTitleTextStyle}"/>
            <TextBlock Text="{Binding WindowSubtitle}"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 主区：左问卷 / 右推导预览 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== 左侧：方案标识 + 分组问卷 ==================== -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 行业模板 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="行业方案模板（可选加速）" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding TemplateOptions}" SelectedItem="{Binding SelectedTemplate}"
                                      DisplayMemberPath="Name"/>
                            <TextBlock Grid.Column="3" Text="{Binding SelectedTemplate.Description}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- 方案标识 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding SchemeHeaderText}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="工位代码:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Grid.Column="1" Text="{Binding StationCode, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         IsReadOnly="{Binding IsEditMode}"
                                         ToolTip="全局唯一简码（日志/告警标识），如 STA-003、MHJ_A_1；编辑模式锁定"/>
                                <TextBlock Grid.Column="3" Text="工位名称:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Grid.Column="4" Text="{Binding StationName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"
                                         IsReadOnly="{Binding IsEditMode}"
                                         ToolTip="中文描述，如『麻将定位抓取工位』；编辑模式锁定"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ① 视觉任务 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="① 视觉任务" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding TaskTypeOptions}" SelectedItem="{Binding TaskType}"
                                      ToolTip="检测对象类型：决定建议流程骨架/模板策略/输出端口"/>
                            <TextBlock Grid.Column="2" Margin="10,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"
                                       Text="定位抓取=出坐标引导；测量=出数值；缺陷/有无=出 OKNG；字符=出文本"/>
                        </Grid>
                    </Border>

                    <!-- ② 成像 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="② 成像方式" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="相机安装:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding CameraMountOptions}" SelectedItem="{Binding CameraMount}"
                                          ToolTip="眼在手上(随动)→手眼标定；眼在手外(固定)→九点标定"/>
                                <TextBlock Grid.Column="3" Text="拍照方式:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Grid.Column="4" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding ShootModeOptions}" SelectedItem="{Binding ShootMode}"/>
                                <TextBlock Grid.Column="6" Text="光轴与工面:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Grid.Column="7" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AxisToSurfaceOptions}" SelectedItem="{Binding AxisToSurface}"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="打光方式:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding LightingOptions}" SelectedItem="{Binding Lighting}"/>
                                <TextBlock Grid.Column="3" Text="FOV(mm):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Grid.Column="4" Text="{Binding FovMm, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" ToolTip="视野宽度（mm），用于像素当量可行性校验"/>
                                <TextBlock Grid.Column="6" Text="工作距离(mm):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Grid.Column="7" Text="{Binding WorkDistanceMm, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}"/>
                                <TextBlock Grid.Column="9" Text="最小特征(mm):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Grid.Column="10" Text="{Binding MinFeatureMm, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" ToolTip="需识别的最小特征尺寸，结合 FOV 做像素当量告警"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ③ 工具 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="③ 工具头" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="工具头数量:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding ToolHeadOptions}" SelectedItem="{Binding ToolHeadCount}"/>
                                <TextBlock Grid.Column="3" Text="与旋转轴同心:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Grid.Column="4" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding ConcentricOptions}" SelectedItem="{Binding ConcentricText}"
                                          ToolTip="偏心→需旋转中心标定+偏心补偿（示教按 ToolOffset）"/>
                                <TextBlock Grid.Column="6" Text="角度需求:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Grid.Column="7" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding AngleNeedOptions}" SelectedItem="{Binding AngleNeed}"
                                          ToolTip="抓取/放置带角度 → 模板角度范围开启 + 匹配输出角度驱动旋转轴"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ④ 判定与节拍 -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="④ 判定与节拍" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                      ItemsSource="{Binding VerdictOutputOptions}" SelectedItem="{Binding VerdictOutput}"
                                      ToolTip="决定流程末端节点：IO/PLC 输出、测量值上报、MES、引导坐标"/>
                            <TextBlock Grid.Column="3" Text="节拍(件/min):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Grid.Column="4" Text="{Binding CyclePerMin, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBoxStyle}" ToolTip="节拍紧张时考虑飞拍/多相机并行"/>
                            <TextBlock Grid.Column="5" Margin="10,0,0,0" FontSize="11"
                                       Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"
                                       Text="节拍 ≥60 件/min 建议评估飞拍方案"/>
                        </Grid>
                    </Border>

                    <!-- ⑤ 执行机构与相机拓扑（多相机/机器人 → 槽级标定建议） -->
                    <Border Style="{StaticResource CardBorderStyle}" Padding="10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⑤ 执行机构与相机拓扑" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="  多相机 / 机器人工位在此描述；每槽推导独立标定建议（右侧预览）"
                                           FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="＋ 添加相机槽" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,4" Click="BtnAddSlot_Click"
                                        ToolTip="多相机（上固定/下固定/眼在手上/斜拍）逐个添加；仅单相机可跳过，用上方 ② 成像字段"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="执行机构:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                                          ItemsSource="{Binding ActuatorKindOptions}" SelectedItem="{Binding ActuatorKind}"
                                          ToolTip="工位主力执行器：SCARA/6轴 机器人、运动板卡直驱、PLC+外部执行器&#10;决定标定向导轴约定默认值（机器人 SCARA：旋转轴=U(3)、Z=2；ZMC 双滑台：0号=Z）"/>
                                <TextBlock Grid.Column="2" Margin="10,0,0,0" FontSize="11"
                                           Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="机器人 → 标定向导按 SCARA 轴约定（U 旋转/Z 升降）；板卡 → 现场轴表；PLC → 标定仅建像素关系"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding CameraSlotsUi}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8,5" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="104"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="84"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#22378ADD" CornerRadius="9" Padding="7,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SlotKey}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text=" 安装:" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                                                <ComboBox Grid.Column="2" Style="{StaticResource ModernComboBoxStyle}" Height="26"
                                                          ItemsSource="{x:Static svc:StationProposalEngine.CameraInstallOptions}"
                                                          SelectedItem="{Binding InstallKind}"
                                                          SelectionChanged="SlotField_Changed"
                                                          ToolTip="相机安装方式（眼在手上=随执行机构移动 → 手眼标定族）"/>
                                                <TextBlock Grid.Column="3" Text=" 用途:" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                                                <ComboBox Grid.Column="4" Style="{StaticResource ModernComboBoxStyle}" Height="26"
                                                          ItemsSource="{x:Static svc:StationProposalEngine.CameraPurposeOptions}"
                                                          SelectedItem="{Binding Purpose}"
                                                          SelectionChanged="SlotField_Changed"
                                                          ToolTip="该相机承担的角色：引导定位 / 飞拍纠偏 / 测量 / 检测…"/>
                                                <TextBlock Grid.Column="5" Text=" 拍:" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                                                <ComboBox Grid.Column="6" Style="{StaticResource ModernComboBoxStyle}" Height="26"
                                                          ItemsSource="{x:Static svc:StationProposalEngine.ShootModeOptions}"
                                                          SelectedItem="{Binding ShootMode}"
                                                          SelectionChanged="SlotField_Changed"
                                                          ToolTip="精拍(静止) / 飞拍(运动中)"/>
                                                <TextBlock Grid.Column="7" Text=" 光轴:" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDisabledBrush}"/>
                                                <ComboBox Grid.Column="8" Style="{StaticResource ModernComboBoxStyle}" Height="26"
                                                          ItemsSource="{x:Static svc:StationProposalEngine.CameraAxisSurfaceOptions}"
                                                          SelectedItem="{Binding AxisToSurface}"
                                                          SelectionChanged="SlotField_Changed"
                                                          ToolTip="垂直拍摄 / 斜拍（斜拍建议畸变矫正前置）"/>
                                                <Button Grid.Column="10" Content="✕" Style="{StaticResource SecondaryButtonStyle}"
                                                        Width="24" Height="24" Padding="0" FontSize="11" Margin="4,0,0,0"
                                                        Click="BtnRemoveSlot_Click" Tag="{Binding}" ToolTip="移除该相机槽"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="未配置相机槽 —— 仅单相机请用上方 ② 成像字段；多相机点【＋ 添加相机槽】逐台描述"
                                       FontSize="11" Foreground="{DynamicResource TextDisabledBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding HasCameraSlots, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== 右侧：实时推导预览 ==================== -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel>
                    <TextBlock Text="⚡ 实时推导（系统建议，进工作台可改）" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="基于当前答案的建议视觉链/标定/资产占位；告警需人工决策"
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" TextWrapping="Wrap"/>

                    <TextBlock Text="建议视觉链" FontWeight="Bold" FontSize="12" Margin="0,4,0,2"/>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <TextBlock Text="{Binding FlowText}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="建议标定方案" FontWeight="Bold" FontSize="12" Margin="0,4,0,2"/>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <TextBlock Text="{Binding CalibText}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="待建资产占位（工作台 S2/S3 生成待办）" FontWeight="Bold" FontSize="12" Margin="0,4,0,2"/>
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4" Padding="8" Margin="0,0,0,8" MinHeight="40">
                        <TextBlock Text="{Binding AssetsText}" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                    </Border>

                    <TextBlock Text="可行性告警" FontWeight="Bold" FontSize="12" Margin="0,4,0,2"/>
                    <Border Background="#22A32D2D" CornerRadius="4" Padding="8" MinHeight="40">
                        <TextBlock Text="{Binding WarningsText}" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                                   Foreground="#FFC1A0A0"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 底部：草稿 + 操作 ==================== -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="载入草稿:" VerticalAlignment="Center" FontSize="12"
                       Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}"
                      ItemsSource="{Binding DraftOptions}" SelectedItem="{Binding SelectedDraft}"
                      DisplayMemberPath="Label"
                      Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                      ToolTip="此前【存草稿】的方案（未落真实工位），可载入续编"/>
            <Button Grid.Column="3" Content="载入" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Click="BtnLoadDraft_Click"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
            <Button Grid.Column="4" Content="🗑" Style="{StaticResource SecondaryButtonStyle}" Width="30" Padding="0"
                    Click="BtnDeleteDraft_Click" ToolTip="删除选中草稿" Margin="4,0,0,0"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>

            <Button Grid.Column="6" Content="取消" Style="{StaticResource SecondaryButtonStyle}" Padding="18,8" Click="BtnCancel_Click"/>
            <Button Grid.Column="7" Content="💾 存草稿" Style="{StaticResource SecondaryButtonStyle}" Padding="18,8" Margin="8,0,0,0"
                    Click="BtnSaveDraft_Click"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                    ToolTip="只保存方案草稿（不建真实工位），稍后可载入续编"/>
            <Button Grid.Column="8" Content="{Binding CreateButtonText}" Style="{StaticResource SuccessButtonStyle}" Padding="22,9" Margin="8,0,0,0"
                    FontSize="14" FontWeight="Bold" Click="BtnCreate_Click"
                    ToolTip="编辑模式=保存档案修改（回写 Active 档案，不建工位）；新建模式=按问卷生成真实工位"/>
        </Grid>
    </Grid>
</Window>
