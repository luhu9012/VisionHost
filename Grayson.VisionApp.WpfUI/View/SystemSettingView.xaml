<UserControl x:Class="Grayson.Vision.WpfUI.View.SystemSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题与未保存提示 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚙️ 系统与运行参数设置" Style="{StaticResource TitleTextStyle}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="* 有未保存的变更" 
                           Foreground="#FFA726" 
                           Margin="16,0,0,0" 
                           VerticalAlignment="Center" 
                           FontWeight="SemiBold"
                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 保存设置" Style="{StaticResource SuccessButtonStyle}" Padding="16,6" Command="{Binding SaveCommand}"/>
                <Button Content="🔄 重置/还原" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="8,0,0,0" Command="{Binding ResetCommand}"/>
            </StackPanel>
        </Grid>

        <!-- 主体 Tab 分页 -->
        <TabControl Grid.Row="1" Style="{StaticResource ModernTabControlStyle}">

            <!-- 1. 存储与自动清理 -->
            <TabItem Header="📁 存储与清理策略">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：路径管理（日志目录已移至「日志与诊断」Tab，见下） -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="路径设置" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>

                                <TextBlock Text="图片与运行历史保存目录" Style="{StaticResource FormLabelStyle}"/>
                                <Grid Margin="0,4,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ImageStorePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                    <Button Grid.Column="1" Content="浏览..." Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseImageFolderCommand}"/>
                                    <Button Grid.Column="2" Content="打开" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenImageFolderCommand}"/>
                                </Grid>

                                <TextBlock Text="数据库/配方存储路径" Style="{StaticResource FormLabelStyle}"/>
                                <Grid Margin="0,4,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding DataPath}" IsReadOnly="True" Style="{StaticResource ModernTextBoxStyle}"/>
                                    <Button Grid.Column="1" Content="打开" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenDataFolderCommand}"/>
                                </Grid>

                                <!-- 生产统计数据管理（工位监视页头部 KPI 的持久化累计） -->
                                <Separator Margin="0,4,0,12"/>
                                <TextBlock Text="生产统计数据" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,8"/>
                                <TextBlock Text="各工位监视页头部的 总数 / OK / NG / 良率 累计（持久化在 Data\StationStats）。"
                                           Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <Button Content="🗑 清除所有工位生产统计" 
                                        Style="{StaticResource DangerButtonStyle}" 
                                        Padding="12,6" 
                                        HorizontalAlignment="Left"
                                        Command="{Binding ClearProductionStatsCommand}"/>
                            </StackPanel>
                        </Border>

                        <!-- 右侧：工业爆盘防护策略 -->
                        <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="16" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="爆盘自动防护策略" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>

                                <TextBlock Text="图像存图模式" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox Style="{StaticResource ModernComboBoxStyle}" 
                                          SelectedIndex="{Binding ImageSaveModeIndex}" 
                                          Margin="0,4,0,16">
                                    <ComboBoxItem Content="仅保存 NG 图像 (推荐生产环境)"/>
                                    <ComboBoxItem Content="保存所有图像 (仅用于前期调试)"/>
                                    <ComboBoxItem Content="不保存图像 (仅保留检测结果文本)"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="图片自动清理保留天数 (天)" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ImageRetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                </Grid>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="磁盘空间预警阈值 (% 剩余)" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Grid.Column="1" Text="{Binding DiskWarningThreshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                                </Grid>

                                <CheckBox Content="磁盘低于预警阈值时自动清除最老旧图像" 
                                          IsChecked="{Binding AutoPurgeOnLowDisk}" 
                                          Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- 2. 运行与工位策略 -->
            <TabItem Header="🚀 运行与工位策略">
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="12">
                    <StackPanel>
                        <TextBlock Text="Station 运行策略配置" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>

                        <CheckBox Content="程序启动后自动连接并启动所有启用工位" 
                                  IsChecked="{Binding AutoStartStations}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="工位启动超时时间 (毫秒):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding StationStartTimeoutMs}" Style="{StaticResource ModernTextBoxStyle}"/>
                            <TextBlock Grid.Column="2" Text="* UI 等待 StationHost 完成初始化与配方加载的最大时间" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="工单历史内存保留数量:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="{Binding WorkOrderHistoryCountIndex}">
                                <ComboBoxItem Content="100"/>
                                <ComboBoxItem Content="500"/>
                                <ComboBoxItem Content="1000"/>
                                <ComboBoxItem Content="5000"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="* 每个运行工位 WorkOrderTracker 在内存中保留的最近工单数" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Background="#1E1E1E" CornerRadius="4" Padding="12" Margin="0,12,0,0">
                            <TextBlock Text="💡 提示: 当前版本 Station 统一作为同进程后台线程运行（Embedded 模式），由 StationHostRuntime 集中管理设备池与多工位 Worker。RemoteIpc/WorkerHost 独立进程架构已在代码中预留扩展点，但不在当前版本启用。" 
                                       Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 3. 渲染与性能平衡 -->
            <TabItem Header="🖼️ 图像渲染与性能">
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="12">
                    <StackPanel>
                        <TextBlock Text="WPF 渲染与控制" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="UI 渲染最大限制帧率 (FPS):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="{Binding RenderFpsIndex}">
                                <ComboBoxItem Content="15 FPS (低 CPU 占用)"/>
                                <ComboBoxItem Content="30 FPS (平衡)"/>
                                <ComboBoxItem Content="60 FPS (高流畅度)"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="* 降低帧率可大幅降低高速连续抓拍时的 UI CPU/GPU 占用" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <CheckBox Content="高频渲染时跳过无变动的图像叠加层 (Overlays)" 
                                  IsChecked="{Binding OptimizeOverlays}"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 4. 日志与诊断 -->
            <TabItem Header="📝 日志与诊断">
                <Border Style="{StaticResource CardBorderStyle}" Padding="16" Margin="12">
                    <StackPanel>
                        <TextBlock Text="日志输出配置（保存后立即生效，无需重启）" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,16"/>

                        <TextBlock Text="日志文件存储目录" Style="{StaticResource FormLabelStyle}"/>
                        <Grid Margin="0,4,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LogPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            <Button Grid.Column="1" Content="浏览..." Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding BrowseLogFolderCommand}"/>
                            <Button Grid.Column="2" Content="打开" Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenLogFolderCommand}"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="日志记录级别:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBoxStyle}" SelectedIndex="{Binding LogLevelIndex}">
                                <ComboBoxItem Content="调试 Debug - 全量记录 (产线慎用)"/>
                                <ComboBoxItem Content="信息 Info - 推荐产线使用"/>
                                <ComboBoxItem Content="警告 Warn - 仅警告与错误"/>
                                <ComboBoxItem Content="错误 Error - 仅错误"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="* 低于所选级别的日志将被丢弃" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="日志保留天数 (天):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            <TextBlock Grid.Column="2" Text="* 超过保留天数的日志文件自动清理" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="单个日志文件上限 (MB):" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Grid.Column="1" Text="{Binding LogMaxFileSizeMB, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
                            <TextBlock Grid.Column="2" Text="* 超过后自动滚动新文件 (.1/.2...)" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <CheckBox Content="启用结构化 JSON 落盘 (.jsonl，供数据分析 / AI 分析使用)" 
                                  IsChecked="{Binding LogJsonEnabled}"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  Margin="0,0,0,16"/>

                        <Border Background="#1E1E1E" CornerRadius="4" Padding="12">
                            <TextBlock Text="💡 提示: 日志配置保存后立即生效（无需重启）。结构化 JSON 与文本日志共用目录与滚动/清理策略；写盘失败会自动弹出告警。" 
                                       Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>