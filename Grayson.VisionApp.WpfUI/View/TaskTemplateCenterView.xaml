<UserControl x:Class="Grayson.Vision.WpfUI.View.TaskTemplateCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1180"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <!-- ===== 页头 ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 刷新" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"
                            Margin="6,0,0,0" Command="{Binding RefreshCommand}"/>
                    <Button Content="🗑 删除" Style="{StaticResource DangerButtonStyle}" Padding="12,5"
                            Margin="6,0,0,0" Command="{Binding DeleteCommand}" ToolTip="删除选中模板（含绑定工位解绑）"/>
                    <Button Content="📋 复制" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"
                            Margin="6,0,0,0" Command="{Binding DuplicateCommand}" ToolTip="复制为草稿副本"/>
                    <Button Content="✏️ 编辑" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"
                            Margin="6,0,0,0" Command="{Binding EditCommand}"/>
                    <Button Content="＋ 新建任务（行业目录）" Style="{StaticResource PrimaryButtonStyle}" Padding="14,5"
                            Margin="6,0,0,0" Command="{Binding NewCommand}" ToolTip="行业全量任务类型目录——引导定位/深度学习/外观测量已实现，其余规划中"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🗂️ 任务模板中心" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="把“执行方案 + 视觉链 + 资产 + 输出契约”沉淀为可复用任务模板 —— 三类经典任务：引导定位（工位联动）／深度学习推理、外观测量（独立纯软件）"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 统计卡 ===== -->
        <UniformGrid DockPanel.Dock="Top" Columns="6" Margin="0,0,0,10">
            <Border Style="{StaticResource CardBorderStyle}" Padding="10,6" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="模板总数" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="10,6" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="🧭 引导定位" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding GuidanceCount}" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="10,6" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="🧠 深度学习推理" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding DlCount}" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="10,6" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="📏 外观测量" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding MeasureCount}" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="10,6" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="已发布" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding PublishedCount}" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" Padding="10,6">
                <StackPanel><TextBlock Text="工位引用数" Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding BoundStationCount}" FontSize="20" FontWeight="Bold"/></StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== 筛选 ===== -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="10,8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="类型：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center"/>
                <ComboBox Width="150" Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding KindFilterOptions}" SelectedItem="{Binding SelectedKindOption}"/>
                <TextBlock Text="运行载体：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <ComboBox Width="130" Style="{StaticResource ModernComboBoxStyle}"
                          ItemsSource="{Binding DepFilterOptions}" SelectedItem="{Binding SelectedDepOption}"/>
                <TextBlock Text="搜索：" Style="{StaticResource FormLabelStyle}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBox Width="260" Style="{StaticResource ModernTextBoxStyle}" VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="按模板代码 / 名称 / 摘要模糊搜索"/>
                <TextBlock Text="提示：任务模板可复用于多个工位；工位装配与监视【启动】在工位工作台完成（引导定位类映射执行方案引擎）。"
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== 列表 ===== -->
        <DataGrid Style="{StaticResource ModernDataGridStyle}"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  RowHeight="34" FontSize="12.5">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="任务类型" Width="128">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="9" Padding="8,2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                    Background="{Binding KindBrush}">
                                <TextBlock Text="{Binding KindBadge}" FontSize="11.5" FontWeight="Bold" Foreground="#0F1117"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="模板代码" Binding="{Binding Code}" Width="112"/>
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="52"/>
                <DataGridTemplateColumn Header="运行载体" Width="96">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DependencyText}" VerticalAlignment="Center" Foreground="#A8B3C0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="64"/>
                <DataGridTextColumn Header="关键资产 / 视觉链" Binding="{Binding AssetText}" Width="230"/>
                <DataGridTextColumn Header="图像源" Binding="{Binding ImageText}" Width="150"/>
                <DataGridTemplateColumn Header="绑定工位" Width="*" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding BoundText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding BoundText}" Foreground="#A8B3C0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="更新" Binding="{Binding UpdatedText}" Width="78"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
