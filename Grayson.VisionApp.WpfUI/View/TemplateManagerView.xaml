                                    <ComboBox Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" Width="200" Height="22" FontSize="11"
                                              Style="{StaticResource ModernComboBoxStyle}"
                                              ItemsSource="{Binding DatumKindOptions}" SelectedIndex="{Binding DatumKindIndex}"
                                              ToolTip="基准点精测方式（顺序=TemplateDatumKind 枚举）：固定点=匹配锚点直出；圆心精测/两线交点精测=运行时以所选卡尺边缘点亚像素覆盖锚点（需要先有对应类型且启用的卡尺）"/>

                                    <!-- 行2：按方式切换的参数区（三种面板同一单元格互斥显示） -->
                                    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                                        <!-- A. 固定点：显式绝对坐标（0,0=自动） -->
