<UserControl x:Class="Grayson.Vision.WpfUI.View.TemplateManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Grayson.Vision.HalconWrapper.Wpf.Controls;assembly=Grayson.Vision.HalconWrapper.Wpf"
             xmlns:conv="clr-namespace:Grayson.Vision.WpfUI.Common.Converters"
             mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="1120"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToStepBrushConverter x:Key="StepTextConv"/>

        <!-- P1 分步引导：步骤段按钮（无边框胶囊，悬停微亮） -->
        <Style x:Key="StepSegmentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 源图模式分段按钮（RadioButton 无圆形 glyph 的胶囊样式） -->
        <Style x:Key="SegmentRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4"
                                Padding="14,6" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF0078D4"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF0078D4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 页头：标题 + 定位胶囊 + 模式说明 + 回全库（原 TemplateWorkbenchView 壳 UI 合并下沉，页面单层化） -->
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="← 回全库"
                        Style="{StaticResource SecondaryButtonStyle}" Padding="12,5" VerticalAlignment="Center"
                        Command="{Binding BackToGlobalCommand}"
                        Visibility="{Binding IsStationScope, Converter={StaticResource BoolToVis}}"
                        ToolTip="解除工位定位，回到全库浏览模式"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯 模板工作台" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="#1E378ADD" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="定位：" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ScopeChipText}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding ScopeHintText}"
                           FontSize="11.5" Foreground="{StaticResource TextDisabledBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </DockPanel>
        </Border>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：模板库列表 ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Padding="8" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="视觉模板库" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="+ 新建" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding NewTemplateCommand}" Height="28" Padding="8,0"
                                ToolTip="清空右侧向导，重新选择源图创建模板"/>
                        <Button Content="🗑 删除" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding DeleteTemplateCommand}" Height="28" Padding="8,0" Margin="4,0,0,0"
                                ToolTip="删除选中模板（引用该模板的匹配节点需改选其他模板）"/>
                    </StackPanel>
                </Grid>

                <ListBox Grid.Row="2" ItemsSource="{Binding Templates}"
                         SelectedItem="{Binding SelectedTemplate}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 状态灯 (绿:模板文件存在, 红:文件缺失) -->
                                <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModelFileExists}" Value="True">
                                                    <Setter Property="Fill" Value="#FF107C41"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ModelFileExists}" Value="False">
                                                    <Setter Property="Fill" Value="#FFA80000"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <!-- 匹配类型 Tag -->
                                        <Border Background="#7F5BB8" CornerRadius="3" Padding="4,2" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding Type}" Foreground="White" FontSize="10"/>
                                        </Border>
                                        <!-- 自测分 Tag（-1 = 未执行） -->
                                        <Border Background="#605E5C" CornerRadius="3" Padding="4,2" Margin="0,0,4,0"
                                                ToolTip="创建时质量自测分（≥0.9 合格）；-1 表示未执行。真正合格还要过【实拍验证】两步法">
                                            <TextBlock Text="{Binding QualityScore, StringFormat=自测 {0:F2}}"
                                                       Foreground="White" FontSize="10"/>
                                        </Border>
                                        <!-- 创建日期 Tag -->
                                        <Border Background="#0078D4" CornerRadius="3" Padding="4,2">
                                            <TextBlock Text="{Binding CreateTime, StringFormat={}{0:MM-dd HH:mm}}"
                                                       Foreground="White" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="🔄 刷新" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 右侧：模板创建向导 ==================== -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" Padding="12" CornerRadius="4">
            <!-- 双区布局(2026-09-09 抽屉化)：col0=主区(步骤条+图像+报告+操作条)，图像行占满；
                 col1=分隔条(可拖宽) ；col2=属性抽屉(参数分组 Expander，可整体收起/展开) -->
                        <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="7"/>
                    <ColumnDefinition Width="Auto" x:Name="DrawerCol"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*" MinHeight="140"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 头部 -->
                <Grid Grid.Row="0">
                    <TextBlock Text="创建视觉模板" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="模板按名称被 ShapeMatch / NccMatch 节点引用"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <Button Content="✏️ 编辑选中" Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0"
                                Height="26" Padding="10,0"
                                Command="{Binding EditTemplateCommand}"
                                ToolTip="把左侧选中模板载入右侧编辑器（参数+源图+掩膜），修改后点【🚀 创建模板】即同名覆盖重学，引用该模板的节点无需改动"/>
                        <Button x:Name="BtnExpandDrawer" Content="⚙ 展开面板" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="10,0,0,0" Height="26" Padding="10,0" Visibility="Collapsed"
                                Click="BtnToggleDrawer_Click"
                                ToolTip="展开右侧属性抽屉（📐卡尺/🖊掩膜/📍特征/🔍搜索框等编辑面板）——抽屉收起时点这里找回"/> 
                    </StackPanel>
                </Grid>

                <!-- P1 分步引导：步骤条 + 当前步横幅（轻量向导，不锁各区块；点步骤直达） -->
                <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="10,6">
                    <StackPanel>
                        <UniformGrid Rows="1" Margin="0,0,0,5">
                            <Button Style="{StaticResource StepSegmentButtonStyle}" Tag="0" Click="StepBtn_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#FF0078D4" VerticalAlignment="Center">
                                        <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" 选源图" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Step0Active, Converter={StaticResource StepTextConv}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource StepSegmentButtonStyle}" Tag="1" Click="StepBtn_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#FF0078D4" VerticalAlignment="Center">
                                        <TextBlock Text="2" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" 框学习框" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Step1Active, Converter={StaticResource StepTextConv}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource StepSegmentButtonStyle}" Tag="2" Click="StepBtn_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#FF8C6D1F" VerticalAlignment="Center">
                                        <TextBlock Text="3" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" 掩膜∪/∖" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Step2Active, Converter={StaticResource StepTextConv}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource StepSegmentButtonStyle}" Tag="3" Click="StepBtn_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#FF7F5BB8" VerticalAlignment="Center">
                                        <TextBlock Text="4" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" 特征/基准" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Step3Active, Converter={StaticResource StepTextConv}}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource StepSegmentButtonStyle}" Tag="4" Click="StepBtn_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#FF107C41" VerticalAlignment="Center">
                                        <TextBlock Text="5" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text=" 参数与创建" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Step4Active, Converter={StaticResource StepTextConv}}"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <Border Background="#1E0078D4" CornerRadius="3" Padding="8,4">
                            <TextBlock Text="{Binding WizardStepHint}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 源图模式与采集操作 -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton Content="📁 本地图片" GroupName="TemplateSrcMode"
                                     IsChecked="{Binding IsFileMode}" Style="{StaticResource SegmentRadioStyle}"/>
                        <RadioButton Content="📷 相机采集" GroupName="TemplateSrcMode" Margin="4,0,0,0"
                                     IsChecked="{Binding IsCameraMode}" Style="{StaticResource SegmentRadioStyle}"/>
                    </StackPanel>

                    <!-- 本地图片模式 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                Visibility="{Binding IsFileMode, Converter={StaticResource BoolToVis}}">
                        <Button Content="📂 载入图片..." Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding LoadImageCommand}" Padding="14,6"/>
                        <TextBlock Text="支持 png / bmp / jpg / tif"
                                   Foreground="{DynamicResource TextDisabledBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- 相机模式（快照一帧） -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                Visibility="{Binding IsCameraMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="相机:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox Width="220" Style="{StaticResource ModernComboBoxStyle}"
                                  ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeviceKey}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="📸 采集一帧" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AcquireImageCommand}" Padding="14,6" Margin="8,0,0,0"
                                ToolTip="连接相机连续取流，收到第一帧立即停流并上屏（不长期占用取流）"/>
                    </StackPanel>

                    <Button Grid.Column="3" Content="🧹 清除 ROI" Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnClearRoi_Click" Padding="14,6" VerticalAlignment="Center"
                            ToolTip="清空已框选的 ROI 数值"/>
                </Grid>

                <!-- 图像显示 + ROI 编辑（使用视图内置绘制/选择工具；RoiCommitted/RoiEdited 写回 VM，见 code-behind） -->
                <Grid Grid.Row="6" ClipToBounds="True" Background="#FF111111" x:Name="ImageArea">
                    <controls:HalconImageDisplayHost x:Name="ImageHost" DataContext="{Binding DisplayVm}"
                                                     PersistRoiInScene="False"
                                                     ShowToolbar="True"/>

                    <!-- 空态提示（未加载图像时） -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#CC000000" CornerRadius="6" Padding="20,14"
                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <StackPanel>
                            <TextBlock Text="🖼️ 尚未加载源图像" FontSize="15" FontWeight="Bold"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="请在上方选择【本地图片】载入文件，或切换【相机采集】抓取一帧"
                                       Foreground="#CCCCCC" FontSize="12" Margin="0,6,0,0"/>
                            <TextBlock Text="图像上屏后：点视图顶部工具栏的【📐▾】下拉选【▭ 平行矩形】，在图上按住左键拖出模板区域，右键完成创建（绿色草绘→黄框）"
                                       Foreground="#CCCCCC" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="创建后可点 🖱 选择工具点选黄框：拖内部移动 · 拖四角手柄改大小 · 右键删除/改色 · 改完点【创建模板】"
                                       Foreground="#999999" FontSize="11" Margin="0,4,0,0"/>
                            <TextBlock Text="技巧：滚轮以鼠标为锚缩放 · 空白左键拖拽平移 · 🔍 框选放大看细节，放大后再框更紧的 ROI"
                                       Foreground="#999999" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- 模板体检报告（创建成功 / 实拍验证后常驻显示） -->
                <Border Grid.Row="8" Style="{StaticResource CardBorderStyle}" Padding="10"
                        BorderBrush="{Binding QualityReportBrush}"
                        Visibility="{Binding QualityReportVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="📋 模板体检报告" FontWeight="Bold" FontSize="13"
                                       Foreground="{Binding QualityReportBrush}"/>
                            <Button Content="✕" HorizontalAlignment="Right" Width="22" Height="22"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="0"
                                    ToolTip="关闭报告" Click="BtnCloseQualityReport_Click"/>
                        </Grid>
                        <TextBlock Text="{Binding QualityReportText}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{Binding QualityReportBrush}" Margin="0,6,0,0"
                                   LineHeight="18"/>
                    </StackPanel>
                </Border>


                <!-- 底部：状态 + 创建 + 验证 -->
                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
                    <Button Grid.Column="1" Content="🧠 模板学习" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding LearnTemplateCommand}" Padding="14,9" Margin="0,0,8,0" FontSize="13"
                            ToolTip="按当前 ROI/掩膜/卡尺/基准点在内存学习一次（不写盘）：把将学到的模板轮廓画上屏 + 同链自测给分数。编辑掩膜/几何/参数后可再次点击重新学习；满意后再点【创建模板】落盘"/>
                    <Button Grid.Column="2" Content="🔍 实拍验证" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding VerifyTemplateCommand}" Padding="14,9" Margin="0,0,8,0"
                            FontSize="13"
                            ToolTip="相机模式会先自动重采一帧再匹配（无需先点采集）；本地图片模式用当前显示的图。低门槛(0.4)匹配选中模板，并把轮廓+十字+分数画到图上。两步法：验证一次 → 挪目标≥20mm 再验证一次，两次分数≥0.7 且位置跟着目标走才算合格（防锁死背景）"/>
                    <Button Grid.Column="3" Content="🚀 创建模板" Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding CreateTemplateCommand}" Padding="22,9"
                            FontSize="14" FontWeight="Bold"
                            ToolTip="按当前参数生成模板并落盘（后台线程执行 HALCON 算子）"/>

                </Grid>
                </Grid>
                <!-- ============ col1/col2：分隔条 + 属性抽屉（可收起；组可折叠） ============ -->
                <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="True">
                    <GridSplitter.Style>
                        <Style TargetType="GridSplitter">
                            <Setter Property="Background" Value="#22333333"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF0078D4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </GridSplitter.Style>
                </GridSplitter>
                <Border Grid.Column="2" x:Name="DrawerPanel" Width="560" Background="#FF1F1F1F" CornerRadius="4" Padding="9">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="2,0,2,7">
                            <TextBlock Text="⚙ 模板参数" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Button Content="» 收起面板" HorizontalAlignment="Right" FontSize="11" Height="22" Padding="8,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="BtnToggleDrawer_Click"
                                    ToolTip="收起属性抽屉：图像区吃满剩余宽度（点主区右上 ⚙ 展开）"/>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly">
                            <StackPanel>
                <Expander IsExpanded="True" Margin="0,0,0,6">
                    <Expander.Header>
                        <Border Background="#14FFFFFF" CornerRadius="3" Padding="8,5" Margin="0,1,0,0">
                            <TextBlock Text="📄 基本信息" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="模板名称/类型/备注/归属工位" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </Expander.Header>
                    <Border Background="#0EFFFFFF" CornerRadius="3" Padding="8,6" Margin="0,4,0,0">
<Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="模板名称:" VerticalAlignment="Center" Style="{StaticResource FormLabelStyle}"/>
