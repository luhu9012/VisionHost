                                    </Grid>

                                    <!-- 行4：方式/来源操作提示 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                               Text="{Binding DatumKindHint}" FontSize="10.5" TextWrapping="Wrap" Margin="0,1,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               ToolTip="基准点方式与来源的操作提示；创建/学习时按此快照落盘（来源失效自动回退锚点直出并提示）"/>
                                    
                                </Grid>

                                <!-- 资产状态行 -->
                                <TextBlock Grid.Row="4" Text="{Binding CaliperStatusText}" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           ToolTip="卡尺统计。L1/L2/点数/阈值逐条可调，紫色测量带实时跟手；创建时只有勾选启用的卡尺随模板落盘"/>

                                <!-- 逐条参数表头 -->
                                <Grid Grid.Row="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="卡尺（几何见提示）" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="启用" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"
                                               ToolTip="是否参与匹配后精测（不勾=保留配置但跳过）"/>
                                    <TextBlock Grid.Column="2" Text="L1" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"
                                               ToolTip="线卡尺=探针沿边散布半跨距；圆卡尺=目标半径（px）"/>
                                    <TextBlock Grid.Column="3" Text="L2" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"
                                               ToolTip="线卡尺=跨边探测半长；圆卡尺=环形半宽（采样带厚度，px）"/>
                                    <TextBlock Grid.Column="4" Text="探宽" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"
                                               ToolTip="线卡尺：单探针沿边平均半宽（px，默认 2）"/>
                                    <TextBlock Grid.Column="5" Text="点数" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"
                                               ToolTip="线卡尺=沿边探针数；圆卡尺=圆周探针数（1=自适应整环，默认 7）"/>
                                    <TextBlock Grid.Column="6" Text="阈值" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}" VerticalAlignment="Center"
                                               ToolTip="边缘对比度阈值（灰度差，默认 30；太小=抓噪声，太大=漏边）"/>
                                </Grid>

                                <!-- 卡尺行列表（参数编辑实时写回 → 紫色测量带跟手） -->
                                <ScrollViewer Grid.Row="7" MaxHeight="116" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                <ItemsControl ItemsSource="{Binding CaliperRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86"/>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="46"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="10.5" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding GeometryHint}"/>
                                                <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                          ToolTip="参与匹配后精测"/>
                                                <TextBox Grid.Column="2" Text="{Binding Length1, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ModernTextBoxStyle}" Height="20" FontSize="10.5" Padding="2,0"
                                                         ToolTip="{Binding GeometryHint}"/>
                                                <TextBox Grid.Column="3" Text="{Binding Length2, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ModernTextBoxStyle}" Height="20" FontSize="10.5" Padding="2,0"/>
                                                <TextBox Grid.Column="4" Text="{Binding ProbeWidth, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ModernTextBoxStyle}" Height="20" FontSize="10.5" Padding="2,0"/>
                                                <TextBox Grid.Column="5" Text="{Binding NumPoints, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ModernTextBoxStyle}" Height="20" FontSize="10.5" Padding="2,0"/>
                                                <TextBox Grid.Column="6" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ModernTextBoxStyle}" Height="20" FontSize="10.5" Padding="2,0"/>
                                                <Button Grid.Column="7" Content="✖" FontSize="10" Width="20" Height="20" Padding="0"
                                                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnRemoveCaliper_Click"
                                                        ToolTip="删除这条卡尺" VerticalAlignment="Center"/>
                                            </Grid>
                                            <!-- 圆/弧卡尺弧段参数（起角/跨角 °；线卡尺隐藏）——拖 1 个整圆后可改成局部圆弧 -->
                                            <Grid Margin="0,1,0,3">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsArcEditable}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86"/>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="54"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="弧段起/跨角°:" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           ToolTip="圆/弧卡尺角段：起角=起始角、跨角=张角（°；跨角 360=整圆环，改小即局部圆弧）。图像坐标 0°=圆心向右，正向=朝图像下行旋转"/>
                                                <TextBox Grid.Column="1" Text="{Binding ArcStartDeg, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ModernTextBoxStyle}" Height="19" FontSize="10.5" Padding="2,0"
                                                         ToolTip="弧段起始角（°；0=圆心右侧，正向=朝下行旋转）"/>
                                                <TextBox Grid.Column="3" Text="{Binding ArcExtentDeg, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource ModernTextBoxStyle}" Height="19" FontSize="10.5" Padding="2,0"
                                                         ToolTip="弧段张角（°；360=整圆环，改小即圆弧。拟合仍按全部有效边缘点求整圆圆心/半径）"/>
                                            </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </ScrollViewer>
                                <!-- 批3：图上拖绘/编辑模式开关（开启后行以宿主形状回注、新笔画即卡尺；与掩膜/特征/搜索框互斥见 VM） -->
                                <Grid Grid.Row="8" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkCaliperDraw" Grid.Column="0" IsChecked="{Binding CaliperDrawMode}"
                                              FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}"
                                              Click="ChkCaliperDraw_Click" VerticalAlignment="Center"
                                              ToolTip="开关卡尺图上拖绘/编辑：开=在图上直接画卡尺（视图工具条 📐▾ 的 〰线/⭘圆/▭▣旋转矩形），画好的青色形状可点选拖动/拉手柄微调，行与形状双向同步；关=回到静态紫带预览"/>
                                    <TextBlock Grid.Column="2" Text="画 〰线=线卡尺 / ⭘圆=圆卡尺 / ▭▣旋转矩形=四边卡尺；青色形状可拖动微调；行内 ✖ / Delete 删除"
                                               FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </Grid>
                        </Border>


                    </Border>
                </Expander>                <Expander IsExpanded="False" Margin="0,0,0,6">
                    <Expander.Header>
                        <Border Background="#14FFFFFF" CornerRadius="3" Padding="8,5" Margin="0,1,0,0">
                            <TextBlock Text="🖊 学习掩膜" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="涂抹∪/∖ 编辑学习域：灰化预览=引擎将学内容；改后【模板学习】刷新" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </Expander.Header>
                    <Border Background="#0EFFFFFF" CornerRadius="3" Padding="8,6" Margin="0,4,0,0">
                        <Border BorderBrush="#33555555" BorderThickness="1" CornerRadius="4" Padding="8,5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="4"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 行0：开关 + 模式 + 撤销/清空（归属工位移入基本信息组，抽屉窄栏） -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🖊 学习掩膜:" FontWeight="Bold" VerticalAlignment="Center" FontSize="11"
                                               ToolTip="用区域并∪/差∖把 ROI 内编辑成一块“学习域版图”（引擎按此 reduce_domain 学模板）：点工具条 🖌 涂抹自动开启；也可先勾选本开关再用 📐▾ 画矩形/圆等精确区域，每笔实时并入整域"/>
                                    <CheckBox Grid.Column="2" Content="掩膜编辑中" VerticalAlignment="Center" FontSize="11"
                                              IsChecked="{Binding MaskEditVisible}"
                                              ToolTip="开启后：图上的涂抹/形状实时并入“学习域版图”（整域 ∪/∖），画面灰化预览即引擎将学内容；关闭后绘制仅作用于基底 ROI"/>
                                    <RadioButton Grid.Column="4" Content="保留 ∪" GroupName="MaskMode" FontSize="11"
                                                 IsChecked="{Binding MaskAddMode}" Style="{StaticResource SegmentRadioStyle}"
                                                 ToolTip="∪ 模式：涂/画的区域=版图（第一笔把学习域定义为所涂处，之后越涂越大）"/>
                                    <RadioButton Grid.Column="6" Content="排除 ∖" GroupName="MaskMode" FontSize="11"
                                                 IsChecked="{Binding MaskRemoveMode}" Style="{StaticResource SegmentRadioStyle}"
                                                 ToolTip="∖ 模式：涂/画的区域从版图上实时抠洞——最常用于剔除 ROI 内的字符/划痕/背景纹理干扰"/>
                                    <Button Grid.Column="8" Content="↩ 撤销上笔" FontSize="10.5" Height="22" Padding="8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding UndoMaskCommand}"
                                            ToolTip="撤销最后一笔 ∪/∖：学习域版图实时回退到上一状态"/>
                                    <Button Grid.Column="10" Content="🧹 清空掩膜" FontSize="10.5" Height="22" Padding="8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ClearMaskCommand}"
                                            ToolTip="清空整块学习域版图（所有 ∪/∖ 笔画），回到整框 ROI 学习"/>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="{Binding MaskStatusText}" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           ToolTip="掩膜统计。创建/重学时学习域=(存在保留笔画? ∪保留∩ROI : ROI) − ∪排除；结果为空自动回退整 ROI 并记日志"/>
                                <!-- 行4：涂抹画笔半径滑杆 + 学习域预览状态 -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🖌 画笔半径:" FontSize="10.5" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <Slider Grid.Column="2" Minimum="2" Maximum="40"
                                            Value="{Binding MaskBrushRadius}" VerticalAlignment="Center"
                                            ValueChanged="MaskBrushSlider_ValueChanged"
                                            ToolTip="涂抹画笔半径（图像像素）：涂出的圆盘带宽度=2×半径；激活中拖动即时生效"/>
                                    <TextBlock Grid.Column="4" Text="{Binding MaskBrushRadiusText}" FontSize="10.5"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="5" Text="{Binding LearnPreviewStatus}" FontSize="10" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Foreground="#FF9CCB6B" Margin="4,0,0,0"
                                               ToolTip="学习域预览：掩膜编辑开启时显示帧自动切成“高亮=引擎将学内容”预览（域外灰化）；关闭恢复原图"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Expander>                <Expander IsExpanded="False" Margin="0,0,0,6">
                    <Expander.Header>
                        <Border Background="#14FFFFFF" CornerRadius="3" Padding="8,5" Margin="0,1,0,0">
                            <TextBlock Text="📍 模板特征" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="特征点/面随模板落盘（相对基准点偏移），识别后仿射显示" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </Expander.Header>
                    <Border Background="#0EFFFFFF" CornerRadius="3" Padding="8,6" Margin="0,4,0,0">
                        <Border BorderBrush="#33555555" BorderThickness="1" CornerRadius="4" Padding="8,5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="3"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="📍 模板特征:" FontWeight="Bold" VerticalAlignment="Center" FontSize="11"
                                               ToolTip="特征点/面随模板落盘，存的是相对基准点（模型锚点）的偏移。识别后按匹配位姿（vector_angle_to_rigid）仿射，特征跟模板一起转——十字=点、青色轮廓=面"/>
                                    <CheckBox Grid.Column="2" Content="特征标注中" VerticalAlignment="Center" FontSize="11"
                                              IsChecked="{Binding FeatureEditVisible}"
                                              ToolTip="开启后：图上绘制的每个形状=一个模板特征（点取中心/面保留形状）；关闭后绘制仅作用于基底 ROI（与掩膜编辑互斥）"/>
                                    <RadioButton Grid.Column="4" Content="⭕ 点" GroupName="FeatureKind" FontSize="11"
                                                 IsChecked="{Binding FeatureAddIsPoint}" Style="{StaticResource SegmentRadioStyle}"
                                                 ToolTip="特征点：画任意小形状取几何中心（越小越贴近目标角点/圆点），识别后画十字标记"/>
                                    <RadioButton Grid.Column="6" Content="▨ 面" GroupName="FeatureKind" FontSize="11"
                                                 IsChecked="{Binding FeatureAddIsFace}" Style="{StaticResource SegmentRadioStyle}"
                                                 ToolTip="特征面：保留所画形状作为闭合区域（矩形/圆/椭圆/多边形），识别后画其轮廓——用于量测/看区域"/>
                                    <Button Grid.Column="8" Content="↩ 撤销上笔" FontSize="10.5" Height="22" Padding="8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding UndoFeatureCommand}"
                                            ToolTip="撤销最后一个特征"/>
                                    <Button Grid.Column="10" Content="🧹 清空特征" FontSize="10.5" Height="22" Padding="8,0"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding ClearFeatureCommand}"
                                            ToolTip="清空全部特征标注"/>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="{Binding FeatureStatusText}" FontSize="10.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           ToolTip="特征统计。特征以基准点（模型锚点）为原点存偏移；创建/覆盖重学时随模板落盘，实拍验证/识别时按匹配位姿仿射显示"/>
                            </Grid>
                        </Border>
                    </Border>
                </Expander>                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
        </Grid>
    </DockPanel>
</UserControl>
