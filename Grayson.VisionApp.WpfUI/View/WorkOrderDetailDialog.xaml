<UserControl x:Class="Grayson.Vision.WpfUI.View.WorkOrderDetailDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="Microsoft YaHei UI"
             FontSize="14">

    <UserControl.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>      <!-- 标题栏 -->
            <RowDefinition Height="*"/>       <!-- 主内容 -->
            <RowDefinition Height="60"/>      <!-- 按钮栏 -->
        </Grid.RowDefinitions>

        <!-- ========== 标题栏 ========== -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundLightBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Vertical">
                    <TextBlock Text="工单详情" Style="{StaticResource TitleTextStyle}" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding WorkOrderId, StringFormat='工单ID: {0}'}" 
                               Style="{StaticResource CaptionTextStyle}" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- 结果状态徽章 -->
                <Border Grid.Column="1" VerticalAlignment="Center" 
                        Background="{Binding ResultStatusColor}" 
                        CornerRadius="8" Padding="15,8">
                    <TextBlock Text="{Binding ResultStatus}" Foreground="White" FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ========== 主内容区 ========== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel Orientation="Vertical">

                <!-- 1. 基本信息卡片 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Orientation="Vertical" Margin="15">
                        <TextBlock Text="基本信息" Style="{StaticResource SectionTitleTextStyle}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 工单ID -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="工单ID:" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding WorkOrderId}" 
                                       Foreground="{StaticResource AccentBrush}" FontFamily="Courier New"/>

                            <!-- 工位ID -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="工位ID:" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StationId}"/>

                            <!-- 批号 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="批号:" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BatchId}"/>

                            <!-- 配方 -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="配方:" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RecipeName}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分隔距离 -->
                <Border Height="15" Background="Transparent"/>

                <!-- 2. 执行过程时间线 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Orientation="Vertical" Margin="15">
                        <TextBlock Text="执行过程" Style="{StaticResource SectionTitleTextStyle}"/>

                        <!-- 时间线 -->
                        <Grid Margin="0,12,0,0" Height="50">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Created -->
                            <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Center">
                                <Ellipse Width="16" Height="16" Fill="{StaticResource AccentBrush}"/>
                                <TextBlock Text="创建" TextAlignment="Center" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='HH:mm:ss'}" 
                                       VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>

                            <!-- Arrow -->
                            <TextBlock Grid.Column="2" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BorderColor}"/>

                            <!-- Started -->
                            <StackPanel Grid.Column="3" Orientation="Vertical" HorizontalAlignment="Center">
                                <Ellipse Width="16" Height="16" Fill="{StaticResource WarningBrush}"/>
                                <TextBlock Text="开始" TextAlignment="Center" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="4" Text="{Binding StartedAt, StringFormat='HH:mm:ss'}" 
                                       VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>

                            <!-- Arrow -->
                            <TextBlock Grid.Column="5" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource BorderColor}"/>
                        </Grid>

                        <!-- Completed -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse Width="16" Height="16" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="完成" FontSize="11" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding CompletedAt, StringFormat='HH:mm:ss'}" 
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="20,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 分隔距离 -->
                <Border Height="15" Background="Transparent"/>

                <!-- 3. 检验结果卡片 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Orientation="Vertical" Margin="15">
                        <TextBlock Text="检验结果" Style="{StaticResource SectionTitleTextStyle}"/>

                        <!-- 置信度 -->
                        <StackPanel Orientation="Vertical" Margin="0,12,0,0">
                            <TextBlock Text="AI 置信度"/>
                            <ProgressBar Value="{Binding ConfidenceScore}" Maximum="1.0" Height="20" 
                                        Foreground="{StaticResource AccentBrush}" 
                                        Background="{StaticResource BackgroundCardBrush}" 
                                        Margin="0,8,0,8"/>
                            <TextBlock Text="{Binding ConfidenceScoreText}" HorizontalAlignment="Right" 
                                       Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- 缺陷标签 -->
                        <TextBlock Text="缺陷分类" Margin="0,15,0,0"/>
                        <ItemsControl ItemsSource="{Binding DefectTags}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding SeverityColor}" CornerRadius="4" Padding="10,6" Margin="0,0,8,8" Opacity="0.9">
                                        <TextBlock Text="{Binding DefectCode}" Foreground="White" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 错误信息 -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" 
                                   TextWrapping="Wrap" Margin="0,15,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 分隔距离 -->
                <Border Height="15" Background="Transparent"/>

                <!-- 4. 时间分解甘特图 -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Orientation="Vertical" Margin="15">
                        <TextBlock Text="时间分解" Style="{StaticResource SectionTitleTextStyle}"/>

                        <!-- 甘特图条形 -->
                        <Grid Height="30" Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource WarningBrush}" CornerRadius="3,0,0,3"/>
                            <Border Grid.Column="1" Background="{StaticResource SuccessBrush}"/>
                            <Border Grid.Column="2" Background="{StaticResource InfoBrush}" CornerRadius="0,3,3,0"/>
                        </Grid>

                        <!-- 图例与具体数值 -->
                        <ItemsControl ItemsSource="{Binding TimelineItems}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel IsItemsHost="True" Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8,0,0" Height="25">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Rectangle Grid.Column="0" Width="15" Height="15" Fill="{Binding Color}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DurationText}" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Courier New"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 总耗时 -->
                        <Border Background="{StaticResource BackgroundCardBrush}" Padding="10" CornerRadius="4" Margin="0,20,0,0">
                            <Grid>
                                <TextBlock Text="总耗时:" Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding TotalElapsedText}" HorizontalAlignment="Right" 
                                           Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="16" FontFamily="Courier New"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 分隔距离 -->
                <Border Height="15" Background="Transparent"/>

                <!-- 5. 图像展示 -->
                <Border Visibility="Visible">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ImagePaths.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Vertical" Margin="15">
                        <TextBlock Text="检验图像" Style="{StaticResource SectionTitleTextStyle}"/>

                        <!-- 主图像 -->
                        <Border Background="{StaticResource BackgroundCardBrush}" CornerRadius="4" Height="300" MinHeight="200" Margin="0,12,0,0">
                            <Image Source="{Binding SelectedImagePath}" Stretch="Uniform"/>
                        </Border>

                        <!-- 缩略图列表 -->
                        <TextBlock Text="缩略图" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,0"/>
                        <ItemsControl ItemsSource="{Binding ImagePaths}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundCardBrush}" 
                                            BorderThickness="2"
                                            BorderBrush="{StaticResource BorderColor}"
                                            CornerRadius="4" 
                                            Width="80" Height="60"
                                            Cursor="Hand"
                                            Margin="0,0,8,8">
                                        <Image Source="{Binding}" Stretch="UniformToFill"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 分隔距离 -->
                <Border Height="15" Background="Transparent"/>

                <!-- 6. 测量数据表 -->
                <Border Visibility="Visible">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MeasurementData.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Vertical" Margin="15">
                        <TextBlock Text="测量数据" Style="{StaticResource SectionTitleTextStyle}"/>

                        <!-- 表格头 -->
                        <Border Background="{StaticResource BackgroundCardBrush}" CornerRadius="4" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="项目名" FontWeight="Bold" Margin="10"/>
                                <TextBlock Grid.Column="1" Text="测量值" FontWeight="Bold" Margin="10"/>
                                <TextBlock Grid.Column="2" Text="状态" FontWeight="Bold" Margin="10"/>
                            </Grid>
                        </Border>

                        <!-- 表格行 -->
                        <ItemsControl ItemsSource="{Binding MeasurementData}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel IsItemsHost="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid Height="30">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding ItemName}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="10,0,0,0" FontFamily="Courier New" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="10,0,0,0" 
                                                       Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 分隔距离 -->
                <Border Height="15" Background="Transparent"/>

                <!-- 7. 操作员备注 -->
                <Border Visibility="Visible">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultComment}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Orientation="Vertical" Margin="15">
                        <TextBlock Text="操作员备注" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{Binding ResultComment}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 底部填充 -->
                <Border Height="20" Background="Transparent"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ========== 按钮栏 ========== -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundLightBrush}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20" VerticalAlignment="Center">
                <Button Content="导出图像" Margin="0,0,10,0"
                        Background="{StaticResource AccentBrush}" 
                        Foreground="White"
                        Padding="20,10" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ImagePaths.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="关闭" 
                        Background="{StaticResource BackgroundCardBrush}" 
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Padding="20,10" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
