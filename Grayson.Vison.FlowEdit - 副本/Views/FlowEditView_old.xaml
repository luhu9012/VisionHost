<UserControl x:Class="Grayson.Vison.FlowEdit.Views.FlowEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Grayson.Vison.FlowEdit"
             xmlns:vm="clr-namespace:Grayson.Vison.FlowEdit.ViewModels"
             xmlns:models="clr-namespace:Grayson.Vision.Contracts.Business.Models;assembly=Grayson.Vision.Contracts"
             xmlns:controls="clr-namespace:Grayson.Vison.FlowEdit.Controls"
             xmlns:cvts="clr-namespace:Grayson.Vison.FlowEdit.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 转换器定义 -->
            <cvts:BezierPathConverter x:Key="BezierPathConverter"/>
            <cvts:NullToCollapsed x:Key="NullToCollapsed"/>
            <cvts:NullToVisible x:Key="NullToVisible"/>
            <cvts:PortCategoryToCornerRadiusConv x:Key="PortCategoryToCornerRadiusConv"/>
            <cvts:HexToBrushConv x:Key="HexToBrushConv"/>
            <cvts:ConnectionThicknessConv x:Key="ConnectionThicknessConv"/>
            <cvts:ConnectionDashConv x:Key="ConnectionDashConv"/>


            <!--<ResourceDictionary.MergedDictionaries>

                --><!-- 引入独立拆分出的参数模板文件 --><!--
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vison.FlowEdit;component/Themes/NodeParamTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->


        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:FlowVm />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部控制栏 -->
        <Border Background="#2D2D30" Padding="8 0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="工业视觉流程编排器 (全量23节点)" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0 0 15 0"/>
                    <Button Content="💾 保存" Command="{Binding SaveRecipeCmd}" Background="#3E3E42" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>

                    <Button Content="📥 导入 JSON" Command="{Binding ImportRecipeCmd}" Background="#3E3E42" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Button Content="📤 导出 JSON" Command="{Binding ExportRecipeCmd}" Background="#3E3E42" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Separator Width="1" Background="#555" Margin="6 6"/>
                    <Button Content="🗑️ 清空画布" 
                        Command="{Binding ClearCanvasCommand}"
                        Background="#E74C3C" Foreground="White" 
                        Padding="8,4" Margin="0 0 4 0"
                        ToolTip="清空当前画布中的所有节点和连线"/>

                    <Button Content="✨ 自动重排" Command="{Binding AutoLayoutCmd}" Background="#2980B9" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Button Content="❌ 删除节点" Command="{Binding DeleteNodeCmd}" Background="#A93226" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <!-- 🌟 新增：保存为复合模板按钮 -->
                    <Button Content="📦 另存为模板" 
                    Command="{Binding SaveCurrentPipelineAsRecipeCommand}"
                    Background="#8E44AD" Foreground="White" Padding="8,4" Margin="0 0 4 0"
                    ToolTip="将当前画布中的子流程导出为 JSON 模板并刷新到左侧工具箱"/>
                    <Button Content="▶ 连续运行" Command="{Binding RunContinuousCmd}" Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Button Content="⏯ 单步运行" Command="{Binding StepRunCmd}" Background="#2980B9" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Button Content="⏸ 暂停" Command="{Binding PauseRunCmd}" Background="#D35400" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Button Content="⏹ 停止" Command="{Binding StopRunCmd}" Background="#C0392B" Foreground="White" Padding="10 4" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 面包屑导航 -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0 1 0 1" Padding="12 0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="当前流程层级: " Foreground="#888" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding ProcessName}" 
                                        Command="{Binding DataContext.NavigateToProcessCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" Foreground="#58ACFA" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                <TextBlock Text=" &gt; " Foreground="#666" Margin="4 0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：工具箱 -->
            <GroupBox Header="全量节点工具箱 (支持直接拖拽/双击)" Foreground="#AAA" BorderBrush="#3F3F46" Margin="4">
                <ListBox x:Name="ToolBoxListBox"
             ItemsSource="{Binding ToolBoxGrouped}" 
             Background="#252526" 
             BorderThickness="0">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#007ACC" Margin="4 8 4 4"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- 增加了事件绑定：MouseLeftButtonDown, MouseMove, MouseDoubleClick(MouseLeftButtonDown) -->
                            <Border  Background="#333337" BorderBrush="#434346" BorderThickness="1" CornerRadius="4" Padding="8 6" Margin="0 2" Cursor="Hand"
                        PreviewMouseLeftButtonDown="ToolItem_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="ToolItem_PreviewMouseMove"
                       >
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding NodeId}" Foreground="#888" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <!-- 中间：画布 -->
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="#3F3F46" Margin="4" ClipToBounds="True">
                <ScrollViewer x:Name="FlowScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <ScrollViewer.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#1E1E1E">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,20,20"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,20,20"/>
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#252528" Thickness="1"/>
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </ScrollViewer.Background>

                    <!-- 找到 FlowCanvas 节点，修正 MouseEvents 绑定 -->
                    <Canvas x:Name="FlowCanvas" 
        Width="5000" Height="5000" 
        Background="Transparent" 
        AllowDrop="True" 
        Drop="Canvas_Drop" 
        DragOver="Canvas_DragOver" 
        MouseMove="FlowCanvas_MouseMove" 
        MouseLeftButtonDown="FlowCanvas_MouseLeftButtonDown" 
        PreviewMouseLeftButtonUp="FlowCanvas_PreviewMouseLeftButtonUp"  
        MouseRightButtonDown="FlowCanvas_MouseRightButtonDown" 
        MouseRightButtonUp="FlowCanvas_MouseRightButtonUp" 
        PreviewMouseWheel="FlowCanvas_PreviewMouseWheel" 
        PreviewMouseRightButtonDown="FlowCanvas_PreviewMouseRightButtonDown">
                        <Grid x:Name="ContentGrid">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>

                            <!-- 连线模板 -->
                            <ItemsControl ItemsSource="{Binding CurrentProcess.Connections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 绑定正确的 ConnectionCategory 属性 -->
                                        <Path Stroke="{Binding ConnectionColor, Converter={StaticResource HexToBrushConv}, FallbackValue=#007ACC}" 
                  StrokeThickness="{Binding Category, Converter={StaticResource ConnectionThicknessConv}}" 
                  StrokeDashArray="{Binding Category, Converter={StaticResource ConnectionDashConv}}"
                  Cursor="Hand"
             
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource BezierPathConverter}">
                                                    <Binding Path="StartX"/>
                                                    <Binding Path="StartY"/>
                                                    <Binding Path="EndX"/>
                                                    <Binding Path="EndY"/>
                                                </MultiBinding>
                                            </Path.Data>
                                            <Path.ContextMenu>
                                                <ContextMenu Background="#222" Foreground="#fff">
                                                    <MenuItem Header="❌ 删除连线" 
                                  Command="{Binding Path=PlacementTarget.Tag.DeleteConnectionCmd, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}" 
                                  CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Path.ContextMenu>
                                        </Path>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 拖拽连线 -->
                            <Path x:Name="TempPath" Stroke="Orange" StrokeThickness="2" StrokeDashArray="2 2" Visibility="Collapsed">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure x:Name="TempFigure">
                                            <BezierSegment x:Name="TempBezier"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>

                            <!-- 节点 -->
                            <ItemsControl ItemsSource="{Binding CurrentProcess.Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:FlowNodeBase}">
                                        <controls:NodeControl Node="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding PosX}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding PosY}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>
                    </Canvas>
                </ScrollViewer>
            </Border>

            <!-- 右侧：Inspector 参数面板 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <GroupBox Header="🛠️ 节点属性 Inspector" Foreground="#AAA" BorderBrush="#3F3F46" Margin="4">
                    <Grid>
                        <ScrollViewer Visibility="{Binding SelectedNode, Converter={StaticResource NullToCollapsed}}" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6">
                                <!-- 1. 基础信息卡片 -->
                                <UniformGrid Columns="2" Margin="0 0 0 6">
                                    <CheckBox Content="启用节点 (Enable)" IsChecked="{Binding SelectedNode.Enable}" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SelectedNode.Type, StringFormat='类型: {0}'}" Foreground="#888" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </UniformGrid>

                                <TextBlock Text="DisplayName (节点名称):" Foreground="#AAA" FontSize="10"/>
                                <TextBox Text="{Binding SelectedNode.DisplayName, UpdateSourceTrigger=PropertyChanged}" Background="#252526" Foreground="White" BorderBrush="#555" Margin="0 2 0 6" Padding="4"/>

                                <!-- 2. 中文指南卡片 -->
                                <Border Background="#1E1E1E" CornerRadius="4" Padding="8" Margin="0 4 0 6" BorderBrush="#333" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="💡 节点说明:" Foreground="#E67E22" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedNode.Description}" Foreground="#DDD" FontSize="11" TextWrapping="Wrap" Margin="0 2 0 4"/>

                                        <TextBlock Text="📖 使用指南:" Foreground="#3498DB" FontWeight="Bold" FontSize="11"/>
                                        <TextBlock Text="{Binding SelectedNode.UsageGuide}" Foreground="#AAA" FontSize="10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- 3. 动态参数配置区 -->
                                <TextBlock Text="⚙️ 业务参数设置:" Foreground="#007ACC" FontWeight="Bold" FontSize="11" Margin="0 4 0 4"/>
                                <ContentControl Content="{Binding SelectedNode.ParameterModel}"/>

                                <Separator Background="#3F3F46" Margin="0 8"/>

                                <!-- 4. 端口数据实时调试监控 -->
                                <Expander Header="🔌 端口数据监控与调试" IsExpanded="True" Foreground="#AAA" Margin="0 2 0 0">
                                    <StackPanel Margin="0,4,0,0">
                                        <TextBlock Text="📥 输入端 (Inputs):" Foreground="#AAA" FontSize="10" FontWeight="Bold"/>
                                        <ItemsControl ItemsSource="{Binding SelectedNode.InputPorts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0 2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="7" Height="7" 
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrushConv}}" 
                                                CornerRadius="{Binding Category, Converter={StaticResource PortCategoryToCornerRadiusConv}}" 
                                                VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4 0 0 0">
                                                            <TextBlock Text="{Binding PortName}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding DataType, StringFormat=' ({0})'}" Foreground="#777" FontSize="9" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding DataValue, StringFormat='[{0}]'}" 
                                                   Foreground="#2ECC71" FontSize="10" 
                                                   HorizontalAlignment="Right" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding DataValue}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Separator Background="#333" Margin="0 4"/>

                                        <TextBlock Text="📤 输出端 (Outputs):" Foreground="#AAA" FontSize="10" FontWeight="Bold"/>
                                        <ItemsControl ItemsSource="{Binding SelectedNode.OutputPorts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0 2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="12"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="7" Height="7" 
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrushConv}}" 
                                                CornerRadius="{Binding Category, Converter={StaticResource PortCategoryToCornerRadiusConv}}" 
                                                VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4 0 0 0">
                                                            <TextBlock Text="{Binding PortName}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding DataType, StringFormat=' ({0})'}" Foreground="#777" FontSize="9" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding DataValue, StringFormat='[{0}]'}" 
                                                   Foreground="#E67E22" FontSize="10" 
                                                   HorizontalAlignment="Right" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding DataValue}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Text="请在画布中选中任意节点查看其参数" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedNode, Converter={StaticResource NullToVisible}}" Foreground="#666"/>
                    </Grid>
                </GroupBox>

                <!-- SharedData 共享变量监控 -->
                <GroupBox Header="SharedData 共享变量监视" Grid.Row="1" Foreground="#AAA" BorderBrush="#3F3F46" Margin="4">
                    <DataGrid ItemsSource="{Binding WatchData}" AutoGenerateColumns="False" IsReadOnly="True" Background="#252526" RowBackground="#2D2D30" Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="90"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <!-- Console 运行日志 -->
                <GroupBox Header="运行控制台 (Console)" Grid.Row="2" Foreground="#AAA" BorderBrush="#3F3F46" Margin="4">
                    <ListBox x:Name="LogListBox" ItemsSource="{Binding ExecutionLogs}" 
         Background="#111" Foreground="#00FF66" FontFamily="Consolas" FontSize="11" BorderThickness="0"
         SelectionMode="Extended">
                        <ListBox.ContextMenu>
                            <ContextMenu Background="#222" Foreground="#fff" BorderBrush="#555">
                                <MenuItem Header="复制选中行" Click="CopySelectedLogRows"/>
                                <MenuItem Header="复制全部日志" Click="CopyAllLogRows"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>