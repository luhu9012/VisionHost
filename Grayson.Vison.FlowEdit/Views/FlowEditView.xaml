<UserControl x:Class="Grayson.Vison.FlowEdit.Views.FlowEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Grayson.Vison.FlowEdit"
             xmlns:vm="clr-namespace:Grayson.Vison.FlowEdit.ViewModels"
             xmlns:models="clr-namespace:Grayson.Vision.Contracts.Flow.Nodes;assembly=Grayson.Vision.Contracts"
             xmlns:controls="clr-namespace:Grayson.Vison.FlowEdit.Controls"
             xmlns:view ="clr-namespace:Grayson.Vison.FlowEdit.Views"
             xmlns:cvts="clr-namespace:Grayson.Vison.FlowEdit.Converters"
             xmlns:halconHost="clr-namespace:Grayson.Vision.HalconWrapper.Wpf.Controls;assembly=Grayson.Vision.HalconWrapper.Wpf">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 通用元数据转换器 -->
            <cvts:CategoryMetaConverter x:Key="CategoryMetaConverter"/>

            <!-- 其它布局与视觉转换器 -->
            <cvts:BezierPathConverter x:Key="BezierPathConverter"/>
            <cvts:NullToCollapsed x:Key="NullToCollapsed"/>
            <cvts:NullToVisible x:Key="NullToVisible"/>
            <cvts:PortCategoryToCornerRadiusConv x:Key="PortCategoryToCornerRadiusConv"/>
            <cvts:HexToBrushConv x:Key="HexToBrushConv"/>
            <cvts:ConnectionThicknessConv x:Key="ConnectionThicknessConv"/>
            <cvts:ConnectionDashConv x:Key="ConnectionDashConv"/>
            <cvts:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
            <cvts:BoolToTextConverter x:Key="BoolToTextConverter"/>

            <!-- 优化后的工具栏按钮样式 -->
            <Style x:Key="ToolBarBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="#2D2D30"/>
                <Setter Property="Foreground" Value="#DCDCDC"/>
                <Setter Property="BorderBrush" Value="#3F3F46"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8 4"/>
                <Setter Property="Margin" Value="2 0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="3" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 鼠标悬停 -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#3E3E42"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#007ACC"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <!-- 鼠标按下 -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#007ACC"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#005A9E"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <!-- 禁用状态：压暗背景与文字 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#1B1B1C"/>
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#2A2A2D"/>
                                    <Setter Property="Foreground" Value="#555555"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 图标型工具栏按钮：紧凑内边距，内容为纯 emoji 图标（配合 ToolTip 使用，节省横向空间） -->
            <Style x:Key="IconToolBarBtnStyle" TargetType="Button" BasedOn="{StaticResource ToolBarBtnStyle}">
                <Setter Property="Padding" Value="6 2"/>
                <Setter Property="MinWidth" Value="32"/>
            </Style>

            <!-- emoji 图标文本：统一字体族，前景继承按钮色（hover/禁用时自动跟随按钮变色，支持语义色区分） -->
            <Style x:Key="EmojiIconTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Emoji"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Style>

            <!-- ================= Dark Theme Custom Styles ================= -->
            <!-- 1. Dark TabControl Style -->
            <Style TargetType="TabControl">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="BorderBrush" Value="#3F3F46"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <!-- 2. Dark TabItem Style -->
            <Style TargetType="TabItem">
                <Setter Property="Background" Value="#252526"/>
                <Setter Property="Foreground" Value="#AAA"/>
                <Setter Property="BorderBrush" Value="#3F3F46"/>
                <Setter Property="BorderThickness" Value="1,1,1,0"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="3,3,0,0" 
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="ContentSite" 
                                                  VerticalAlignment="Center" 
                                                  HorizontalAlignment="Center" 
                                                  ContentSource="Header"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#1E1E1E"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#007ACC"/>
                                    <Setter TargetName="Border" Property="BorderThickness" Value="1,2,1,0"/>
                                    <Setter Property="Foreground" Value="#007ACC"/>
                                    <Setter Property="Panel.ZIndex" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 3. Dark DataGrid Style -->
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="#1E1E1E"/>
                <Setter Property="RowBackground" Value="#252526"/>
                <Setter Property="AlternatingRowBackground" Value="#2D2D30"/>
                <Setter Property="Foreground" Value="#DCDCDC"/>
                <Setter Property="BorderBrush" Value="#3F3F46"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#333337"/>
                <Setter Property="VerticalGridLinesBrush" Value="#333337"/>
            </Style>

            <!-- 4. Dark DataGrid Column Header Style -->
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#2D2D30"/>
                <Setter Property="Foreground" Value="#007ACC"/>
                <Setter Property="BorderBrush" Value="#3F3F46"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- 5. Dark DataGrid Cell Style -->
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border x:Name="CellBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="CellBorder" Property="Background" Value="#094771"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:FlowVm />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部控制栏 (精细化工业风) -->
        <Border Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="0 0 0 1" Padding="12 0">
            <DockPanel>
                <!-- 左侧：品牌与配方信息 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!--<StackPanel Orientation="Horizontal" Margin="0 0 16 0">
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4Z" 
                              Fill="#007ACC" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBlock Text="Grayson Vision" FontWeight="Bold" Foreground="#F1F1F1" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>-->

                 

                    <Border Background="#252526" CornerRadius="4" Padding="6 2" BorderBrush="#3F3F46" BorderThickness="1" VerticalAlignment="Center" Margin="0 0 8 0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="工位" Foreground="#AAAAAA" FontSize="11" Margin="0 0 6 0" VerticalAlignment="Center"/>
                            <ComboBox Width="220"
                                      ItemsSource="{Binding AvailableStations}"
                                    
                                      SelectedValuePath="StationId"
                                      SelectedValue="{Binding SelectedStationId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Background="#1E1E1E"
                                      Foreground="#DDDDDD"
                                      BorderBrush="#3F3F46"
                                      BorderThickness="1"
                                      Padding="4 2"
                                      FontSize="11">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Border Background="#2D2D30" CornerRadius="4" Padding="8 4" Margin="0 0 12 0" BorderBrush="#3F3F46" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{Binding IsDirty, Converter={StaticResource BoolToBrushConverter}, FallbackValue=#00FF66}" Margin="0 0 6 0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentRecipeInfo}" Foreground="#CCCCCC" FontSize="11" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                    <!--<Border Background="#252526" CornerRadius="4" Padding="6 2" BorderBrush="#3F3F46" BorderThickness="1" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding UseRemoteWorkerProcess, Mode=TwoWay}" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Cursor="Hand">
                            <TextBlock Text="{Binding UseRemoteWorkerProcess, Converter={StaticResource BoolToTextConverter}, FallbackValue='嵌入模式'}" 
                                       Foreground="{Binding UseRemoteWorkerProcess, Converter={StaticResource BoolToBrushConverter}}" FontSize="11" FontWeight="SemiBold"/>
                        </CheckBox>
                    </Border>-->
                </StackPanel>

                <!-- 右侧：运行控制组 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#252526" CornerRadius="4" Padding="3" BorderBrush="#3F3F46" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <!-- 运行按钮 (绿色主题，禁用时压暗) -->
                            <Button Command="{Binding RunContinuousCmd}" ToolTip="连续运行流程 (F5)">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconToolBarBtnStyle}">
                                        <Setter Property="Background" Value="#1E4620"/>
                                        <Setter Property="Foreground" Value="#4EC9B0"/>
                                        <Setter Property="BorderBrush" Value="#275D2B"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#1A251B"/>
                                                <Setter Property="Foreground" Value="#3F6355"/>
                                                <Setter Property="BorderBrush" Value="#1E3321"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="▶" Style="{StaticResource EmojiIconTextStyle}"/>
                            </Button>

                            <!-- 单步按钮 (青色图标) -->
                            <Button Command="{Binding StepRunCmd}" ToolTip="单步运行，逐节点执行 (F10)" Style="{StaticResource IconToolBarBtnStyle}" Foreground="#4FC1E9">
                                <TextBlock Text="⏯" Style="{StaticResource EmojiIconTextStyle}"/>
                            </Button>

                            <!-- 暂停按钮 (琥珀色图标) -->
                            <Button Command="{Binding PauseRunCmd}" ToolTip="暂停 / 继续当前运行" Style="{StaticResource IconToolBarBtnStyle}" Foreground="#FFC46B">
                                <TextBlock Text="⏸" Style="{StaticResource EmojiIconTextStyle}"/>
                            </Button>

                            <!-- 复位按钮 (蓝色图标) -->
                            <Button Command="{Binding ResetCmd}" ToolTip="复位流程至初始就绪状态 (Shift+F5)" Style="{StaticResource IconToolBarBtnStyle}" Foreground="#58ACFA">
                                <TextBlock Text="🔄" Style="{StaticResource EmojiIconTextStyle}"/>
                            </Button>

                            <!-- 停止按钮 (红色主题，禁用时压暗) -->
                            <Button Command="{Binding StopRunCmd}" ToolTip="停止运行" FontWeight="Bold">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconToolBarBtnStyle}">
                                        <Setter Property="Background" Value="#4A1818"/>
                                        <Setter Property="Foreground" Value="#F44336"/>
                                        <Setter Property="BorderBrush" Value="#662222"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#241414"/>
                                                <Setter Property="Foreground" Value="#663333"/>
                                                <Setter Property="BorderBrush" Value="#331A1A"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="⏹" Style="{StaticResource EmojiIconTextStyle}"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <!-- 中间：文件与画布编辑工具组 (纯 emoji 图标 + ToolTip，节省横向空间) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0 0 10 0">
                        <Button Command="{Binding SaveRecipeCmd}" ToolTip="保存当前配方" Style="{StaticResource IconToolBarBtnStyle}">
                            <TextBlock Text="💾" Style="{StaticResource EmojiIconTextStyle}"/>
                        </Button>
                        <Button Command="{Binding ImportRecipeCmd}" ToolTip="从文件导入配方" Style="{StaticResource IconToolBarBtnStyle}">
                            <TextBlock Text="📥" Style="{StaticResource EmojiIconTextStyle}"/>
                        </Button>
                        <Button Command="{Binding ExportRecipeCmd}" ToolTip="导出配方到文件" Style="{StaticResource IconToolBarBtnStyle}">
                            <TextBlock Text="📤" Style="{StaticResource EmojiIconTextStyle}"/>
                        </Button>
                    </StackPanel>

                    <Rectangle Width="1" Height="18" Fill="#3F3F46" Margin="4 0"/>

                    <StackPanel Orientation="Horizontal" Margin="10 0 0 0">
                        <Button Command="{Binding AutoLayoutCmd}" ToolTip="自动重排画布节点布局" Style="{StaticResource IconToolBarBtnStyle}">
                            <TextBlock Text="✨" Style="{StaticResource EmojiIconTextStyle}"/>
                        </Button>
                        <Button Command="{Binding RunPreflightCmd}" ToolTip="预检：检查流程节点与连线问题" Style="{StaticResource IconToolBarBtnStyle}">
                            <TextBlock Text="🔍" Style="{StaticResource EmojiIconTextStyle}"/>
                        </Button>
                        <Button Command="{Binding SaveCurrentPipelineAsRecipeCommand}" ToolTip="将当前流程另存为可复用模板" Style="{StaticResource IconToolBarBtnStyle}">
                            <TextBlock Text="📦" Style="{StaticResource EmojiIconTextStyle}"/>
                        </Button>
                        <Button Command="{Binding RenameProcessCmd}" ToolTip="重命名当前流程层级（面包屑上显示的名称，保存后生效）" Style="{StaticResource IconToolBarBtnStyle}">
                            <TextBlock Text="🏷️" Style="{StaticResource EmojiIconTextStyle}"/>
                        </Button>
                        <Button Command="{Binding ClearCanvasCommand}" ToolTip="清空画布上所有节点与连线" Style="{StaticResource IconToolBarBtnStyle}" Foreground="#E74C3C">
                            <TextBlock Text="🗑️" Style="{StaticResource EmojiIconTextStyle}"/>
                        </Button>
                        <Button Command="{Binding DeleteNodeCmd}" ToolTip="删除当前选中的节点" Style="{StaticResource IconToolBarBtnStyle}">
                            <TextBlock Text="✂️" Style="{StaticResource EmojiIconTextStyle}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 面包屑导航 + 业务过程绑定提示 -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0 1 0 1" Padding="12 0">
            <DockPanel>
                <!-- 左侧：面包屑 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                    <TextBlock Text="当前流程层级: " Foreground="#888" VerticalAlignment="Center"/>
                    <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding ProcessName}" 
                                            Command="{Binding DataContext.NavigateToProcessCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}" Foreground="#58ACFA" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                    <TextBlock Text=" &gt; " Foreground="#666" Margin="4 0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 右侧：业务过程绑定提示（工位生产模式绑定了业务过程时显示） -->
                <Border DockPanel.Dock="Right" Background="#3A2B14" BorderBrush="#8A6D1F" BorderThickness="1"
                        CornerRadius="3" Padding="8 2" Margin="8 0 0 0" VerticalAlignment="Center"
                        Visibility="{Binding BoundProcessKey, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding ProcessBannerText}" Foreground="#FFD980" FontSize="11" VerticalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：极简分类图标栏 -->
            <Border Grid.Column="0" BorderBrush="#3F3F46" BorderThickness="0 0 1 0" Background="#181818" Panel.ZIndex="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ToolBoxCategories" ItemsSource="{Binding ToolBoxGrouped.Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="GroupCategoryItem" Height="52" Cursor="Hand" Background="Transparent"
                                      PreviewMouseLeftButtonDown="CategoryItem_PreviewMouseLeftButtonDown">
                                    <Border x:Name="IconBorder" Margin="3" CornerRadius="6" Background="#252526">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="13" 
                                                    Background="{Binding Items[0].Category, Converter={StaticResource CategoryMetaConverter}, ConverterParameter=Brush}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Items[0].Category, Converter={StaticResource CategoryMetaConverter}, ConverterParameter=Icon}" 
                                                           FontFamily="Segoe UI Emoji" 
                                                           FontSize="13" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="{Binding Items[0].Category, Converter={StaticResource CategoryMetaConverter}, ConverterParameter=ShortName}" 
                                                       Foreground="#BBB" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="IconBorder" Property="Background" Value="#3E3E42"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 2. 展开的二级节点 Drawer -->
            <Border x:Name="DrawerPanel" Grid.Column="0" Grid.ColumnSpan="2" Width="220" HorizontalAlignment="Left" Margin="48,0,0,0"
                    Background="#252526" BorderBrush="#3F3F46" BorderThickness="0 0 1 0" Visibility="Collapsed" Panel.ZIndex="99">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0 2 0 6">
                        <Button Content="✕" DockPanel.Dock="Right" Background="Transparent" Foreground="#AAA" 
                                BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="CloseDrawer_Click" ToolTip="收起侧边栏"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="5" 
                                    Background="{Binding Text, ElementName=TxtCurrentCategoryTitle, Converter={StaticResource CategoryMetaConverter}, ConverterParameter=Brush}" 
                                    Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtCurrentCategoryTitle" Text="视觉算法" FontWeight="Bold" Foreground="#F1F1F1" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Grid.Row="1" Background="#3F3F46" Margin="0 0 0 6"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DrawerItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,6,8" Cursor="Hand"
                                          PreviewMouseLeftButtonDown="ToolItem_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="ToolItem_PreviewMouseMove">

                                        <Border x:Name="NodeItemBorder" 
                                                Background="#2D2D30" 
                                                BorderBrush="#3F3F46" 
                                                BorderThickness="1" 
                                                CornerRadius="6" 
                                                Padding="6,6,8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" 
                                                        Background="{Binding Category, Converter={StaticResource CategoryMetaConverter}, ConverterParameter=Brush}" 
                                                        CornerRadius="2" 
                                                        Margin="0,2,4,2"/>

                                                <TextBlock Grid.Column="1" 
                                                           Text="⋮⋮" 
                                                           Foreground="#555555" 
                                                           FontSize="11" 
                                                           VerticalAlignment="Center" 
                                                           HorizontalAlignment="Center"/>

                                                <Border Grid.Column="2" Width="24" Height="24" CornerRadius="5" 
                                                        Background="{Binding Category, Converter={StaticResource CategoryMetaConverter}, ConverterParameter=Brush}" 
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,4,0">
                                                    <TextBlock Text="{Binding Icon}" 
                                                               FontFamily="Segoe UI Emoji" 
                                                               FontSize="12" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="2,0,0,0">
                                                    <TextBlock Text="{Binding DisplayName}" 
                                                               Foreground="#F1F1F1" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="12" 
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayName}"/>
                                                    <TextBlock Text="{Binding NodeId}" 
                                                               Foreground="#888888" 
                                                               FontSize="9.5" 
                                                               Margin="0,1,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="4" 
                                                           Text="+" 
                                                           Foreground="{Binding Category, Converter={StaticResource CategoryMetaConverter}, ConverterParameter=Brush}"
                                                           FontSize="15" 
                                                           FontWeight="Bold" 
                                                           VerticalAlignment="Center" 
                                                           HorizontalAlignment="Right" 
                                                           Opacity="0.8"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NodeItemBorder" Property="Background" Value="#38383C"/>
                                            <Setter TargetName="NodeItemBorder" Property="BorderBrush" Value="{Binding Category, Converter={StaticResource CategoryMetaConverter}, ConverterParameter=Brush}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- 中间：画布 -->
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="#3F3F46" Margin="4" ClipToBounds="True">
                <ScrollViewer x:Name="FlowScrollViewer" 
                  HorizontalScrollBarVisibility="Hidden" 
                  VerticalScrollBarVisibility="Hidden" 
                  Focusable="False">

                    <!-- 1. 让 FlowCanvas 响应统一转换 -->
                    <Canvas x:Name="FlowCanvas" 
                Width="5000" Height="5000" 
                Background="#1E1E1E" 
                AllowDrop="True" 
                Drop="Canvas_Drop" 
                DragOver="Canvas_DragOver" 
                MouseMove="FlowCanvas_MouseMove" 
                MouseLeftButtonDown="FlowCanvas_MouseLeftButtonDown" 
                PreviewMouseLeftButtonUp="FlowCanvas_PreviewMouseLeftButtonUp"  
                MouseRightButtonDown="FlowCanvas_MouseRightButtonDown" 
                MouseRightButtonUp="FlowCanvas_MouseRightButtonUp" 
                PreviewMouseWheel="FlowCanvas_PreviewMouseWheel" 
                PreviewMouseRightButtonDown="FlowCanvas_PreviewMouseRightButtonDown">

                        <!-- 2. 缩放与平移的总控容器 (改用 RenderTransform 走 GPU 硬件加速) -->
                        <Grid x:Name="ContentGrid" Width="5000" Height="5000">

                            <!-- 2.1 将网格背景移入 ContentGrid 内部，让网格跟着画布一起原生平滑缩放！ -->
                            <Grid.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#1E1E1E">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,20,20"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                            <GeometryDrawing>
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,20,20"/>
                                                </GeometryDrawing.Geometry>
                                                <GeometryDrawing.Pen>
                                                    <Pen Brush="#252528" Thickness="1"/>
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Grid.Background>

                            <!-- 使用 RenderTransform 替代 LayoutTransform -->
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- 连线模板 -->
                            <ItemsControl ItemsSource="{Binding CurrentProcess.Connections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Stroke="{Binding ConnectionColor, Converter={StaticResource HexToBrushConv}, FallbackValue=#007ACC}" 
                                  StrokeThickness="{Binding Category, Converter={StaticResource ConnectionThicknessConv}}" 
                                  StrokeDashArray="{Binding Category, Converter={StaticResource ConnectionDashConv}}"
                                  Cursor="Hand"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource BezierPathConverter}">
                                                    <Binding Path="StartX"/>
                                                    <Binding Path="StartY"/>
                                                    <Binding Path="EndX"/>
                                                    <Binding Path="EndY"/>
                                                </MultiBinding>
                                            </Path.Data>
                                            <Path.ContextMenu>
                                                <ContextMenu Background="#222" Foreground="#fff">
                                                    <MenuItem Header="❌ 删除连线" 
                                                  Command="{Binding Path=PlacementTarget.Tag.DeleteConnectionCmd, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}" 
                                                  CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Path.ContextMenu>
                                        </Path>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 拖拽连线 -->
                            <Path x:Name="TempPath" 
                      Stroke="Orange" 
                      StrokeThickness="2" 
                      Visibility="Collapsed">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure x:Name="TempFigure">
                                            <BezierSegment x:Name="TempBezier"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>

                            <!-- 节点 -->
                            <ItemsControl ItemsSource="{Binding CurrentProcess.Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:FlowNodeBase}">
                                        <controls:NodeControl Node="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding PosX}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding PosY}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>
                    </Canvas>
                </ScrollViewer>
            </Border>
            <!-- 右侧：Inspector 参数面板 -->
            <Grid Grid.Column="2" Margin="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- 1. 图像展示区 -->
                <!-- RenderContext 必须显式 OneWay：
                     ① 该依赖属性注册为 BindsTwoWayByDefault，而 VM 属性类型是 WpfImageRenderContext
                        （派生类），DP 类型是基类 ImageRenderContext ⇒ 目标→源方向是窄化转换，
                        WPF 建不出默认转换器，会刷 "Data Error: 1 : Cannot create default converter
                        to perform 'two-way' conversions"；
                     ② 显示控件只是图像通道的下游消费者，把它的 DP 值回写进 ImageDisplayVm
                        没有意义，却会把"缩略图选中态被集合变更拉空"这类噪声写回图像通道。 -->
                <halconHost:HalconImageDisplayHost x:Name="MainPreviewHost"
                    DataContext="{Binding ImageDisplayVm}"
                    RenderContext="{Binding ActiveImageContext, Mode=OneWay}" />

                <!-- 2. 缩略图列表 -->
                <Border Grid.Row="1" Background="#181818" BorderBrush="#3F3F46" BorderThickness="0 1 0 0">
                    <ListBox ItemsSource="{Binding ImageDisplayVm.ImageHistoryList}" SelectedItem="{Binding ImageDisplayVm.ActiveImageContext}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}" BorderThickness="2" Margin="2" Width="64" Height="64" Background="#222">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 3. 下区：日志与数据监控Tab页 -->
                <TabControl Grid.Row="2" Margin="2">
                    <TabItem Header="运行日志 (Console)">
                        <ListBox x:Name="LogListBox" ItemsSource="{Binding ExecutionLogs}" 
                                 Background="#111" Foreground="#00FF66" FontFamily="Consolas" FontSize="11" 
                                 BorderThickness="0" SelectionMode="Extended" MouseDoubleClick="LogListBox_MouseDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu Background="#222" Foreground="#fff">
                                    <MenuItem Header="复制选中行" Click="CopySelectedLogRows"/>
                                    <MenuItem Header="复制全部日志" Click="CopyAllLogRows"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="SharedData 变量监控">
                        <DataGrid ItemsSource="{Binding WatchData}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="90"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="预检问题">
                        <DataGrid ItemsSource="{Binding PreflightIssues}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="65"/>
                                <DataGridTextColumn Header="节点" Binding="{Binding NodeName}" Width="120"/>
                                <DataGridTextColumn Header="问题" Binding="{Binding Message}" Width="*"/>
                                <DataGridTemplateColumn Header="操作" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="定位"
                                                    Command="{Binding DataContext.LocatePreflightIssueCmd, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>