<UserControl x:Class="Grayson.Vison.FlowEdit.Views.FlowEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Grayson.Vison.FlowEdit"
             xmlns:vm="clr-namespace:Grayson.Vison.FlowEdit.ViewModels"
             xmlns:models="clr-namespace:Grayson.Vision.Contracts.Business.Models;assembly=Grayson.Vision.Contracts"
             xmlns:controls="clr-namespace:Grayson.Vison.FlowEdit.Controls"
             xmlns:view ="clr-namespace:Grayson.Vison.FlowEdit.Views"
             xmlns:cvts="clr-namespace:Grayson.Vison.FlowEdit.Converters"
             xmlns:halconHost="clr-namespace:Grayson.Vision.HalconWrapper.Wpf.Controls;assembly=Grayson.Vision.HalconWrapper.Wpf">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 转换器定义 -->
            <cvts:BezierPathConverter x:Key="BezierPathConverter"/>
            <cvts:NullToCollapsed x:Key="NullToCollapsed"/>
            <cvts:NullToVisible x:Key="NullToVisible"/>
            <cvts:PortCategoryToCornerRadiusConv x:Key="PortCategoryToCornerRadiusConv"/>
            <cvts:HexToBrushConv x:Key="HexToBrushConv"/>
            <cvts:ConnectionThicknessConv x:Key="ConnectionThicknessConv"/>
            <cvts:ConnectionDashConv x:Key="ConnectionDashConv"/>
            <cvts:CategoryToIconConverter x:Key="CategoryToIconConverter"/>
            <cvts:CategoryToShortNameConverter x:Key="CategoryToShortNameConverter"/>
            <cvts:CategoryToBrushConverter x:Key="CategoryToBrushConverter"/>


            <!--<ResourceDictionary.MergedDictionaries>

                -->
            <!-- 引入独立拆分出的参数模板文件 -->
            <!--
                <ResourceDictionary Source="pack://application:,,,/Grayson.Vison.FlowEdit;component/Themes/NodeParamTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>-->


        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:FlowVm />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部控制栏 -->
        <Border Background="#2D2D30" Padding="8 0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="工业视觉流程编排器 (全量23节点)" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0 0 15 0"/>
                    <Button Content="💾 保存" Command="{Binding SaveRecipeCmd}" Background="#3E3E42" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>

                    <Button Content="📥 导入 JSON" Command="{Binding ImportRecipeCmd}" Background="#3E3E42" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Button Content="📤 导出 JSON" Command="{Binding ExportRecipeCmd}" Background="#3E3E42" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Separator Width="1" Background="#555" Margin="6 6"/>
                    <Button Content="🗑️ 清空画布" 
                        Command="{Binding ClearCanvasCommand}"
                        Background="#E74C3C" Foreground="White" 
                        Padding="8,4" Margin="0 0 4 0"
                        ToolTip="清空当前画布中的所有节点和连线"/>

                    <Button Content="✨ 自动重排" Command="{Binding AutoLayoutCmd}" Background="#2980B9" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Button Content="❌ 删除节点" Command="{Binding DeleteNodeCmd}" Background="#A93226" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <!-- 🌟 新增：保存为复合模板按钮 -->
                    <Button Content="📦 另存为模板" 
                    Command="{Binding SaveCurrentPipelineAsRecipeCommand}"
                    Background="#8E44AD" Foreground="White" Padding="8,4" Margin="0 0 4 0"
                    ToolTip="将当前画布中的子流程导出为 JSON 模板并刷新到左侧工具箱"/>
                    <Button Content="▶ 连续运行" Command="{Binding RunContinuousCmd}" Background="#27AE60" Foreground="White" FontWeight="Bold" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Button Content="⏯ 单步运行" Command="{Binding StepRunCmd}" Background="#2980B9" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Button Content="⏸ 暂停" Command="{Binding PauseRunCmd}" Background="#D35400" Foreground="White" Padding="10 4" Margin="0 0 4 0" BorderThickness="0"/>
                    <Button Content="⏹ 停止" Command="{Binding StopRunCmd}" Background="#C0392B" Foreground="White" Padding="10 4" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 面包屑导航 -->
        <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0 1 0 1" Padding="12 0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="当前流程层级: " Foreground="#888" VerticalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding ProcessName}" 
                                        Command="{Binding DataContext.NavigateToProcessCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" Foreground="#58ACFA" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                                <TextBlock Text=" &gt; " Foreground="#666" Margin="4 0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- 第一列：固定 48px -->
                <ColumnDefinition Width="48"/>

                <!-- 第二列：占剩余宽度的 1 份 (即 50%) -->
                <ColumnDefinition Width="1*"/>

                <!-- 第三列：占剩余宽度的 1 份 (即 50%) -->
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：极简分类图标栏 -->
            <Border Grid.Column="0" BorderBrush="#3F3F46" BorderThickness="0 0 1 0" Background="#181818" Panel.ZIndex="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ToolBoxCategories" ItemsSource="{Binding ToolBoxGrouped.Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="GroupCategoryItem" Height="52" Cursor="Hand" Background="Transparent"
                          PreviewMouseLeftButtonDown="CategoryItem_PreviewMouseLeftButtonDown">
                                    <Border x:Name="IconBorder" Margin="3" CornerRadius="6" Background="#252526">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- 分类专属主题色微型圆角徽章包裹 -->
                                            <Border Width="26" Height="26" CornerRadius="13" 
                                        Background="{Binding Name, Converter={StaticResource CategoryToBrushConverter}}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Name, Converter={cvts:CategoryToIconConverter}}" 
                                               FontFamily="Segoe UI Emoji" 
                                               FontSize="13" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <TextBlock Text="{Binding Name, Converter={cvts:CategoryToShortNameConverter}}" 
                                           Foreground="#BBB" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="IconBorder" Property="Background" Value="#3E3E42"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 2. 展开的二级节点 Drawer -->
            <Border x:Name="DrawerPanel" Grid.Column="0" Grid.ColumnSpan="2" Width="220" HorizontalAlignment="Left" Margin="48,0,0,0"
        Background="#252526" BorderBrush="#3F3F46" BorderThickness="0 0 1 0" Visibility="Collapsed" Panel.ZIndex="99">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 抽屉头部：当前分类名称 + 关闭按钮 -->
                    <DockPanel Grid.Row="0" Margin="0 2 0 6">
                        <Button Content="✕" DockPanel.Dock="Right" Background="Transparent" Foreground="#AAA" 
                    BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="CloseDrawer_Click" ToolTip="收起侧边栏"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="5" 
                        Background="{Binding Text, ElementName=TxtCurrentCategoryTitle, Converter={StaticResource CategoryToBrushConverter}}" 
                        Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtCurrentCategoryTitle" Text="视觉算法" FontWeight="Bold" Foreground="#F1F1F1" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <Separator Grid.Row="1" Background="#3F3F46" Margin="0 0 0 6"/>

                    <!-- 节点列表 (美化版：自带Icon背景色彩化、与画布节点颜色完美对应) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DrawerItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,6,8" Cursor="Hand"
                      PreviewMouseLeftButtonDown="ToolItem_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="ToolItem_PreviewMouseMove">

                                        <Border x:Name="NodeItemBorder" 
                            Background="#2D2D30" 
                            BorderBrush="#3F3F46" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="6,6,8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- 1. 左侧分类高亮条 -->
                                                    <ColumnDefinition Width="4"/>
                                                    <!-- 2. 拖拽手柄 -->
                                                    <ColumnDefinition Width="14"/>
                                                    <!-- 3. 节点自带Icon (带彩色徽章背景) -->
                                                    <ColumnDefinition Width="28"/>
                                                    <!-- 4. 文本内容区 -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- 5. 右侧加号提示 -->
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 1. 左侧对应画布颜色的高亮指示条 -->
                                                <Border Grid.Column="0" 
                                    Background="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" 
                                    CornerRadius="2" 
                                    Margin="0,2,4,2"/>

                                                <!-- 2. 拖拽手柄图标 -->
                                                <TextBlock Grid.Column="1" 
                                       Text="⋮⋮" 
                                       Foreground="#555555" 
                                       FontSize="11" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"/>

                                                <!-- 3. 节点自带图标 (使用分类对应的专属主题色作为背景徽章) -->
                                                <Border Grid.Column="2" Width="24" Height="24" CornerRadius="5" 
                                    Background="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" 
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,4,0">
                                                    <TextBlock Text="{Binding Icon}" 
                                           FontFamily="Segoe UI Emoji" 
                                           FontSize="12" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- 4. 节点主标题与 NodeId 说明 -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="2,0,0,0">
                                                    <TextBlock Text="{Binding DisplayName}" 
                                           Foreground="#F1F1F1" 
                                           FontWeight="SemiBold" 
                                           FontSize="12" 
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DisplayName}"/>
                                                    <TextBlock Text="{Binding NodeId}" 
                                           Foreground="#888888" 
                                           FontSize="9.5" 
                                           Margin="0,1,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <!-- 5. 右侧加号提示符 (匹配主题色) -->
                                                <TextBlock Grid.Column="4" 
                                       Text="+" 
                                       Foreground="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}" 
                                       FontSize="15" 
                                       FontWeight="Bold" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Right" 
                                       Opacity="0.8"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- 悬浮 Hover 交互效果 -->
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NodeItemBorder" Property="Background" Value="#38383C"/>
                                            <Setter TargetName="NodeItemBorder" Property="BorderBrush" Value="{Binding Category, Converter={StaticResource CategoryToBrushConverter}}"/>
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- 中间：画布 -->
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="#3F3F46" Margin="4" ClipToBounds="True">
                <ScrollViewer x:Name="FlowScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <ScrollViewer.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#1E1E1E">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,20,20"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,20,20"/>
                                        </GeometryDrawing.Geometry>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#252528" Thickness="1"/>
                                        </GeometryDrawing.Pen>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </ScrollViewer.Background>

                    <!-- 找到 FlowCanvas 节点，修正 MouseEvents 绑定 -->
                    <Canvas x:Name="FlowCanvas" 
        Width="5000" Height="5000" 
        Background="Transparent" 
        AllowDrop="True" 
        Drop="Canvas_Drop" 
        DragOver="Canvas_DragOver" 
        MouseMove="FlowCanvas_MouseMove" 
        MouseLeftButtonDown="FlowCanvas_MouseLeftButtonDown" 
        PreviewMouseLeftButtonUp="FlowCanvas_PreviewMouseLeftButtonUp"  
        MouseRightButtonDown="FlowCanvas_MouseRightButtonDown" 
        MouseRightButtonUp="FlowCanvas_MouseRightButtonUp" 
        PreviewMouseWheel="FlowCanvas_PreviewMouseWheel" 
        PreviewMouseRightButtonDown="FlowCanvas_PreviewMouseRightButtonDown">
                        <Grid x:Name="ContentGrid">
                            <Grid.LayoutTransform>
                                <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                            </Grid.LayoutTransform>

                            <!-- 连线模板 -->
                            <ItemsControl ItemsSource="{Binding CurrentProcess.Connections}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 绑定正确的 ConnectionCategory 属性 -->
                                        <Path Stroke="{Binding ConnectionColor, Converter={StaticResource HexToBrushConv}, FallbackValue=#007ACC}" 
                  StrokeThickness="{Binding Category, Converter={StaticResource ConnectionThicknessConv}}" 
                  StrokeDashArray="{Binding Category, Converter={StaticResource ConnectionDashConv}}"
                  Cursor="Hand"
             
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <Path.Data>
                                                <MultiBinding Converter="{StaticResource BezierPathConverter}">
                                                    <Binding Path="StartX"/>
                                                    <Binding Path="StartY"/>
                                                    <Binding Path="EndX"/>
                                                    <Binding Path="EndY"/>
                                                </MultiBinding>
                                            </Path.Data>
                                            <Path.ContextMenu>
                                                <ContextMenu Background="#222" Foreground="#fff">
                                                    <MenuItem Header="❌ 删除连线" 
                                  Command="{Binding Path=PlacementTarget.Tag.DeleteConnectionCmd, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ContextMenu}}" 
                                  CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Path.ContextMenu>
                                        </Path>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 拖拽连线 -->
                            <Path x:Name="TempPath" 
      Stroke="Orange" 
      StrokeThickness="2" 
      Visibility="Collapsed">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure x:Name="TempFigure">
                                            <BezierSegment x:Name="TempBezier"/>
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>

                            <!-- 节点 -->
                            <ItemsControl ItemsSource="{Binding CurrentProcess.Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:FlowNodeBase}">
                                        <controls:NodeControl Node="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding PosX}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding PosY}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Grid>
                    </Canvas>
                </ScrollViewer>
            </Border>

            <!-- 右侧：Inspector 参数面板 -->
            <!-- 右侧综合面板 -->
            <Grid Grid.Column="2" Margin="2">
                <Grid.RowDefinitions>
                    <!-- 上区：图像区域 (大图) -->
                    <RowDefinition Height="*"/>
                    <!-- 缩略图列表 -->
                    <RowDefinition Height="80"/>
                    <!-- 下区：数据监视与日志 -->
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <!-- 1. 图像展示区 -->
                <halconHost:HalconImageDisplayHost DataContext="{Binding ImageDisplayVm}"/>

                <!-- 2. 缩略图列表 -->
                <Border Grid.Row="1" Background="#181818" BorderBrush="#3F3F46" BorderThickness="0 1 0 0">
                    <ListBox ItemsSource="{Binding ImageDisplayVm.ImageHistoryList}" SelectedItem="{Binding ImageDisplayVm.ActiveImageContext}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter}}" BorderThickness="2" Margin="2" Width="64" Height="64" Background="#222">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- 3. 下区：日志与数据监控Tab页 -->
                <TabControl Grid.Row="2" Background="#252526" BorderBrush="#3F3F46" Margin="2">
                    <TabItem Header="运行日志 (Console)" Foreground="#AAA">
                        <ListBox x:Name="LogListBox" ItemsSource="{Binding ExecutionLogs}" 
                     Background="#111" Foreground="#00FF66" FontFamily="Consolas" FontSize="11" 
                     BorderThickness="0" SelectionMode="Extended">
                            <ListBox.ContextMenu>
                                <ContextMenu Background="#222" Foreground="#fff">
                                    <MenuItem Header="复制选中行" Click="CopySelectedLogRows"/>
                                    <MenuItem Header="复制全部日志" Click="CopyAllLogRows"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="SharedData 变量监控" Foreground="#AAA">
                        <DataGrid ItemsSource="{Binding WatchData}" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="#252526" RowBackground="#2D2D30" Foreground="White" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="90"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>


        </Grid>
    </Grid>
</UserControl>