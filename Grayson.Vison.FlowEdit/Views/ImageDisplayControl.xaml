<UserControl x:Class="Grayson.Vison.FlowEdit.Views.ImageDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cvts="clr-namespace:Grayson.Vison.FlowEdit.Converters"
             xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet">
    <UserControl.Resources>
        <ResourceDictionary>
            <cvts:BoolToBrushConverter x:Key="BoolToBrushConverter" SelectedBrush="#007ACC" NormalBrush="#555"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <GroupBox Header="🖼️ 图像实时监控" Foreground="#AAA" BorderBrush="#3F3F46" Margin="2">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 顶部控制栏 (自动切换/方向切换) -->
                <RowDefinition Height="32"/>
                <!-- 主大图显示区 -->
                <RowDefinition Height="*"/>
                <!-- 底部缩略图列表 -->
                <RowDefinition Height="75"/>
            </Grid.RowDefinitions>

            <!-- 1. 顶部控制工具栏 -->
            <DockPanel Grid.Row="0" Background="#202020" >
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- 自动切换开关 -->
                    <ToggleButton Content="🔄 自动跟焦" 
                                  IsChecked="{Binding IsAutoSwitchEnabled, Mode=TwoWay}"
                                  ToolTip="开启后，节点执行完成将自动切到该节点的输出大图" 
                                  Padding="8,2" Margin="0 0 10 0" Background="#333" Foreground="White"/>

                    <TextBlock Text="{Binding SelectedImageInfo}" Foreground="#888" VerticalAlignment="Center" FontSize="11"/>
                </StackPanel>

                <!-- 适合窗口放大一键定位 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="适应窗口" Click="BtnFitImage_Click" Padding="6,2" Margin="2,0" Background="#3E3E42" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </DockPanel>

            <!-- 2. 主大图显示区 (Halcon HSmartWindowControlWPF + 左右手动切换覆盖层) -->
            <Grid Grid.Row="1" Background="#000">
                <!-- Halcon 智能窗口 -->
                <halcon:HSmartWindowControlWPF x:Name="SmartWindow" 
                               HInitWindow="SmartWindow_HInitWindow"
                              />

                <!-- 浮动左切换图标 -->
                <Button Command="{Binding PreviousImageCmd}" 
                        HorizontalAlignment="Left" VerticalAlignment="Center" 
                        Width="40" Height="60" Opacity="0.6" Background="#80000000" Foreground="White" 
                        FontSize="22" FontWeight="Bold" Content="❮" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- 浮动右切换图标 -->
                <Button Command="{Binding NextImageCmd}" 
                        HorizontalAlignment="Right" VerticalAlignment="Center" 
                        Width="40" Height="60" Opacity="0.6" Background="#80000000" Foreground="White" 
                        FontSize="22" FontWeight="Bold" Content="❯" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- 3. 底部缩略图列表 -->
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0 4 0 0">
                <ItemsControl ItemsSource="{Binding ImageHistoryList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="65" Height="65" Margin="3" 
                                    BorderBrush="{Binding IsSelected, Converter={cvts:BoolToBrushConverter SelectedBrush=#007ACC, NormalBrush=#555}}" 
                                    BorderThickness="2" CornerRadius="4" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
                                                  Command="{Binding DataContext.SelectImageItemCmd, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                    <Border Background="#A0000000" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding NodeName}" Foreground="White" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </GroupBox>
</UserControl>