<Window x:Class="Grayson.Vison.FlowEdit.Views.NodePropertyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cvts="clr-namespace:Grayson.Vison.FlowEdit.Converters"
        Title="{Binding DisplayName, StringFormat='⚙️ 节点属性设置 - {0}'}" 
        Height="650" Width="480" 
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White">

    <Window.Resources>
        <ResourceDictionary>
            <cvts:PortCategoryToCornerRadiusConv x:Key="PortCategoryToCornerRadiusConv"/>
            <cvts:HexToBrushConv x:Key="HexToBrushConv"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
            <StackPanel Margin="0,0,8,0">
                <!-- 1. 基础信息卡片 -->
                <UniformGrid Columns="2" Margin="0 0 0 6">
                    <CheckBox Content="启用节点 (Enable)" IsChecked="{Binding Enable}" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Type, StringFormat='类型: {0}'}" Foreground="#888" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </UniformGrid>

                <TextBlock Text="DisplayName (节点名称):" Foreground="#AAA" FontSize="10" Margin="0 4 0 0"/>
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Background="#252526" Foreground="White" BorderBrush="#555" Margin="0 2 0 6" Padding="4"/>

                <!-- 2. 中文指南卡片 -->
                <Border Background="#252526" CornerRadius="4" Padding="8" Margin="0 4 0 6" BorderBrush="#333" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💡 节点说明:" Foreground="#E67E22" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="{Binding Description}" Foreground="#DDD" FontSize="11" TextWrapping="Wrap" Margin="0 2 0 4"/>

                        <TextBlock Text="📖 使用指南:" Foreground="#3498DB" FontWeight="Bold" FontSize="11"/>
                        <TextBlock Text="{Binding UsageGuide}" Foreground="#AAA" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 3. 动态参数配置区 (节点的 XAML 参数模板会自动渲染在这里) -->
                <GroupBox Header="⚙️ 业务参数配置" Foreground="#007ACC" BorderBrush="#3F3F46" Margin="0 6">
                    <ContentControl Content="{Binding ParameterModel}" Margin="6"/>
                </GroupBox>

                <!-- 4. 端口数据实时调试监控 -->
                <Expander Header="🔌 端口数据监控与调试" IsExpanded="True" Foreground="#AAA" Margin="0 4 0 0">
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Text="📥 输入端 (Inputs):" Foreground="#AAA" FontSize="10" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding InputPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0 2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="7" Height="7" 
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrushConv}}" 
                                                CornerRadius="{Binding Category, Converter={StaticResource PortCategoryToCornerRadiusConv}}" 
                                                VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4 0 0 0">
                                            <TextBlock Text="{Binding PortName}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DataType, StringFormat=' ({0})'}" Foreground="#777" FontSize="9" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding DataValue, StringFormat='[{0}]'}" 
                                                   Foreground="#2ECC71" FontSize="10" 
                                                   HorizontalAlignment="Right" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding DataValue}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Background="#333" Margin="0 4"/>

                        <TextBlock Text="📤 输出端 (Outputs):" Foreground="#AAA" FontSize="10" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding OutputPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0 2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="7" Height="7" 
                                                Background="{Binding ColorHex, Converter={StaticResource HexToBrushConv}}" 
                                                CornerRadius="{Binding Category, Converter={StaticResource PortCategoryToCornerRadiusConv}}" 
                                                VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4 0 0 0">
                                            <TextBlock Text="{Binding PortName}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding DataType, StringFormat=' ({0})'}" Foreground="#777" FontSize="9" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding DataValue, StringFormat='[{0}]'}" 
                                                   Foreground="#E67E22" FontSize="10" 
                                                   HorizontalAlignment="Right" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   ToolTip="{Binding DataValue}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部确定按钮 -->
        <Button Grid.Row="1" Content="确定" Width="80" Height="28" HorizontalAlignment="Right" Margin="0 10 0 0"
                Background="#007ACC" Foreground="White" BorderThickness="0" Click="BtnOk_Click"/>
    </Grid>
</Window>