<Window x:Class="Grayson.Vison.FlowEdit.Views.NodePropertyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cvts="clr-namespace:Grayson.Vison.FlowEdit.Converters"
        xmlns:halconHost="clr-namespace:Grayson.Vision.HalconWrapper.Wpf.Controls;assembly=Grayson.Vision.HalconWrapper.Wpf"
        Title="{Binding DisplayName, StringFormat='⚙️ 节点属性设置 - {0}'}"
        Height="640" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#181818" Foreground="White">

    <Window.Resources>
        <ResourceDictionary>
            <cvts:PortCategoryToCornerRadiusConv x:Key="PortCategoryToCornerRadiusConv"/>
            <cvts:HexToBrushConv x:Key="HexToBrushConv"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <!-- 1. 节点基础属性 Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. 核心内容区 (动态参数模板/TabControl) -->
            <RowDefinition Height="*"/>
            <!-- 3. 端口数据实时调试 (可折叠) -->
            <RowDefinition Height="Auto"/>
            <!-- 4. 底部控制栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 基础信息卡片 -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="4" Padding="10" Margin="0 0 0 10">
            <StackPanel>
                <Grid Margin="0 0 0 6">
                    <CheckBox Content="启用节点 (Enable)" IsChecked="{Binding Enable}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Type, StringFormat='类型: {0}'}" Foreground="#00A896" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="节点名称: " Foreground="#AAA" FontSize="11" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Background="#1E1E1E" Foreground="White" BorderBrush="#3F3F46" Padding="4 2"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 2. 核心内容区：左参数 / 右实时预览（仅 SupportsPreview 节点展开右列，其余维持单列零变化） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- 2.1 动态参数配置区 (Grayson.Vision.Nodes 中开发的 XAML 模板自动渲染到这里) -->
            <!-- 复杂的节点会在自己的 ParamView 内内置 TabControl；简单节点则是纯表单 -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="4" Padding="8" BorderBrush="#3F3F46" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding ParameterModel}"/>
                </ScrollViewer>
            </Border>

            <!-- 2.2 实时预览区：编辑参数时实时看到图像变化（场景式绘制，节点 Executor 走一步画一步） -->
            <Border Grid.Column="1" Background="#111111" CornerRadius="4" Padding="6" BorderBrush="#3F3F46" BorderThickness="1" Margin="8 0 0 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4 2 4 6">
                        <TextBlock Text="🖼 实时预览" Foreground="#00A896" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <CheckBox Content="参数变化自动刷新" DockPanel.Dock="Right"
                                  IsChecked="{Binding ParentFlowVm.IsLivePreview, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Foreground="#AAA" FontSize="11" VerticalAlignment="Center"
                                  ToolTip="参数变化后自动防抖 300ms 重跑该节点；关闭后仅手动点击「运行该节点」刷新"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <halconHost:HalconImageDisplayHost x:Name="PreviewHost"/>
                        <TextBlock x:Name="PreviewHint" Text="运行该节点后显示预览"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#666" FontSize="13" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. 端口数据实时调试监控 (默认折叠，需要调试时展开) -->
        <Expander Grid.Row="2" Header="🔌 端口数据实时调试" IsExpanded="False" Foreground="#AAA" Margin="0 8 0 0">
            <Border Background="#252526" Padding="8" CornerRadius="4" Margin="0 4 0 0">
                <StackPanel>
                    <TextBlock Text="📥 输入端口 (Inputs):" Foreground="#AAA" FontSize="10" FontWeight="Bold"/>
                    <ItemsControl ItemsSource="{Binding InputPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0 2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="7" Height="7" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConv}}" CornerRadius="{Binding Category, Converter={StaticResource PortCategoryToCornerRadiusConv}}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4 0 0 0">
                                        <TextBlock Text="{Binding PortName}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DataType, StringFormat=' ({0})'}" Foreground="#777" FontSize="9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DataValue, StringFormat='[{0}]'}" Foreground="#02C39A" FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataValue}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="#3F3F46" Margin="0 6"/>

                    <TextBlock Text="📤 输出端口 (Outputs):" Foreground="#AAA" FontSize="10" FontWeight="Bold"/>
                    <ItemsControl ItemsSource="{Binding OutputPorts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0 2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="7" Height="7" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConv}}" CornerRadius="{Binding Category, Converter={StaticResource PortCategoryToCornerRadiusConv}}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4 0 0 0">
                                        <TextBlock Text="{Binding PortName}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DataType, StringFormat=' ({0})'}" Foreground="#777" FontSize="9" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DataValue, StringFormat='[{0}]'}" Foreground="#D97706" FontSize="10" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataValue}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Expander>

        <!-- 4. 底部按钮栏 -->
        <DockPanel Grid.Row="3" Margin="0 10 0 0">
            <Button Content="▶ 运行该节点" Command="{Binding ParentFlowVm.StepRunNodeCmd, RelativeSource={RelativeSource AncestorType=Window}}"  Background="#02C39A" Foreground="White" Padding="10 4" BorderThickness="0" DockPanel.Dock="Left" ToolTip="执行当前节点并刷新主界面右侧图像"/>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <Button Content="确定" Width="75" Height="28" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0 0 8 0" Click="BtnOk_Click"/>
                <Button Content="取消" Width="75" Height="28" Background="#3F4246" Foreground="White" BorderThickness="0" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>