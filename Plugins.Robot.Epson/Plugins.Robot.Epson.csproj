<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>770e0ea4-ff78-4305-9bf6-72e41acac08f</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Plugins.Robot.Epson</RootNamespace>
    <AssemblyName>Plugins.Robot.Epson</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!--
    ============================================================
    Epson RC+ SPEL .NET SDK 条件编译（按 DLLLib 下的 SDK DLL 探测）：
    - DLLLib\spelnet64.dll（RC+ 8.0）→ EPSON_SPEL   → SpeLNetAdapter.cs
    - DLLLib\RCAPINet.dll （RC+ 7.x）→ EPSON_SPEL7   → RCAPINet7Adapter.cs
      ★ 当前调试形态：本机 D:\EpsonRC70（RC+ 7.5.1 模拟器），
        已复制 exe\RCAPINet.dll 到 DLLLib，自动启用 RC+ 7 真实适配层；
    - 两者皆无 → 离线仿真机械手（工程随时可编译，业务流先行联调）。
    两个 DLL 互斥：先探测 RC+ 8，再探测 RC+ 7。
    ============================================================
  -->
  <PropertyGroup>
    <EpsonSdkDllPath>$(MSBuildThisFileDirectory)..\DLLLib\spelnet64.dll</EpsonSdkDllPath>
    <EpsonSdk7DllPath>$(MSBuildThisFileDirectory)..\DLLLib\RCAPINet.dll</EpsonSdk7DllPath>
    <DefineConstants Condition="Exists('$(EpsonSdkDllPath)')">$(DefineConstants);EPSON_SPEL</DefineConstants>
    <DefineConstants Condition="!Exists('$(EpsonSdkDllPath)') AND Exists('$(EpsonSdk7DllPath)')">$(DefineConstants);EPSON_SPEL7</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="spelnet64" Condition="Exists('$(EpsonSdkDllPath)')">
      <HintPath>$(EpsonSdkDllPath)</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="RCAPINet" Condition="!Exists('$(EpsonSdkDllPath)') AND Exists('$(EpsonSdk7DllPath)')">
      <HintPath>$(EpsonSdk7DllPath)</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="EpsonPlugin.cs" />
    <Compile Include="EpsonRobot.cs" />
    <Compile Include="EpsonSdkAdapters.cs" />
    <Compile Include="SpeLNetAdapter.cs" />
    <Compile Include="RCAPINet7Adapter.cs" />
    <Compile Include="EpsonTcpScriptAdapter.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Grayson.Vision.Contracts\Grayson.Vision.Contracts.csproj">
      <Project>{b0a7e029-998c-44a3-96f5-3f04214eee32}</Project>
      <Name>Grayson.Vision.Contracts</Name>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
