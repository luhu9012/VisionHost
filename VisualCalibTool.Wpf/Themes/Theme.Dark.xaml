<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      自带一套中性深色主题。★ 刻意<b>不跟随主项目</b>：
      本工具要能独立搬运、独立打包，主题跟着主项目走就等于又多一根耦合线。
      需要浅色时把这一份换成同名的另一份即可（资源键不变）。
    -->

    <Color x:Key="VctBackgroundColor">#FF1B1B1B</Color>
    <Color x:Key="VctPanelColor">#FF232323</Color>
    <Color x:Key="VctPanelAltColor">#FF2A2A2A</Color>
    <Color x:Key="VctBorderColor">#FF3A3A3A</Color>
    <Color x:Key="VctTextColor">#FFE8E8E8</Color>
    <Color x:Key="VctSubTextColor">#FF9C9C9C</Color>
    <Color x:Key="VctAccentColor">#FF3FA7FF</Color>
    <Color x:Key="VctOkColor">#FF4FC46A</Color>
    <Color x:Key="VctWarnColor">#FFE0A030</Color>
    <Color x:Key="VctErrorColor">#FFE05A5A</Color>

    <SolidColorBrush x:Key="VctBackgroundBrush" Color="{StaticResource VctBackgroundColor}" />
    <SolidColorBrush x:Key="VctPanelBrush" Color="{StaticResource VctPanelColor}" />
    <SolidColorBrush x:Key="VctPanelAltBrush" Color="{StaticResource VctPanelAltColor}" />
    <SolidColorBrush x:Key="VctBorderBrush" Color="{StaticResource VctBorderColor}" />
    <SolidColorBrush x:Key="VctTextBrush" Color="{StaticResource VctTextColor}" />
    <SolidColorBrush x:Key="VctSubTextBrush" Color="{StaticResource VctSubTextColor}" />
    <SolidColorBrush x:Key="VctAccentBrush" Color="{StaticResource VctAccentColor}" />
    <!-- ★ 语义三色也必须各有一个 Brush：Foreground/Background 这类属性要的是 Brush，
         而 {StaticResource} 不做 Color→Brush 的隐式转换。
         之前只配了上面 7 个 Brush、漏了这三个，于是有人直接拿 *Color 去喂 Foreground ——
         编译期、XAML 静态检查全绿，直到窗口第一次 measure 才抛
         「"#FFE0A030"不是属性"Foreground"的有效值」。
         规则：★颜色一律成对声明（*Color + *Brush），XAML 只用 *Brush。 -->
    <SolidColorBrush x:Key="VctOkBrush" Color="{StaticResource VctOkColor}" />
    <SolidColorBrush x:Key="VctWarnBrush" Color="{StaticResource VctWarnColor}" />
    <SolidColorBrush x:Key="VctErrorBrush" Color="{StaticResource VctErrorColor}" />

    <!--
      ★ 柔和强调底色（导轨当前项、选中卡片那一档的底）：中等深蓝，比主操作按钮的
        实心蓝弱两档 —— 它表达"系统现在认定的是这个"，不是"该点这个"。
      ★ 颜色成对声明（*Color + *Brush）：{StaticResource} 不做 Color→Brush 隐式转换，
        只配一个就会在首次 measure 时才炸（见上方语义三色的注释）。
    -->
    <Color x:Key="VctAccentSoftColor">#FF1F2E3D</Color>
    <SolidColorBrush x:Key="VctAccentSoftBrush" Color="{StaticResource VctAccentSoftColor}" />

    <Style x:Key="VctTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource VctTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="VctCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource VctTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource VctSubTextBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="VctHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource VctTextStyle}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,6,0,4" />
    </Style>

    <Style x:Key="VctButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource VctTextBrush}" />
        <Setter Property="Background" Value="{StaticResource VctPanelAltBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VctBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            CornerRadius="3"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF343434" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource VctAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VctListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource VctPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VctTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VctBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="VctCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource VctPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource VctBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- ── 语义文字（成功 / 告警 / 强调）──────────────────────────── -->

    <Style x:Key="VctAccentTextStyle" TargetType="TextBlock" BasedOn="{StaticResource VctTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource VctAccentBrush}" />
    </Style>

    <Style x:Key="VctOkTextStyle" TargetType="TextBlock" BasedOn="{StaticResource VctTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource VctOkBrush}" />
    </Style>

    <Style x:Key="VctWarnTextStyle" TargetType="TextBlock" BasedOn="{StaticResource VctTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource VctWarnBrush}" />
    </Style>

    <Style x:Key="VctErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource VctTextStyle}">
        <Setter Property="Foreground" Value="{StaticResource VctErrorBrush}" />
    </Style>

    <Style x:Key="VctMonoTextStyle" TargetType="TextBlock" BasedOn="{StaticResource VctTextStyle}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ── 主按钮（"开始标定"这类一次只能点一个的动作）────────────── -->

    <Style x:Key="VctPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource VctButtonStyle}">
        <Setter Property="Background" Value="{StaticResource VctAccentBrush}" />
        <Setter Property="Foreground" Value="#FF101010" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,6" />
    </Style>

    <!--
      ── 次要按钮（排障 / 实验用：算法自检、镜像注入、三链闭环这类"多数时候不点"）──
      ★ 为什么单独一个样式：这些按钮与主流程无关，却和主按钮同尺寸同亮度地排在顶栏，
        是"焦点被分掉"的来源之一。弱化（透明底 + 小一号字 + 灰字）之后，
        顶栏的第一视觉重量回到「初始化仿真环境」这一个真正该点的按钮上。
      ★ 基于普通按钮模板，悬停行为照旧 —— 弱化的是"平时"，不是"能用"。
    -->
    <Style x:Key="VctGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource VctButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource VctSubTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- ── 选择列表（第 1 步的目标 / 第 2.5 步的特征）────────────────
         ★ 不用 RadioButton：选项上要挂"为什么不可选"的长文案，
           单选圆圈撑不住；卡片式列表既能显示副标题也能置灰。 -->

    <Style x:Key="VctChoiceItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />

        <!--
          ★★ 把数据项上的"能不能选"接到容器上 —— 这一条以前是**缺的**：
            选项卡片的数据项带着 IsEnabled / DisabledReason（视图模型算好了"现在还不能跑"），
            但 XAML 里从来没绑过 IsEnabled，于是所有选项**永远是亮的**，
            点了才会在下一层被拒（"界面说能跑、一点就报错"，正好是这个项目最想避免的那种）。
            ★ 现在把它绑在这里（而不是每个列表各写一遍）：本样式只服务于
              VctChoiceListStyle 的两个"选项卡片列表"，语义就是"每项是一个可选目标"。
              若将来有列表用它却不是这个语义，新加的绑定错误断言会立刻把它揪出来。
        -->
        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />

        <!-- ★ 深色主题下必须显式给前景色：TextBlock.Foreground 是**继承**属性，
             没人设就落到系统默认的黑色 ⇒ 黑字画在 #2A2A2A 的卡片上 = 看不见。
             （VctListBoxStyle 一直是设了的，这个选择列表漏了。） -->
        <Setter Property="Foreground" Value="{StaticResource VctTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{StaticResource VctPanelAltBrush}"
                            BorderBrush="{StaticResource VctBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource VctAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF1F2E3D" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource VctAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="VctChoiceListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />

        <!-- ★ 同 VctListBoxStyle：深色主题里前景色不能靠默认值（默认是黑）。
             这条与 VctChoiceItemStyle 上那条重复是有意的：两张列表、两层兜底，
             少任何一层都可能出现"卡片在、字看不见"。 -->
        <Setter Property="Foreground" Value="{StaticResource VctTextBrush}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource VctChoiceItemStyle}" />
    </Style>

    <!-- ── 进度条 ───────────────────────────────────────────────── -->

    <Style x:Key="VctProgressStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Background" Value="{StaticResource VctPanelAltBrush}" />
        <Setter Property="Foreground" Value="{StaticResource VctAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <Grid>
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 分页（右栏"向导 / 诊断"）───────────────────────────────
         ★ 用 TabControl 而不是自建切换：自建就要自己管选中态与内容裁剪，
           而这里只需要一个"两页互斥显示"的容器。 -->

    <Style x:Key="VctTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource VctSubTextBrush}" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="14,7">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource VctAccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource VctTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource VctTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
